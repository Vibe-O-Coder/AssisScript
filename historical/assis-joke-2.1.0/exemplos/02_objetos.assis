// Contador com construtor, estado e método de instância.
ASSIS AssisAssis {
    Assis Assis_assis: AssIs;

    assis assis_fodase(FodaseAssis: AssIs): FODase {
        aSSIS.Assis_assis = FodaseAssis;
    }

    assis Assis_Fodase(): AssIs {
        aSSIS.Assis_assis += 1;
        Fodase aSSIS.Assis_assis;
    }
}

assis assis_assis(): AssIs {
    Assis AssisFodase: AssisAssis = fodase AssisAssis(40);
    FODASE("Primeiro:", AssisFodase.Assis_Fodase());
    FODASE("Segundo:", AssisFodase.Assis_Fodase());
    foDASE(AssisFodase);
    Fodase 0;
}
