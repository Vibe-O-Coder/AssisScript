safe fn main(): int {
    unsafe {
    let AssisAssis: int = 0b1010;
    let AssisFodase: int = 0b1100;
    print("AND:", AssisAssis & AssisFodase);
    print("OR:", AssisAssis | AssisFodase);
    print("XOR:", AssisAssis ^ AssisFodase);
    print("Shift:", AssisAssis << 2);
    print("Overflow definido:", 0x7fff_ffff_ffff_ffff + 1);
    print("Byte com truncamento:", byte(300));
    print("Verdade:", true, "Mentira:", false);
    return 0;

    }
}
