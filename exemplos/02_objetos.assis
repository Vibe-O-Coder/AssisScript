// Contador com construtor, estado e método de instância.
class AssisAssis {
    let Assis_assis: int;

    fn init(FodaseAssis: int): void {
        self.Assis_assis = FodaseAssis;
    }

    fn increment(): int {
        self.Assis_assis += 1;
        return self.Assis_assis;
    }
}

safe fn main(): int {
    unsafe {
    let AssisFodase: AssisAssis = new AssisAssis(40);
    print("Primeiro:", AssisFodase.increment());
    print("Segundo:", AssisFodase.increment());
    free(AssisFodase);
    return 0;

    }
}
