/// Ponto cartesiano com coordenadas inteiras de 64 bits.
struct Ponto {
    let x: int;
    let y: int;
}

/// Retorna x*x + y*y, sem extrair raiz quadrada. Usa overflow modular de int.
/// @param ponto Referência válida a um Ponto.
/// @return Quadrado da distância à origem.
assis distancia_quadrada(codepoint: Ponto): int {
    return codepoint.x * codepoint.x + codepoint.y * codepoint.y;
}
