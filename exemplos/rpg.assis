// ============================================================================
//  CRÔNICAS DO ASSIS — um RPG de turnos escrito em AssisScript 3.3.0-alpha.6
//
//  Recursos usados:
//    • OOP: herança em 3 níveis, métodos virtuais (polimorfismo), campos private
//    • Estatísticas: HP, MP, FOR, DEF, MAG, VEL, nível e XP, com evolução por classe
//    • Inimigos: cada um com sua própria IA (método virtual `agir`)
//    • Itens: Poção, Elixir, Antídoto e Bomba, num inventário compartilhado
//    • Habilidades: físicas, mágicas, cura, veneno e drenar vida
//    • Turnos: a ordem de cada rodada é decidida pela velocidade (VEL)
//
//  Como jogar:   assis run rpg.assis
//  Assistir:     assis run rpg.assis < /dev/null     (sem entrada = modo automático)
//  Vazamentos:   assis run rpg.assis --debug         (verifica a memória ao sair)
// ============================================================================

import "std/strings.assis";
import "std/convert.assis";

// ----------------------------------------------------------------------------
//  UTILIDADES DE TEXTO
// ----------------------------------------------------------------------------

/// Conta caracteres visíveis (ignora bytes de continuação do UTF-8).
fn compr(s: text): int {
    let n: int = 0;
    for (let i: int = 0; i < len(s); i += 1) {
        let b: int = s[i];
        if ((b & 192) != 128) { n += 1; }
    }
    return n;
}

fn adicionarNumero(t: String, v: int): void {
    let n: String = int_to_string(v);
    t.append(n.view());
    n.dispose();
    free(n);
}

fn adicionarEspacos(t: String, count: int): void {
    for (let i: int = 0; i < count; i += 1) { t.append_byte(byte(32)); }
}

fn adicionarBarra(t: String, current: int, total: int, largura: int): void {
    let cheio: int = 0;
    if (total > 0) { cheio = current * largura / total; }
    if (current > 0 && cheio == 0) { cheio = 1; }
    t.append("[");
    for (let i: int = 0; i < largura; i += 1) {
        if (i < cheio) { t.append_byte(byte(35)); }
        else { t.append_byte(byte(46)); }
    }
    t.append("]");
}

fn linha(): void {
    print("------------------------------------------------------------------");
}

/// Imprime "    N) nome - detalhe" (sem o " - " quando o detalhe é vazio).
fn imprimirOpcao(n: int, nome: text, detalhe: text): void {
    let t: String = new String();
    t.append("    ");
    adicionarNumero(t, n);
    t.append(") ");
    t.append(nome);
    if (len(detalhe) > 0) {
        t.append(" - ");
        t.append(detalhe);
    }
    print(t.view());
    t.dispose();
    free(t);
}

/// Acrescenta "atual/maximo" ao texto.
fn adicionarFracao(t: String, current: int, max: int): void {
    adicionarNumero(t, current);
    t.append("/");
    adicionarNumero(t, max);
}

// ----------------------------------------------------------------------------
//  ALEATORIEDADE: gerador congruencial linear de 64 bits (determinístico)
// ----------------------------------------------------------------------------

class Aleatorio {
    private let estado: int;

    fn init(semente: int): void {
        self.estado = semente * 2654435761 + 88172645463325252;
    }

    fn next(): int {
        self.estado = self.estado * 6364136223846793005 + 1442695040888963407;
        return (self.estado >> 33) & 0x7fffffff;
    }

    /// Inteiro uniforme em [de, ate].
    fn faixa(de: int, ate: int): int {
        return de + self.next() % (ate - de + 1);
    }

    fn chance(porcento: int): bool {
        return self.faixa(1, 100) <= porcento;
    }
}

// ----------------------------------------------------------------------------
//  ENTRADA PADRÃO: lê um número por linha; detecta o fim da entrada (EOF)
// ----------------------------------------------------------------------------

class Entrada {
    let buffer: *byte;
    let end: bool;
    let modoAuto: bool;

    fn init(): void {
        self.buffer = alloc<byte>(1);
        self.end = false;
        self.modoAuto = false;
    }

    /// Devolve o número digitado, -1 se a linha não tiver número, -2 no EOF.
    fn lerNumero(): int {
        let value: int = 0;
        let achou: bool = false;
        let lendo: bool = true;
        while (lendo) {
            let n: int = read_bytes(self.buffer, 1);
            if (n <= 0) {
                self.end = true;
                lendo = false;
            } else {
                let c: int = self.buffer[0];
                if (c == 10) { lendo = false; }
                else if (c >= 48 && c <= 57) {
                    value = value * 10 + (c - 48);
                    achou = true;
                }
            }
        }
        if (!achou) {
            if (self.end) { return -2; }
            return -1;
        }
        return value;
    }

    /// Verdadeiro quando os heróis devem agir sozinhos.
    fn automatico(): bool { return self.modoAuto || self.end; }

    fn liberar(): void { free(self.buffer); }
}

// ----------------------------------------------------------------------------
//  HABILIDADES — classe base + 5 especializações (polimorfismo em `usar`)
// ----------------------------------------------------------------------------

class Habilidade {
    let nome: text;
    let custo: int;
    let poder: int;
    let descricao: text;

    fn init(nome: text, custo: int, poder: int, descricao: text): void {
        self.nome = nome;
        self.custo = custo;
        self.poder = poder;
        self.descricao = descricao;
    }

    /// Verdadeiro quando o alvo é um aliado (cura, por exemplo).
    fn aliada(): bool { return false; }

    fn usar(usuario: Combatente, alvo: Combatente, rng: Aleatorio): void {
        usuario.ataqueBasico(alvo, rng);
    }
}

/// Dano físico: escala com FOR e é reduzido pela DEF do alvo.
class AtaqueFisico extends Habilidade {
    fn usar(usuario: Combatente, alvo: Combatente, rng: Aleatorio): void {
        let bruto: int = usuario.forca * self.poder / 10 + rng.faixa(0, 3);
        let dano: int = alvo.receberDano(bruto, false);
        print(usuario.nome, "usa", self.nome, "em", alvo.nome, "e causa", dano, "de dano!");
        usuario.avisarSeCaiu(alvo);
    }
}

/// Dano mágico: escala com MAG e ignora a DEF do alvo.
class DanoMagico extends Habilidade {
    fn usar(usuario: Combatente, alvo: Combatente, rng: Aleatorio): void {
        let bruto: int = usuario.magia * self.poder / 10 + rng.faixa(0, 4);
        let dano: int = alvo.receberDano(bruto, true);
        print(usuario.nome, "conjura", self.nome, "em", alvo.nome, "e causa", dano, "de dano mágico!");
        usuario.avisarSeCaiu(alvo);
    }
}

/// Cura um aliado: escala com MAG.
class Cura extends Habilidade {
    fn aliada(): bool { return true; }

    fn usar(usuario: Combatente, alvo: Combatente, rng: Aleatorio): void {
        let value: int = usuario.magia * self.poder / 10 + 6 + rng.faixa(0, 3);
        let real: int = alvo.curar(value);
        print(usuario.nome, "usa", self.nome, "em", alvo.nome, "e restaura", real, "de HP.");
    }
}

/// Dano pequeno + veneno (dano por turno, ignora DEF).
class Veneno extends Habilidade {
    fn usar(usuario: Combatente, alvo: Combatente, rng: Aleatorio): void {
        let bruto: int = (usuario.forca + usuario.magia) / 3 + rng.faixa(0, 2);
        let dano: int = alvo.receberDano(bruto, false);
        alvo.veneno = 4;
        print(usuario.nome, "usa", self.nome, "em", alvo.nome, "- causa", dano, "de dano e o ENVENENA!");
        usuario.avisarSeCaiu(alvo);
    }
}

/// Dano mágico que devolve metade do dano causado ao usuário.
class Drenar extends Habilidade {
    fn usar(usuario: Combatente, alvo: Combatente, rng: Aleatorio): void {
        let bruto: int = usuario.magia * self.poder / 10 + rng.faixa(0, 3);
        let dano: int = alvo.receberDano(bruto, true);
        let cura: int = usuario.curar(dano / 2);
        print(usuario.nome, "usa", self.nome, "em", alvo.nome, "- causa", dano, "de dano e recupera", cura, "de HP!");
        usuario.avisarSeCaiu(alvo);
    }
}

// ----------------------------------------------------------------------------
//  COMBATENTE — base de heróis e inimigos
// ----------------------------------------------------------------------------

class Combatente {
    let nome: text;
    let nivel: int;
    let hp: int;
    let hpMax: int;
    let mp: int;
    let mpMax: int;
    let forca: int;
    let defesa: int;
    let magia: int;
    let velocidade: int;
    let guardando: bool;
    let veneno: int;
    let xp: int;
    let xpProximo: int;
    let habilidades: Array<Habilidade>;

    fn init(nome: text, hpMax: int, mpMax: int, forca: int, defesa: int, magia: int, velocidade: int): void {
        self.nome = nome;
        self.nivel = 1;
        self.hpMax = hpMax;
        self.hp = hpMax;
        self.mpMax = mpMax;
        self.mp = mpMax;
        self.forca = forca;
        self.defesa = defesa;
        self.magia = magia;
        self.velocidade = velocidade;
        self.guardando = false;
        self.veneno = 0;
        self.xp = 0;
        self.xpProximo = 30;
        self.habilidades = new Array<Habilidade>();
    }

    // ---- métodos virtuais (sobrescritos pelas subclasses) ----
    fn classe(): text { return "Criatura"; }
    fn controlavel(): bool { return false; }
    fn xpRecompensa(): int { return 0; }
    fn ganharXp(count: int): void { }

    /// Ataque comum: FOR + sorte, com 10% de crítico (dobra o dano).
    fn ataqueBasico(alvo: Combatente, rng: Aleatorio): void {
        let bruto: int = self.forca + rng.faixa(0, 3);
        let critico: bool = rng.chance(10);
        if (critico) { bruto = bruto * 2; }
        let dano: int = alvo.receberDano(bruto, false);
        if (critico) {
            print(self.nome, "acerta um golpe CRÍTICO em", alvo.nome, "e causa", dano, "de dano!");
        } else {
            print(self.nome, "ataca", alvo.nome, "e causa", dano, "de dano.");
        }
        self.avisarSeCaiu(alvo);
    }

    /// Turno de um combatente não controlado pelo jogador.
    fn agir(aliados: Array<Combatente>, oponentes: Array<Combatente>, rng: Aleatorio): void {
        let alvo: Combatente = alvoAleatorio(oponentes, rng);
        if (alvo != null) { self.ataqueBasico(alvo, rng); }
    }

    // ---- métodos comuns ----
    fn vivo(): bool { return self.hp > 0; }

    /// Aplica dano e devolve o dano realmente sofrido.
    fn receberDano(bruto: int, perfurante: bool): int {
        let d: int = bruto;
        if (!perfurante) { d = d - self.defesa / 2; }
        if (self.guardando) { d = d / 2; }
        if (d < 1) { d = 1; }
        if (d > self.hp) { d = self.hp; }
        self.hp -= d;
        return d;
    }

    fn curar(count: int): int {
        let antes: int = self.hp;
        self.hp += count;
        if (self.hp > self.hpMax) { self.hp = self.hpMax; }
        return self.hp - antes;
    }

    fn restaurarMp(count: int): int {
        let antes: int = self.mp;
        self.mp += count;
        if (self.mp > self.mpMax) { self.mp = self.mpMax; }
        return self.mp - antes;
    }

    fn avisarSeCaiu(alvo: Combatente): void {
        if (!alvo.vivo()) { print("  >>", alvo.nome, "foi derrotado!"); }
    }

    /// Início do turno: encerra a defesa anterior e aplica o veneno.
    fn iniciarTurno(): void {
        self.guardando = false;
        if (self.veneno > 0) {
            let dano: int = 3 + self.nivel;
            if (dano > self.hp) { dano = self.hp; }
            self.hp -= dano;
            self.veneno -= 1;
            print("  *", self.nome, "sofre", dano, "de dano do veneno.");
            if (!self.vivo()) { print("  >>", self.nome, "sucumbiu ao veneno!"); }
        }
    }

    /// Usa uma habilidade, gastando MP. Devolve false se faltar MP.
    fn usarHabilidade(habilidade: Habilidade, alvo: Combatente, rng: Aleatorio): bool {
        if (self.mp < habilidade.custo) {
            print("  MP insuficiente para", habilidade.nome);
            return false;
        }
        self.mp -= habilidade.custo;
        habilidade.usar(self, alvo, rng);
        return true;
    }

    /// Recuperação entre batalhas (também reergue quem caiu).
    fn descansar(): void {
        if (!self.vivo()) { self.hp = self.hpMax / 4; }
        else { self.curar(self.hpMax * 4 / 10); }
        self.restaurarMp(self.mpMax / 2);
        self.veneno = 0;
        self.guardando = false;
    }

    fn ficha(): void {
        let t: String = new String();
        t.append("  ");
        t.append(self.nome);
        adicionarEspacos(t, 14 - compr(self.nome));
        t.append(self.classe());
        adicionarEspacos(t, 10 - compr(self.classe()));
        t.append("Nv ");
        adicionarNumero(t, self.nivel);
        t.append(" | HP ");
        adicionarNumero(t, self.hpMax);
        t.append(" MP ");
        adicionarNumero(t, self.mpMax);
        t.append(" | FOR ");
        adicionarNumero(t, self.forca);
        t.append(" DEF ");
        adicionarNumero(t, self.defesa);
        t.append(" MAG ");
        adicionarNumero(t, self.magia);
        t.append(" VEL ");
        adicionarNumero(t, self.velocidade);
        print(t.view());
        t.dispose();
        free(t);
    }

    fn linhaStatus(): void {
        let t: String = new String();
        t.append("  ");
        t.append(self.nome);
        adicionarEspacos(t, 14 - compr(self.nome));
        t.append(self.classe());
        adicionarEspacos(t, 10 - compr(self.classe()));
        t.append("Nv ");
        adicionarNumero(t, self.nivel);
        t.append("  HP ");
        adicionarBarra(t, self.hp, self.hpMax, 12);
        t.append(" ");
        adicionarNumero(t, self.hp);
        t.append("/");
        adicionarNumero(t, self.hpMax);
        if (self.mpMax > 0) {
            t.append("  MP ");
            adicionarNumero(t, self.mp);
            t.append("/");
            adicionarNumero(t, self.mpMax);
        }
        if (self.veneno > 0) { t.append("  [VENENO]"); }
        if (self.guardando) { t.append("  [DEFESA]"); }
        if (!self.vivo()) { t.append("  [K.O.]"); }
        print(t.view());
        t.dispose();
        free(t);
    }

    /// Libera as habilidades e o próprio combatente.
    fn liberar(): void {
        for (let i: int = 0; i < len(self.habilidades); i += 1) { free(self.habilidades[i]); }
        free(self.habilidades);
        free(self);
    }
}

// ----------------------------------------------------------------------------
//  HERÓIS: Combatente -> Heroi -> Guerreiro / Mago / Clerigo
// ----------------------------------------------------------------------------

class Heroi extends Combatente {
    fn classe(): text { return "Herói"; }
    fn controlavel(): bool { return true; }

    /// Soma XP e sobe de nível quantas vezes for preciso.
    fn ganharXp(count: int): void {
        self.xp += count;
        let m: String = new String();
        m.append("  ");
        m.append(self.nome);
        m.append(" ganha ");
        adicionarNumero(m, count);
        m.append(" de XP (");
        adicionarFracao(m, self.xp, self.xpProximo);
        m.append(")");
        print(m.view());
        m.dispose();
        free(m);
        while (self.xp >= self.xpProximo) {
            self.xp -= self.xpProximo;
            self.xpProximo = self.xpProximo * 3 / 2 + 10;
            self.nivel += 1;
            let n: String = new String();
            n.append("  *** ");
            n.append(self.nome);
            n.append(" subiu para o nível ");
            adicionarNumero(n, self.nivel);
            n.append("! ***");
            print(n.view());
            n.dispose();
            free(n);
            self.subirNivel();
        }
    }

    /// Crescimento genérico. Cada classe sobrescreve com seus próprios ganhos.
    fn subirNivel(): void { self.aplicarCrescimento(8, 2, 2, 1, 2, 1); }

    fn aplicarCrescimento(dhp: int, dmp: int, dfor: int, ddef: int, dmag: int, dvel: int): void {
        self.hpMax += dhp;
        self.mpMax += dmp;
        self.forca += dfor;
        self.defesa += ddef;
        self.magia += dmag;
        self.velocidade += dvel;
        self.curar(dhp + self.hpMax / 4);
        self.restaurarMp(dmp + self.mpMax / 4);
        let g: String = new String();
        g.append("     +");
        adicionarNumero(g, dhp);
        g.append(" HP  +");
        adicionarNumero(g, dmp);
        g.append(" MP  +");
        adicionarNumero(g, dfor);
        g.append(" FOR  +");
        adicionarNumero(g, ddef);
        g.append(" DEF  +");
        adicionarNumero(g, dmag);
        g.append(" MAG  +");
        adicionarNumero(g, dvel);
        g.append(" VEL");
        print(g.view());
        g.dispose();
        free(g);
    }
}

class Guerreiro extends Heroi {
    fn classe(): text { return "Guerreira"; }
    fn subirNivel(): void { self.aplicarCrescimento(13, 2, 3, 2, 0, 1); }
}

class Mago extends Heroi {
    fn classe(): text { return "Maga"; }
    fn subirNivel(): void { self.aplicarCrescimento(6, 7, 1, 1, 4, 1); }

    /// O cajado usa um pouco da magia: o ataque comum do mago é diferente.
    fn ataqueBasico(alvo: Combatente, rng: Aleatorio): void {
        let bruto: int = self.forca + self.magia / 3 + rng.faixa(0, 3);
        let dano: int = alvo.receberDano(bruto, false);
        print(self.nome, "golpeia", alvo.nome, "com o cajado e causa", dano, "de dano.");
        self.avisarSeCaiu(alvo);
    }
}

class Clerigo extends Heroi {
    fn classe(): text { return "Clérigo"; }
    fn subirNivel(): void { self.aplicarCrescimento(9, 5, 1, 2, 3, 1); }
}

// ----------------------------------------------------------------------------
//  INIMIGOS: Combatente -> Inimigo -> Slime / Goblin / Lobo / Dragao
// ----------------------------------------------------------------------------

class Inimigo extends Combatente {
    let recompensa: int;
    fn classe(): text { return "Monstro"; }
    fn xpRecompensa(): int { return self.recompensa; }
}

class Slime extends Inimigo {
    fn classe(): text { return "Slime"; }

    /// 25% de chance de se contrair (defesa); senão ataca.
    fn agir(aliados: Array<Combatente>, oponentes: Array<Combatente>, rng: Aleatorio): void {
        if (rng.chance(25)) {
            self.guardando = true;
            print(self.nome, "se contrai e endurece o corpo gelatinoso.");
        } else {
            let alvo: Combatente = alvoAleatorio(oponentes, rng);
            if (alvo != null) { self.ataqueBasico(alvo, rng); }
        }
    }
}

class Goblin extends Inimigo {
    fn classe(): text { return "Goblin"; }

    /// 35% de chance de usar sua habilidade (Machadada) em vez do ataque comum.
    fn agir(aliados: Array<Combatente>, oponentes: Array<Combatente>, rng: Aleatorio): void {
        let alvo: Combatente = alvoAleatorio(oponentes, rng);
        if (alvo != null) {
            if (rng.chance(35) && len(self.habilidades) > 0) {
                self.habilidades[0].usar(self, alvo, rng);
            } else {
                self.ataqueBasico(alvo, rng);
            }
        }
    }
}

class Lobo extends Inimigo {
    fn classe(): text { return "Fera"; }

    /// Mordida dupla: dois ataques por turno, cada um num alvo aleatório.
    fn agir(aliados: Array<Combatente>, oponentes: Array<Combatente>, rng: Aleatorio): void {
        for (let i: int = 0; i < 2; i += 1) {
            let alvo: Combatente = alvoAleatorio(oponentes, rng);
            if (alvo != null) { self.ataqueBasico(alvo, rng); }
        }
    }
}

class Dragao extends Inimigo {
    let turnos: int;
    fn classe(): text { return "Chefe"; }

    /// A cada 3 turnos, sopra fogo em todo o grupo; às vezes envenena com a cauda.
    fn agir(aliados: Array<Combatente>, oponentes: Array<Combatente>, rng: Aleatorio): void {
        self.turnos += 1;
        if (self.turnos % 3 == 0) {
            print(self.nome, "inspira fundo e SOPRA FOGO em todo o grupo!");
            for (let i: int = 0; i < len(oponentes); i += 1) {
                let alvo: Combatente = oponentes[i];
                if (alvo.vivo()) {
                    let dano: int = alvo.receberDano(self.magia + rng.faixa(0, 4), true);
                    print("    ", alvo.nome, "sofre", dano, "de dano de fogo.");
                    self.avisarSeCaiu(alvo);
                }
            }
        } else {
            let alvo: Combatente = alvoAleatorio(oponentes, rng);
            if (alvo != null) {
                if (rng.chance(30) && len(self.habilidades) > 0) {
                    self.habilidades[0].usar(self, alvo, rng);
                } else {
                    self.ataqueBasico(alvo, rng);
                }
            }
        }
    }
}

// ----------------------------------------------------------------------------
//  ITENS — classe base + 4 especializações, e o inventário
// ----------------------------------------------------------------------------

class Item {
    let nome: text;
    let descricao: text;
    let count: int;

    fn init(nome: text, descricao: text, count: int): void {
        self.nome = nome;
        self.descricao = descricao;
        self.count = count;
    }

    /// Verdadeiro quando o alvo do item é um aliado.
    fn aliado(): bool { return true; }

    /// Verdadeiro se usar o item no alvo teria algum efeito.
    fn util(alvo: Combatente): bool { return false; }

    /// Aplica o efeito. Devolve true se o item foi consumido.
    fn usar(usuario: Combatente, alvo: Combatente): bool { return false; }
}

class Pocao extends Item {
    fn util(alvo: Combatente): bool { return alvo.hp < alvo.hpMax; }

    fn usar(usuario: Combatente, alvo: Combatente): bool {
        if (!self.util(alvo)) { print("  Não faria efeito em", alvo.nome); return false; }
        let real: int = alvo.curar(45);
        print(usuario.nome, "usa", self.nome, "em", alvo.nome, "e restaura", real, "de HP.");
        return true;
    }
}

class Elixir extends Item {
    fn util(alvo: Combatente): bool { return alvo.mpMax > 0 && alvo.mp < alvo.mpMax; }

    fn usar(usuario: Combatente, alvo: Combatente): bool {
        if (!self.util(alvo)) { print("  Não faria efeito em", alvo.nome); return false; }
        let real: int = alvo.restaurarMp(25);
        print(usuario.nome, "usa", self.nome, "em", alvo.nome, "e restaura", real, "de MP.");
        return true;
    }
}

class Antidoto extends Item {
    fn util(alvo: Combatente): bool { return alvo.veneno > 0; }

    fn usar(usuario: Combatente, alvo: Combatente): bool {
        if (!self.util(alvo)) { print("  Não faria efeito em", alvo.nome); return false; }
        alvo.veneno = 0;
        print(usuario.nome, "usa", self.nome, "em", alvo.nome, "- o veneno some!");
        return true;
    }
}

class Bomba extends Item {
    fn aliado(): bool { return false; }
    fn util(alvo: Combatente): bool { return alvo.vivo(); }

    fn usar(usuario: Combatente, alvo: Combatente): bool {
        let dano: int = alvo.receberDano(35, true);
        print(usuario.nome, "arremessa", self.nome, "em", alvo.nome, "e causa", dano, "de dano explosivo!");
        usuario.avisarSeCaiu(alvo);
        return true;
    }
}

class Inventario {
    private let itens: Array<Item>;

    fn init(): void { self.itens = new Array<Item>(); }

    fn tipos(): int { return len(self.itens); }
    fn get(indice: int): Item { return self.itens[indice]; }

    /// Soma ao estoque se o item já existir; senão guarda o novo objeto.
    fn append(novo: Item): void {
        let achou: bool = false;
        for (let i: int = 0; i < len(self.itens); i += 1) {
            if (!achou && self.itens[i].nome == novo.nome) {
                self.itens[i].count += novo.count;
                achou = true;
            }
        }
        if (achou) { free(novo); }
        else { self.itens.push(novo); }
    }

    /// Gasta uma unidade; remove o item do inventário se acabar.
    fn consumir(indice: int): void {
        let it: Item = self.itens[indice];
        it.count -= 1;
        if (it.count <= 0) {
            self.itens.remove(indice);
            free(it);
        }
    }

    fn liberar(): void {
        for (let i: int = 0; i < len(self.itens); i += 1) { free(self.itens[i]); }
        free(self.itens);
    }
}

