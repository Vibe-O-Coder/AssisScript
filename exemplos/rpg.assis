/// Monta o grupo de inimigos de cada fase.
fn montarEncontro(fase: int): Array<Combatente> {
    let grupo: Array<Combatente> = new Array<Combatente>();
    if (fase == 1) {
        grupo.push(novoSlime("Slime Verde"));
        grupo.push(novoSlime("Slime Azul"));
    } else if (fase == 2) {
        grupo.push(novoGoblin("Goblin"));
        grupo.push(novoLobo("Lobo Sombrio"));
    } else {
        grupo.push(novoDragao("Dragão Ancião"));
    }
    return grupo;
}

// ----------------------------------------------------------------------------
//  FUNÇÕES AUXILIARES DE GRUPOS
// ----------------------------------------------------------------------------

fn contarVivos(grupo: Array<Combatente>): int {
    let n: int = 0;
    for (let i: int = 0; i < len(grupo); i += 1) {
        if (grupo[i].vivo()) { n += 1; }
    }
    return n;
}

fn alvoAleatorio(grupo: Array<Combatente>, rng: Aleatorio): Combatente {
    let vivos: int = contarVivos(grupo);
    if (vivos == 0) { return null; }
    let sorteado: int = rng.faixa(0, vivos - 1);
    let resultado: Combatente = null;
    let contador: int = 0;
    for (let i: int = 0; i < len(grupo); i += 1) {
        if (grupo[i].vivo()) {
            if (contador == sorteado) { resultado = grupo[i]; }
            contador += 1;
        }
    }
    return resultado;
}

/// Aliado vivo com a menor proporção de HP.
fn maisFerido(grupo: Array<Combatente>): Combatente {
    let pior: Combatente = null;
    for (let i: int = 0; i < len(grupo); i += 1) {
        let c: Combatente = grupo[i];
        if (c.vivo()) {
            if (pior == null) { pior = c; }
            else if (c.hp * 100 / c.hpMax < pior.hp * 100 / pior.hpMax) { pior = c; }
        }
    }
    return pior;
}

/// Inimigo vivo com menos HP absoluto.
fn maisFraco(grupo: Array<Combatente>): Combatente {
    let menor: Combatente = null;
    for (let i: int = 0; i < len(grupo); i += 1) {
        let c: Combatente = grupo[i];
        if (c.vivo()) {
            if (menor == null) { menor = c; }
            else if (c.hp < menor.hp) { menor = c; }
        }
    }
    return menor;
}

// ----------------------------------------------------------------------------
//  BATALHA — controla rodadas, ordem por velocidade, menus e recompensas
// ----------------------------------------------------------------------------

class Batalha {
    let herois: Array<Combatente>;
    let inimigos: Array<Combatente>;
    let inv: Inventario;
    let rng: Aleatorio;
    let entrada: Entrada;

    fn init(herois: Array<Combatente>, inimigos: Array<Combatente>, inv: Inventario, rng: Aleatorio, entrada: Entrada): void {
        self.herois = herois;
        self.inimigos = inimigos;
        self.inv = inv;
        self.rng = rng;
        self.entrada = entrada;
    }

    fn terminou(): bool {
        return contarVivos(self.herois) == 0 || contarVivos(self.inimigos) == 0;
    }

    /// Todos os vivos, do mais veloz ao mais lento (ordenação por inserção).
    fn montarOrdem(): Array<Combatente> {
        let ordem: Array<Combatente> = new Array<Combatente>();
        for (let i: int = 0; i < len(self.herois); i += 1) {
            if (self.herois[i].vivo()) { ordem.push(self.herois[i]); }
        }
        for (let i: int = 0; i < len(self.inimigos); i += 1) {
            if (self.inimigos[i].vivo()) { ordem.push(self.inimigos[i]); }
        }
        for (let i: int = 1; i < len(ordem); i += 1) {
            let chave: Combatente = ordem[i];
            let j: int = i - 1;
            while (j >= 0 && ordem[j].velocidade < chave.velocidade) {
                ordem[j + 1] = ordem[j];
                j -= 1;
            }
            ordem[j + 1] = chave;
        }
        return ordem;
    }

    fn mostrarCampo(): void {
        linha();
        print("  HERÓIS");
        for (let i: int = 0; i < len(self.herois); i += 1) { self.herois[i].linhaStatus(); }
        print("  INIMIGOS");
        for (let i: int = 0; i < len(self.inimigos); i += 1) { self.inimigos[i].linhaStatus(); }
        linha();
    }

    /// Lê um número entre `de` e `ate`. Devolve -2 se a entrada acabar.
    fn escolher(de: int, ate: int): int {
        let resultado: int = -3;
        while (resultado == -3) {
            let n: int = self.entrada.lerNumero();
            if (n == -2) { resultado = -2; }
            else if (n >= de && n <= ate) { resultado = n; }
            else {
                let aviso: String = new String();
                aviso.append("  Opção inválida. Digite um número de ");
                adicionarNumero(aviso, de);
                aviso.append(" a ");
                adicionarNumero(aviso, ate);
                aviso.append(".");
                print(aviso.view());
                aviso.dispose();
                free(aviso);
            }
        }
        return resultado;
    }

    /// Menu de alvos. Devolve null se o jogador voltar (ou a entrada acabar).
    fn escolherAlvo(grupo: Array<Combatente>, titulo: text): Combatente {
        let indices: Array<int> = new Array<int>();
        for (let i: int = 0; i < len(grupo); i += 1) {
            if (grupo[i].vivo()) { indices.push(i); }
        }
        let resultado: Combatente = null;
        if (len(indices) == 1) {
            resultado = grupo[indices[0]];
        } else if (len(indices) > 1) {
            print(titulo);
            for (let k: int = 0; k < len(indices); k += 1) {
                let c: Combatente = grupo[indices[k]];
                let d: String = new String();
                d.append("HP ");
                adicionarFracao(d, c.hp, c.hpMax);
                imprimirOpcao(k + 1, c.nome, d.view());
                d.dispose();
                free(d);
            }
            print("    0) Voltar");
            let op: int = self.escolher(0, len(indices));
            if (op >= 1) { resultado = grupo[indices[op - 1]]; }
        }
        free(indices);
        return resultado;
    }

    // ---------------- turno controlado pelo jogador ----------------

    fn turnoHeroi(c: Combatente): void {
        let feito: bool = false;
        while (!feito) {
            if (self.entrada.automatico()) {
                self.turnoAutomatico(c);
                feito = true;
            } else {
                print("");
                let cab: String = new String();
                cab.append("Turno de ");
                cab.append(c.nome);
                cab.append(" (");
                cab.append(c.classe());
                cab.append(") - HP ");
                adicionarFracao(cab, c.hp, c.hpMax);
                cab.append(" | MP ");
                adicionarFracao(cab, c.mp, c.mpMax);
                print(cab.view());
                cab.dispose();
                free(cab);
                print("  1) Atacar   2) Habilidade   3) Item   4) Defender");
                let op: int = self.escolher(1, 4);
                if (op == 1) {
                    let alvo: Combatente = self.escolherAlvo(self.inimigos, "  Atacar quem?");
                    if (alvo != null) { c.ataqueBasico(alvo, self.rng); feito = true; }
                } else if (op == 2) {
                    feito = self.menuHabilidade(c);
                } else if (op == 3) {
                    feito = self.menuItem(c);
                } else if (op == 4) {
                    c.guardando = true;
                    print(c.nome, "assume postura defensiva (dano pela metade até o próximo turno).");
                    feito = true;
                }
            }
        }
    }

    fn menuHabilidade(c: Combatente): bool {
        print("  Habilidades:");
        for (let i: int = 0; i < len(c.habilidades); i += 1) {
            let h: Habilidade = c.habilidades[i];
            let d: String = new String();
            d.append("MP ");
            adicionarNumero(d, h.custo);
            d.append(" - ");
            d.append(h.descricao);
            imprimirOpcao(i + 1, h.nome, d.view());
            d.dispose();
            free(d);
        }
        print("    0) Voltar");
        let op: int = self.escolher(0, len(c.habilidades));
        if (op < 1) { return false; }
        let h: Habilidade = c.habilidades[op - 1];
        if (c.mp < h.custo) { print("  MP insuficiente!"); return false; }
        let alvo: Combatente = null;
        if (h.aliada()) { alvo = self.escolherAlvo(self.herois, "  Em quem?"); }
        else { alvo = self.escolherAlvo(self.inimigos, "  Em quem?"); }
        if (alvo == null) { return false; }
        return c.usarHabilidade(h, alvo, self.rng);
    }

    fn menuItem(c: Combatente): bool {
        if (self.inv.tipos() == 0) { print("  O inventário está vazio."); return false; }
        print("  Itens:");
        for (let i: int = 0; i < self.inv.tipos(); i += 1) {
            let it: Item = self.inv.get(i);
            let d: String = new String();
            d.append("[x");
            adicionarNumero(d, it.count);
            d.append("] ");
            d.append(it.descricao);
            imprimirOpcao(i + 1, it.nome, d.view());
            d.dispose();
            free(d);
        }
        print("    0) Voltar");
        let op: int = self.escolher(0, self.inv.tipos());
        if (op < 1) { return false; }
        let it: Item = self.inv.get(op - 1);
        let alvo: Combatente = null;
        if (it.aliado()) { alvo = self.escolherAlvo(self.herois, "  Em quem?"); }
        else { alvo = self.escolherAlvo(self.inimigos, "  Em quem?"); }
        if (alvo == null) { return false; }
        if (it.usar(c, alvo)) {
            self.inv.consumir(op - 1);
            return true;
        }
        return false;
    }

    // ---------------- piloto automático dos heróis ----------------

    /// Tenta usar um item aliado útil no alvo. Devolve true se usou.
    fn itemAutomatico(c: Combatente, alvo: Combatente): bool {
        for (let i: int = 0; i < self.inv.tipos(); i += 1) {
            let it: Item = self.inv.get(i);
            if (it.aliado() && it.util(alvo)) {
                if (it.usar(c, alvo)) {
                    self.inv.consumir(i);
                    return true;
                }
            }
        }
        return false;
    }

    fn turnoAutomatico(c: Combatente): void {
        let feito: bool = false;
        let ferido: Combatente = maisFerido(self.herois);

        // 1) Curar quem está abaixo de 40% de HP (habilidade primeiro, depois item).
        if (ferido != null && ferido.hp * 100 / ferido.hpMax < 40) {
            for (let i: int = 0; i < len(c.habilidades); i += 1) {
                let h: Habilidade = c.habilidades[i];
                if (!feito && h.aliada() && c.mp >= h.custo) {
                    feito = c.usarHabilidade(h, ferido, self.rng);
                }
            }
            if (!feito) { feito = self.itemAutomatico(c, ferido); }
        }

        // 2) Atacar com a melhor habilidade que o MP permitir (65%) ou golpe comum.
        if (!feito) {
            let alvo: Combatente = maisFraco(self.inimigos);
            if (alvo != null) {
                let melhor: Habilidade = null;
                for (let i: int = 0; i < len(c.habilidades); i += 1) {
                    let h: Habilidade = c.habilidades[i];
                    if (!h.aliada() && c.mp >= h.custo) {
                        if (melhor == null) { melhor = h; }
                        else if (h.poder > melhor.poder) { melhor = h; }
                    }
                }
                if (melhor != null && self.rng.chance(65)) {
                    c.usarHabilidade(melhor, alvo, self.rng);
                } else {
                    c.ataqueBasico(alvo, self.rng);
                }
            }
        }
    }

    // ---------------- laço principal da batalha ----------------

    fn rodada(numero: int): void {
        print("");
        print("=== RODADA", numero, "===");
        self.mostrarCampo();
        let ordem: Array<Combatente> = self.montarOrdem();
        for (let i: int = 0; i < len(ordem); i += 1) {
            let c: Combatente = ordem[i];
            if (c.vivo() && !self.terminou()) {
                c.iniciarTurno();
                if (c.vivo()) {
                    if (c.controlavel()) {
                        self.turnoHeroi(c);
                    } else {
                        c.agir(self.inimigos, self.herois, self.rng);
                    }
                }
            }
        }
        free(ordem);
    }

    /// Executa a batalha. Devolve true se os heróis venceram.
    fn run(): bool {
        let numero: int = 1;
        while (!self.terminou()) {
            self.rodada(numero);
            numero += 1;
        }
        let venceu: bool = contarVivos(self.herois) > 0;
        print("");
        if (venceu) {
            print("*** VITÓRIA! ***");
            let total: int = 0;
            for (let i: int = 0; i < len(self.inimigos); i += 1) { total += self.inimigos[i].xpRecompensa(); }
            for (let i: int = 0; i < len(self.herois); i += 1) {
                if (self.herois[i].vivo()) { self.herois[i].ganharXp(total); }
            }
        } else {
            print("*** DERROTA... o grupo caiu. ***");
        }
        return venceu;
    }

    /// Libera os inimigos (a batalha é dona deles).
    fn liberar(): void {
        for (let i: int = 0; i < len(self.inimigos); i += 1) { self.inimigos[i].liberar(); }
        free(self.inimigos);
    }
}

// ----------------------------------------------------------------------------
//  PROGRAMA PRINCIPAL
// ----------------------------------------------------------------------------

safe fn main(): int {
    unsafe {
    let entrada: Entrada = new Entrada();

    linha();
    print("   CRÔNICAS DO ASSIS - um RPG de turnos em AssisScript");
    linha();
    print("Três heróis descem à Caverna do Dragão Ancião. Vença 3 batalhas!");
    print("");
    print("  1) Jogar     2) Assistir (modo automático)");
    let modo: int = entrada.lerNumero();
    if (modo == 2) { entrada.modoAuto = true; }
    if (modo == -2) { print("(sem entrada: modo automático)"); }

    let semente: int = 0;
    if (!entrada.end) {
        print("Semente do sorteio (um número; 0 ou vazio = aleatória):");
        semente = entrada.lerNumero();
    }
    if (semente <= 0) { semente = monotonic_ms(); }
    if (semente <= 0) { semente = 12345; }
    print("Semente:", semente);
    let rng: Aleatorio = new Aleatorio(semente);

    let herois: Array<Combatente> = new Array<Combatente>();
    herois.push(novoGuerreiro("Miyabi"));
    herois.push(novoMago("Yuri"));
    herois.push(novoClerigo("Assis"));

    let inv: Inventario = new Inventario();
    inv.append(new Pocao("Poção", "Restaura 45 de HP", 3));
    inv.append(new Elixir("Elixir", "Restaura 25 de MP", 1));
    inv.append(new Antidoto("Antídoto", "Cura veneno", 1));
    inv.append(new Bomba("Bomba", "35 de dano em um inimigo", 2));

    print("");
    print("O GRUPO:");
    for (let i: int = 0; i < len(herois); i += 1) { herois[i].ficha(); }

    let fase: int = 1;
    let vivo: bool = true;
    while (vivo && fase <= 3) {
        print("");
        linha();
        if (fase == 1) { print("  BATALHA 1/3 - A entrada da caverna"); }
        else if (fase == 2) { print("  BATALHA 2/3 - O covil das feras"); }
        else { print("  BATALHA 3/3 - O salão do Dragão Ancião!"); }
        linha();

        let inimigos: Array<Combatente> = montarEncontro(fase);
        print("Inimigos à frente:");
        for (let i: int = 0; i < len(inimigos); i += 1) { inimigos[i].ficha(); }

        let batalha: Batalha = new Batalha(herois, inimigos, inv, rng, entrada);
        vivo = batalha.run();
        batalha.liberar();
        free(batalha);

        if (vivo && fase < 3) {
            print("");
            print("O grupo descansa um pouco e encontra suprimentos na caverna.");
            for (let i: int = 0; i < len(herois); i += 1) { herois[i].descansar(); }
            inv.append(new Pocao("Poção", "Restaura 45 de HP", 1));
            if (fase == 1) { inv.append(new Antidoto("Antídoto", "Cura veneno", 1)); }
            if (fase == 2) { inv.append(new Elixir("Elixir", "Restaura 25 de MP", 1)); }
            print("  (+1 Poção)");
        }
        fase += 1;
    }

    print("");
    linha();
    if (vivo) {
        print("  O Dragão Ancião tombou! A caverna é de vocês. FIM - GLÓRIA AO GRUPO!");
    } else {
        print("  FIM DE JOGO. Os heróis serão lembrados... talvez.");
    }
    linha();
    print("Estado final do grupo:");
    for (let i: int = 0; i < len(herois); i += 1) { herois[i].ficha(); }

    for (let i: int = 0; i < len(herois); i += 1) { herois[i].liberar(); }
    free(herois);
    inv.liberar();
    free(inv);
    free(rng);
    entrada.liberar();
    free(entrada);
    return 0;

    }
}
