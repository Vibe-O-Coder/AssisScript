// Aplicação A: CSV com uma coluna chamada valor, inteiros int64, aspas opcionais.
// Uso: relatorio entrada.csv saida.csv. Buffers fixos; nenhuma linha cresce em memória.
#yuri <std/errors.assis>
#yuri <std/convert.assis>

value struct ResumoCsv { let registros: int; let total: int; }

// A conversão da representação C dos argumentos fica nesta fronteira explícita.
safe assis abrir_argumento(indice: int, modo: int): own File {
    unsafe {
        let size: int = arg_size(indice);
        if (size < 0 || size > 16384) { return file_open("", 9); }
        let caminho: *byte = alloc<byte>(size + 1); defer free(caminho);
        if (arg_copy(indice, caminho, size + 1) < 0) { return file_open("", 9); }
        return file_open(text(caminho), modo);
    }
}

safe assis numero_csv(borrow linha: *byte, size: int): Result<int, int> {
    if (size <= 0 || size > len(linha)) { return new Result<int, int>.Err(2); }
    let start: int = 0; let end: int = size;
    if (linha[0] == 34) {
        if (size < 3 || linha[size - 1] != 34) { return new Result<int, int>.Err(2); }
        start += 1; end -= 1;
    }
    let negativo: bool = false;
    if (linha[start] == 45) { negativo = true; start += 1; }
    if (start == end) { return new Result<int, int>.Err(2); }
    let value: int = 0; let ultimo: int = 7;
    if (negativo) { ultimo = 8; }
    while (start < end) {
        let digit: int = int(linha[start]) - 48;
        if (digit < 0 || digit > 9) { return new Result<int, int>.Err(2); }
        if (value < -922337203685477580 || (value == -922337203685477580 && digit > ultimo)) { return new Result<int, int>.Err(3); }
        value = value * 10 - digit; start += 1;
    }
    if (!negativo) { value = -value; }
    return new Result<int, int>.Ok(value);
}

pure assis somar_csv(resumo: ResumoCsv, value: int): Result<ResumoCsv, int> {
    if ((value > 0 && resumo.total > 9223372036854775807 - value) ||
        (value < 0 && resumo.total < -9223372036854775808 - value) || resumo.registros == 9223372036854775807) {
        return new Result<ResumoCsv, int>.Err(3);
    }
    return new Result<ResumoCsv, int>.Ok(new ResumoCsv(resumo.registros + 1, resumo.total + value));
}

safe assis processar_linha(borrow linha: *byte, size: int, resumo: ResumoCsv): Result<ResumoCsv, int> {
    match (numero_csv(linha, size)) {
        Err(code) { return new Result<ResumoCsv, int>.Err(code); }
        Ok(value) { return somar_csv(resumo, value); }
    }
}

safe assis assis_assis(): int {
    if (arg_count() != 3) { print("Uso: relatorio entrada.csv saida.csv"); return 64; }
    own entrada: File = abrir_argumento(1, 0);
    if (entrada == null) { print("Erro ao abrir entrada", io_error()); return 1; }
    own bloco: *byte = alloc<byte>(65536);
    val capacity: int = len(bloco);
    own linha: *byte = alloc<byte>(24);
    let size: int = 0; let cabecalho: bool = true; let linha_cr: bool = false;
    let resumo: ResumoCsv = new ResumoCsv(0, 0);
    while (true) {
        let lidos: int = file_read(entrada, bloco, capacity);
        if (lidos < 0) { print("Erro de leitura", -lidos); return 1; }
        if (lidos == 0) { break; }
        for (let i: int = 0; i < lidos; i += 1) {
            let b: byte = bloco[i];
            if (b == 10) {
                if (linha_cr) { size -= 1; }
                if (cabecalho) {
                    if (size != 5 || linha[0] != 118 || linha[1] != 97 || linha[2] != 108 || linha[3] != 117 || linha[4] != 101) { print("Cabecalho deve ser value"); return 2; }
                    cabecalho = false;
                } else {
                    match (processar_linha(linha, size, resumo)) {
                        Ok(novo) { resumo = novo; }
                        Err(code) { print("CSV invalido na linha", resumo.registros + 2); return code; }
                    }
                }
                size = 0; linha_cr = false;
            } else {
                if (size == len(linha) || linha_cr) { print("Linha invalida ou muito longa"); return 2; }
                linha[size] = b; size += 1; linha_cr = b == 13;
            }
        }
    }
    if (linha_cr || cabecalho) { print("Cabecalho ou final de linha invalido"); return 2; }
    if (size > 0) {
        match (processar_linha(linha, size, resumo)) {
            Ok(novo) { resumo = novo; }
            Err(code) { print("CSV invalido na ultima linha"); return code; }
        }
    }
    if (file_close(entrada) < 0) { print("Erro ao fechar entrada", io_error()); return 1; }
    own saida: File = abrir_argumento(2, 1);
    if (saida == null) { print("Erro ao abrir saida", io_error()); return 1; }
    own buffer: *byte = alloc<byte>(64);
    // Cabeçalho "registros,total\n", seguido por uma linha de resultados.
    buffer[0]=byte(114);buffer[1]=byte(101);buffer[2]=byte(103);buffer[3]=byte(105);buffer[4]=byte(115);buffer[5]=byte(116);buffer[6]=byte(114);buffer[7]=byte(111);buffer[8]=byte(115);buffer[9]=byte(44);buffer[10]=byte(116);buffer[11]=byte(111);buffer[12]=byte(116);buffer[13]=byte(97);buffer[14]=byte(108);buffer[15]=byte(10);
    own decimal: *byte = alloc<byte>(20);
    let usados: int = 16; let n: int = format_int_buffer(resumo.registros, decimal);
    for (let i: int = 0; i < n; i += 1) { buffer[usados] = decimal[i]; usados += 1; }
    buffer[usados] = byte(44); usados += 1;
    n = format_int_buffer(resumo.total, decimal);
    for (let i: int = 0; i < n; i += 1) { buffer[usados] = decimal[i]; usados += 1; }
    buffer[usados] = byte(10); usados += 1;
    // Escritas podem ser curtas; o bloco restante é compactado no mesmo buffer.
    while (usados > 0) {
        let gravados: int = file_write(saida, buffer, usados);
        if (gravados <= 0) { print("Erro de escrita", io_error()); return 1; }
        for (let i: int = gravados; i < usados; i += 1) { buffer[i - gravados] = buffer[i]; }
        usados -= gravados;
    }
    if (file_close(saida) < 0) { print("Erro ao fechar saida", io_error()); return 1; }
    print("Registros", resumo.registros, "total", resumo.total);
    return 0;
}
