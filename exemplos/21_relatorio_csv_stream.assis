// Aplicação A: CSV com uma coluna chamada valor, inteiros int64, aspas opcionais.
// Uso: relatorio entrada.csv saida.csv. Buffers fixos; nenhuma linha cresce em memória.
#yuri <std/erros.assis>
#yuri <std/conversoes.assis>

value struct ResumoCsv { let registros: int; let total: int; }

// A conversão da representação C dos argumentos fica nesta fronteira explícita.
safe assis abrir_argumento(indice: int, modo: int): own Arquivo {
    unsafe {
        let tamanho: int = argumento_tamanho(indice);
        if (tamanho < 0 || tamanho > 16384) { return arquivo_abrir("", 9); }
        let caminho: *byte = alloc<byte>(tamanho + 1); defer free(caminho);
        if (argumento_copiar(indice, caminho, tamanho + 1) < 0) { return arquivo_abrir("", 9); }
        return arquivo_abrir(text(caminho), modo);
    }
}

safe assis numero_csv(borrow linha: *byte, tamanho: int): Result<int, int> {
    if (tamanho <= 0 || tamanho > len(linha)) { return new Result<int, int>.Err(2); }
    let inicio: int = 0; let fim: int = tamanho;
    if (linha[0] == 34) {
        if (tamanho < 3 || linha[tamanho - 1] != 34) { return new Result<int, int>.Err(2); }
        inicio += 1; fim -= 1;
    }
    let negativo: bool = false;
    if (linha[inicio] == 45) { negativo = true; inicio += 1; }
    if (inicio == fim) { return new Result<int, int>.Err(2); }
    let valor: int = 0; let ultimo: int = 7;
    if (negativo) { ultimo = 8; }
    while (inicio < fim) {
        let digito: int = int(linha[inicio]) - 48;
        if (digito < 0 || digito > 9) { return new Result<int, int>.Err(2); }
        if (valor < -922337203685477580 || (valor == -922337203685477580 && digito > ultimo)) { return new Result<int, int>.Err(3); }
        valor = valor * 10 - digito; inicio += 1;
    }
    if (!negativo) { valor = -valor; }
    return new Result<int, int>.Ok(valor);
}

pure assis somar_csv(resumo: ResumoCsv, valor: int): Result<ResumoCsv, int> {
    if ((valor > 0 && resumo.total > 9223372036854775807 - valor) ||
        (valor < 0 && resumo.total < -9223372036854775808 - valor) || resumo.registros == 9223372036854775807) {
        return new Result<ResumoCsv, int>.Err(3);
    }
    return new Result<ResumoCsv, int>.Ok(new ResumoCsv(resumo.registros + 1, resumo.total + valor));
}

safe assis processar_linha(borrow linha: *byte, tamanho: int, resumo: ResumoCsv): Result<ResumoCsv, int> {
    match (numero_csv(linha, tamanho)) {
        Err(codigo) { return new Result<ResumoCsv, int>.Err(codigo); }
        Ok(valor) { return somar_csv(resumo, valor); }
    }
}

safe assis assis_assis(): int {
    if (argumentos() != 3) { print("Uso: relatorio entrada.csv saida.csv"); return 64; }
    own entrada: Arquivo = abrir_argumento(1, 0);
    if (entrada == null) { print("Erro ao abrir entrada", erro_io()); return 1; }
    own bloco: *byte = alloc<byte>(65536);
    val capacidade: int = len(bloco);
    own linha: *byte = alloc<byte>(24);
    let tamanho: int = 0; let cabecalho: bool = true; let linha_cr: bool = false;
    let resumo: ResumoCsv = new ResumoCsv(0, 0);
    while (true) {
        let lidos: int = arquivo_ler(entrada, bloco, capacidade);
        if (lidos < 0) { print("Erro de leitura", -lidos); return 1; }
        if (lidos == 0) { break; }
        for (let i: int = 0; i < lidos; i += 1) {
            let b: byte = bloco[i];
            if (b == 10) {
                if (linha_cr) { tamanho -= 1; }
                if (cabecalho) {
                    if (tamanho != 5 || linha[0] != 118 || linha[1] != 97 || linha[2] != 108 || linha[3] != 111 || linha[4] != 114) { print("Cabecalho deve ser valor"); return 2; }
                    cabecalho = false;
                } else {
                    match (processar_linha(linha, tamanho, resumo)) {
                        Ok(novo) { resumo = novo; }
                        Err(codigo) { print("CSV invalido na linha", resumo.registros + 2); return codigo; }
                    }
                }
                tamanho = 0; linha_cr = false;
            } else {
                if (tamanho == len(linha) || linha_cr) { print("Linha invalida ou muito longa"); return 2; }
                linha[tamanho] = b; tamanho += 1; linha_cr = b == 13;
            }
        }
    }
    if (linha_cr || cabecalho) { print("Cabecalho ou final de linha invalido"); return 2; }
    if (tamanho > 0) {
        match (processar_linha(linha, tamanho, resumo)) {
            Ok(novo) { resumo = novo; }
            Err(codigo) { print("CSV invalido na ultima linha"); return codigo; }
        }
    }
    if (arquivo_fechar(entrada) < 0) { print("Erro ao fechar entrada", erro_io()); return 1; }
    own saida: Arquivo = abrir_argumento(2, 1);
    if (saida == null) { print("Erro ao abrir saida", erro_io()); return 1; }
    own buffer: *byte = alloc<byte>(64);
    // Cabeçalho "registros,total\n", seguido por uma linha de resultados.
    buffer[0]=byte(114);buffer[1]=byte(101);buffer[2]=byte(103);buffer[3]=byte(105);buffer[4]=byte(115);buffer[5]=byte(116);buffer[6]=byte(114);buffer[7]=byte(111);buffer[8]=byte(115);buffer[9]=byte(44);buffer[10]=byte(116);buffer[11]=byte(111);buffer[12]=byte(116);buffer[13]=byte(97);buffer[14]=byte(108);buffer[15]=byte(10);
    own decimal: *byte = alloc<byte>(20);
    let usados: int = 16; let n: int = formatar_int_buffer(resumo.registros, decimal);
    for (let i: int = 0; i < n; i += 1) { buffer[usados] = decimal[i]; usados += 1; }
    buffer[usados] = byte(44); usados += 1;
    n = formatar_int_buffer(resumo.total, decimal);
    for (let i: int = 0; i < n; i += 1) { buffer[usados] = decimal[i]; usados += 1; }
    buffer[usados] = byte(10); usados += 1;
    // Escritas podem ser curtas; o bloco restante é compactado no mesmo buffer.
    while (usados > 0) {
        let gravados: int = arquivo_escrever(saida, buffer, usados);
        if (gravados <= 0) { print("Erro de escrita", erro_io()); return 1; }
        for (let i: int = gravados; i < usados; i += 1) { buffer[i - gravados] = buffer[i]; }
        usados -= gravados;
    }
    if (arquivo_fechar(saida) < 0) { print("Erro ao fechar saida", erro_io()); return 1; }
    print("Registros", resumo.registros, "total", resumo.total);
    return 0;
}
