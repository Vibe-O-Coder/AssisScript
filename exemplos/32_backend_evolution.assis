// Inspect with: assis ir exemplos/32_backend_evolution.assis
// Compare execution with: assis run ... --no-opt
pure fn twice(value: int): int { return value * 2; }

safe fn main(): int {
    own values: Array<int> = [1, 2, 3, 4, 5];
    let sum: int = 0;
    for (let index: int = 1; index < len(values) - 1; index += 1) {
        sum += values[index - 1] + values[index + 1];
    }
    let reverse: int = 0;
    for (let index: int = len(values) - 1; index >= 0; index -= 1) {
        reverse += twice(values[index]);
    }
    assert(reverse == 30);
    print(sum);
    return 0;
}
