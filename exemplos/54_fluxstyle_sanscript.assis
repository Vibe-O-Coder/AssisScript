import "std/sanscript.assis";

/// Local, pure presentation pipeline. No remote page or visual conformity claim.
safe fn main():int{
    own store:documents::Store=try_new documents::Store(1000000,1000,100);
    own fs:fluxstyle::Program=try_new fluxstyle::Program(utf8("flow Card {input expanded:bool=state(\"expanded\",false); choose(expanded,-8px,0px)->target.offsetY;} bind .card to Card;"),1000000);
    own ssc:sanscript::Program=try_new sanscript::Program(utf8("motion Card {spring(target:fs.target.offsetY,frequency:4Hz,dampingRatio:0.8)->presentation.offsetY;} bind .card to Card;"),1000000);
    own input:fluxstyle::Inputs=try_new fluxstyle::Inputs(2048);own style:fluxstyle::Style=try_new fluxstyle::Style();
    if(store==null || fs==null || ssc==null || input==null || style==null || !fs.is_open() || !ssc.is_open() || !input.is_ready() || !style.is_ready()){return 2;}
    assert(htdl::load_catalog(store,1,utf8("<div type=document version=\"0.1\" lang=en><div type=head><div type=title>Presentation</div></div><div type=body><div type=container id=card class=card></div></div></div>")).code==0);
    val node:doctree::NodeId=htdl::find_id(store.active_document().nodes(),utf8("card"));
    assert(fs.evaluate(store.active_document(),node,input,1,style).code==0);
    own motion:sanscript::Motion=ssc.attach(store.active_document(),node,style);
    if(motion==null || !motion.is_open()){return 2;}
    assert(input.set(fs.input_index(fs.flow_index(utf8("Card")),utf8("expanded")),1,1));
    assert(fs.evaluate(store.active_document(),node,input,2,style).code==0 && motion.update(store.active_document(),style)==0);
    print("FLOW-TARGET",style.value(15));
    for(let i:int=0;i<120;i++){
        let elapsed:int=8;if(i%3==0){elapsed=9;}
        assert(motion.advance(store.active_document(),elapsed,true,true,false,false)==0);
    }
    assert(motion.at(2).value== -8*65536 && motion.asleep());
    print("SSC-REST",motion.at(2).value,motion.asleep());motion.close();return 0;
}
