import "std/cli.assis";

safe fn main(): int {
    own input: cli::Stdin = new cli::Stdin(256);
    print("Nome, quantidade, preço unitário e confirmação, um valor por linha.");
    val name: parse::Parsed<int> = input.readln();
    if (!name.ok) { print("Nome inválido", name.code, name.position); return 1; }
    own customer: unicode::String = new unicode::String();
    if (!parse::parse_string(input.line(), customer)) { return 1; }

    val quantity: parse::Parsed<int> = input.readint();
    if (!quantity.ok || quantity.value < 0) {
        print("Quantidade inválida", quantity.code, quantity.position);
        return 1;
    }

    val price: parse::Parsed<f64> = input.readfloat();
    if (!price.ok || price.value < 0.0) {
        print("Preço inválido", price.code, price.position);
        return 1;
    }

    val confirmed: parse::Parsed<bool> = input.readbool();
    if (!confirmed.ok) { print("Confirmação inválida", confirmed.code, confirmed.position); return 1; }
    if (!confirmed.value) { print("Pedido cancelado"); return 0; }

    own total: unicode::String = new unicode::String();
    if (!total.append_decimal(f64(quantity.value) * price.value, 2)) {
        print("Total fora do intervalo do exemplo");
        return 1;
    }
    print(customer.as_slice(), quantity.value, total.as_slice());
    return 0;
}
