import "std/algorithms.assis";
struct Relatorio {
    own valores: Array<int>;
    let total: int;
}

pure fn dobro(n: int): int { return n * 2; }
pure fn par(n: int): bool { return n % 2 == 0; }
pure fn somar(a: int, b: int): int { return a + b; }

safe fn resumir(borrow entrada: Array<int>): own Relatorio {
    own filtrados: Array<int> = filter_own::<int>(entrada, par);
    own valores: Array<int> = map_own::<int, int>(filtrados, dobro);
    val total: int = fold_borrow::<int, int>(valores, 0, somar);
    return new Relatorio(move(valores), total);
}

safe fn ver_valores(borrow r: Relatorio): borrow(r) Array<int> {
    return r.valores;
}

safe fn main(): int {
    own entrada: Array<int> = [1, 2, 3, 4, 5, 6];
    own relatorio: Relatorio = resumir(entrada);
    {
        borrow valores: Array<int> = ver_valores(relatorio);
        print(len(entrada), len(valores), relatorio.total);
    }
    own extraidos: Array<int> = move(relatorio.valores);
    print(extraidos[0], extraidos[1], extraidos[2]);
    // O campo movido fica vazio; ambos os proprietários são limpos na saída.
    return 0;
}
