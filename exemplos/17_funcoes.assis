import "std/algorithms.assis";
pure fn dobro(v: int): int { return v * 2; }
pure fn par(v: int): bool { return v % 2 == 0; }
pure fn somar(a: int, v: int): int { return a + v; }
pure fn identidade<T>(v: T): T { return v; }

pure fn compor(f: pure fn(int): int, g: pure fn(int): int, v: int): int {
    return f(g(v));
}

pure fn escolher(): pure fn(int): int { return dobro; }

safe fn main(): int {
    unsafe {
    val f: pure fn(int): int = identidade::<int>;
    print(compor(escolher(), f, 21));
    let entrada: Array<int> = [1, 2, 3, 4];
    defer free(entrada);
    let pares: Array<int> = filter::<int>(entrada, par);
    defer free(pares);
    let dobrados: Array<int> = map::<int, int>(pares, dobro);
    defer free(dobrados);
    print(fold::<int, int>(dobrados, 0, somar));
    return 0;

    }
}
