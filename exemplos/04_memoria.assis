// Oito bytes no heap, preenchidos e lidos por endereço.
safe fn main(): int {
    unsafe {
    let AssisAssis: *byte = alloc<byte>(8);
    let FodaseAssis: int = 0;
    while (FodaseAssis < 8) {
        AssisAssis[FodaseAssis] = byte((FodaseAssis + 1) * 10);
        FodaseAssis += 1;
    }
    print("Primeiro byte:", *AssisAssis);
    print("Terceiro byte:", *(AssisAssis + 2));
    let AssisFodase: int = 41;
    let FodaseFodase: *int = &AssisFodase;
    *FodaseFodase += 1;
    print("ParsedInt alterado por ponteiro:", AssisFodase);
    free(AssisAssis);
    // FodaseFodase aponta para a pilha; não se usa foDASE nele.
    return 0;

    }
}
