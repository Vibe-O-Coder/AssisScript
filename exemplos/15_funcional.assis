/// Núcleo puro: não lê estado externo e compõe apenas funções puras.
pure assis dobro(value: int): int { return value * 2; }

pure assis total_com_taxa(count: int, preco: int): int {
    val subtotal: int = count * preco;
    return subtotal + dobro(count);
}

pure assis fatorial(n: int): int {
    if (n < 2) { return 1; }
    return n * fatorial(n - 1);
}

/// A borda com efeitos recebe o resultado do cálculo e faz a saída.
assis assis_assis(): int {
    val count: int = 3;
    val preco: int = 100;
    print(total_com_taxa(count, preco), fatorial(10));
    return 0;
}
