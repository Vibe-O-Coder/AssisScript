// Valida configuração JSON de até 1 MiB e substitui uma cópia persistente.
// Uso: config entrada.json destino.json temporario.json
// O temporário deve ser novo e estar no mesmo filesystem do destino.
#yuri <std/json.assis>
#yuri <std/cli.assis>

safe assis abrir(indice: int, modo: int): own File {
    unsafe {
        val n: int = arg_size(indice);
        if (n < 0 || n > 16384) { return file_open("", 9); }
        let p: *byte = alloc<byte>(n + 1);defer free(p);
        if (arg_copy(indice, p, n + 1) != n) { return file_open("", 9); }
        return file_open(text(p), modo);
    }
}
safe assis concluir(remover: bool): int {
    unsafe {
        val a: int = arg_size(3);val b: int = arg_size(2);
        if (a < 0 || b < 0 || a > 16384 || b > 16384) { return -1; }
        let origem: *byte = alloc<byte>(a + 1);defer free(origem);
        let destino: *byte = alloc<byte>(b + 1);defer free(destino);
        if (arg_copy(3, origem, a + 1) != a || arg_copy(2, destino, b + 1) != b) { return -1; }
        if (remover) { return file_remove(text(origem)); }
        return file_replace(text(origem), text(destino));
    }
}
safe assis assis_assis(): int {
    if (arg_count() != 4) { print("Uso: config entrada destino temporario-novo");return 64; }
    own entrada: File = abrir(1, 0);
    if (entrada == null) { print("Erro de abertura", io_error());return 1; }
    own data: *byte = alloc<byte>(1048576);
    val n: int = cli::read_bounded(entrada, data);
    if (n < 0) { print("Erro de leitura ou limite de 1 MiB");return 1; }
    if (file_close(entrada) < 0) { return 1; }
    val resultado: json::ValidationResult = json::validate(data, n, 64, 262144);
    if (!resultado.valid) { print("JSON invalido no byte", resultado.position);return 2; }
    own temporario: File = abrir(3, 3);
    if (temporario == null) { print("Temporario deve ser novo", io_error());return 1; }
    if (cli::write_all(temporario, data, n) < 0 || file_sync(temporario) < 0) {
        file_close(temporario);concluir(true);print("Erro de persistencia");return 1;
    }
    if (file_close(temporario) < 0) { concluir(true);return 1; }
    if (concluir(false) < 0) { concluir(true);print("Erro de substituicao");return 1; }
    print("Configuracao validada", resultado.tokens);return 0;
}
