// Fibonacci recursivo com retorno em todos os caminhos.
fn fibonacci(AssisAssis: int): int {
    if (AssisAssis <= 1) {
        return AssisAssis;
    } else {
        return fibonacci(AssisAssis - 1) + fibonacci(AssisAssis - 2);
    }
}

safe fn main(): int {
    unsafe {
    let AssisFodase: int = 0;
    while (AssisFodase < 11) {
        print("fib", AssisFodase, "=", fibonacci(AssisFodase));
        AssisFodase += 1;
    }
    return 0;

    }
}
