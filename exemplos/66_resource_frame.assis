import "resource-demo/inputs.assis";
safe fn argument(index:int):own *byte{unsafe{
    val length:int=arg_size(index);if(length<1 || length>4096){return try_alloc<byte>(0);}
    own data:*byte=try_alloc<byte>(length+1);if(data==null){return move(data);}
    if(arg_copy(index,data,length+1)!=length){return try_alloc<byte>(0);}return move(data);
}}
safe fn metric(borrow content:slice<byte>,size:int,weight:int):int{return (pageframe::pixels(size)<<32)+len(content)*pageframe::pixels(size)/2;}
safe fn main():int{
    own compiler:*byte=argument(1);own worker:*byte=argument(2);if(compiler==null || worker==null || len(compiler)<2 || len(worker)<2){return 2;}
    own bundle:pageresources::Batch=resource_demo::load();if(bundle==null || !bundle.complete()){return 6;}
    own s:frameworker::Session=try_new frameworker::Session(32000000,250000,7,19,23);if(s==null || !s.is_open()){return 4;}
    if(s.prepare_bundle(move(bundle),slice_of(compiler,0,len(compiler)-1),slice_of(worker,0,len(worker)-1),false,128,3,true,640,420,65536,
        reader::default_preferences(),metric,new frameworker::Limits(0,16,100000,1000,5000),new frameworker::Grants(true,false),monotonic_ms())!=0){return 5;}
    val deadline:int=monotonic_ms()+10000;while(!s.ready() && monotonic_ms()<deadline){if(s.advance(monotonic_ms())<0){return 5;}sleep_ms(1);}
    if(!s.ready() || !s.commit()){return 5;}
    while(monotonic_ms()<deadline){
        if(s.advance(monotonic_ms())<0){return 5;}
        if(s.result().code==2){print("RESOURCE FRAME",s.resources().size(),s.result().result,s.document_id());s.close();return 0;}sleep_ms(1);
    }return 5;
}
