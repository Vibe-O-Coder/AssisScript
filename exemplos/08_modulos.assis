import "std/math";
import "std/strings";
import "std/memory";
import "bibliotecas/operacoes.assis";

/*
    Programa distribuído entre vários arquivos.
    Todas as bibliotecas entram no executável durante a compilação.
*/
safe fn main(): int {
    unsafe {
    let AssisAssis: Assis_Fodase = new Assis_Fodase(21);
    print(AssisAssis.double());
    print(legacy_clamp(99, 0, 10));
    print(legacy_starts_with("AssisScript", "Assis"));
    let AssisFodase: *byte = alloc<byte>(4);
    legacy_fill(AssisFodase, 4, byte(65));
    print(AssisFodase[3]);
    free(AssisFodase);
    free(AssisAssis);
    return 0;

    }
}
