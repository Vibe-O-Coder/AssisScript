/// Identidade escalar pura, especializada por tipo concreto.
pure fn identity<T>(value: T): T { return value; }

struct Caixa<T> { let value: T; }
struct Par<A, B> { let primeiro: A; let segundo: B; }

safe fn main(): int {
    unsafe {
    own numero: Caixa<int> = new Caixa<int>(identity::<int>(42));
    own mensagem: Caixa<text> = new Caixa<text>("Assis");
    own is_even: Par<byte, bool> = new Par<byte, bool>(identity::<byte>(byte(7)), true);
    print(numero.value, mensagem.value, is_even.primeiro, is_even.segundo);
    return 0;

    }
}
