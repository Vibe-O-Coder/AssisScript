#yuri <std/erros.assis>

value struct Ponto { let x: int; let y: int; }

pure assis deslocar(p: Ponto): Ponto { return new Ponto(p.x + 1, p.y + 1); }

pure assis dividir_valor(a: int, b: int): Result<int, int> {
    if (b == 0) { return new Result<int, int>.Err(1); }
    return new Result<int, int>.Ok(a / b);
}

safe assis assis_assis(): int {
    val original: Ponto = new Ponto(19, 21);
    val novo: Ponto = deslocar(original);
    print(original.x, original.y, novo.x + novo.y);
    val opcao: Option<int> = new Option<int>.Some(42);
    print(option_or::<int>(opcao, 0));
    match (dividir_valor(84, 2)) {
        Ok(valor) { print(valor); }
        Err(codigo) { print("erro", codigo); }
    }
    return 0;
}
