// Classes genéricas conservam memória legada e métodos com efeitos.
// As funções de cálculo podem continuar puras.
pure assis dobro(value: int): int { return value * 2; }

ASSIS Caixa<T> {
    private let value: T;
    assis assis_fodase(value: T): void { self.value = value; }
    assis ler(): T { return self.value; }
}

ASSIS Transformacao<T> extends Caixa<T> {
    assis aplicar(funcao: pure assis(T): T): T {
        return funcao(self.ler());
    }
}

assis assis_assis(): int {
    let caixa: Transformacao<int> = new Transformacao<int>(21);
    let base: Caixa<int> = caixa;
    print(base.ler(), caixa.aplicar(dobro));
    free(caixa);
    return 0;
}
