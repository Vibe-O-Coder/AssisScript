{
  "name": "AssisScript",
  "scopeName": "source.assis",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "string.quoted.double.assis",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.assis",
          "match": "\\\\(?:[nrt0\"\\\\]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
        }
      ]
    },
    {
      "name": "constant.character.assis",
      "match": "'(?:[^'\\\\\\r\\n]|\\\\(?:[nrt0'\\\\]|x[0-9a-fA-F]{2}))'"
    },
    {
      "name": "keyword.control.assis",
      "match": "\\b(?:extern|is|as|platform|c_callback|import|if|else|while|return|break|continue|extends|for|defer|match)\\b"
    },
    {
      "name": "storage.type.assis",
      "match": "\\b(?:closure|const|class|fn|let|val|pure|safe|unsafe|private|final|namespace|public|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|int|byte|bool|text|void|struct|value(?=\\s+struct\\b)|enum|File|slice|Array|HashMap|own|borrow|mut)\\b"
    },
    {
      "name": "support.function.assis",
      "match": "\\b(?:new|try_new|write|utf8|free|print|len|slice_of|alloc|try_alloc|assert|bytes|move|read_bytes|monotonic_ms|sleep_ms|civil_ms|write_bytes|file_sync|file_replace|file_remove|file_open|file_read|file_write|file_close|io_error|arg_count|arg_size|arg_copy)\\b"
    },
    {
      "name": "constant.language.assis",
      "match": "\\b(?:aSsIs|super|true|false|null|self)\\b"
    },
    {
      "name": "constant.numeric.assis",
      "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9][0-9_]*)?)\\b"
    },
    {
      "name": "entity.name.function.assis",
      "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?=\\s*\\()"
    },
    {
      "name": "keyword.operator.assis",
      "match": "[+*/%=!<>&|^~?:-]+"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.assis",
          "begin": "//",
          "end": "$"
        },
        {
          "include": "#blockComment"
        }
      ]
    },
    "blockComment": {
      "name": "comment.block.assis",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#blockComment"
        }
      ]
    }
  }
}
