{
  "scopeName": "text.htdl",
  "patterns": [
    { "name": "comment.block.htdl", "begin": "<!--", "end": "-->" },
    { "name": "entity.name.tag.htdl", "match": "</?div\\b|>" },
    { "name": "entity.other.attribute-name.htdl", "match": "[A-Za-z][A-Za-z0-9_:-]*(?=\\s*=)" },
    { "name": "string.quoted.double.htdl", "begin": "\"", "end": "\"" },
    { "name": "string.quoted.single.htdl", "begin": "'", "end": "'" },
    { "name": "constant.character.entity.htdl", "match": "&(?:amp|lt|gt|quot|apos|#[0-9]+|#x[0-9A-Fa-f]+);" }
  ]
}
