{
  "version": "3.3.0-alpha.15",
  "date": "28/10/2026",
  "scope": "Conclusão do plano de evolução das fases 0–6, incluindo a trilha funcional e as aplicações A/B/C. Não inclui construir o navegador, HTDL, estilos ou motor de busca.",
  "phases": [
    {
      "id": 0,
      "name": "Baseline e segurança",
      "weight": 15,
      "items": [
        {
          "id": "P0-BASE",
          "name": "Baseline, hashes e reconstrução local comparável",
          "status": "complete",
          "evidence": "HANDOFF-3.3-ALPHA.15.md",
          "notes": "Baseline alpha.14 e patch rastreado preservados; três runtimes regenerados em árvores limpas; compiladores Windows/Linux idênticos aos testados na alpha.15."
        },
        {
          "id": "P0-PRIV",
          "name": "Encapsulamento nominal e rejeições de B01 nos dois destinos",
          "status": "complete",
          "evidence": "CONTRATOS-E-SEGURANCA.md"
        },
        {
          "id": "P0-SAFE",
          "name": "Fronteira safe/unsafe obrigatória e garantias para text externo",
          "status": "complete",
          "evidence": "SAFE-DEFAULT.md",
          "notes": "Entrada safe por padrão; --legacy explícito. Chamadas legadas/text C externo exigem unsafe; assinaturas/recursos safe recusam text sem vida. Reentrada em inicializadores gerenciados rejeitada."
        },
        {
          "id": "P0-FLOW",
          "name": "Auditoria de aliases, fluxo, laços e empréstimos completos",
          "status": "complete",
          "evidence": "OWNERSHIP-FUNCOES.md",
          "notes": "Auditoria do modelo gerenciado suportado; bloqueios conservadores em laços/campos. Não abrange ponteiros legados."
        },
        {
          "id": "P0-CI",
          "name": "Matriz adversa contínua Windows/Linux e inventário técnico",
          "status": "complete",
          "evidence": "PROCEDENCIA.md",
          "notes": "29 suítes nativas locais Windows/Linux e inventário real dos três binários atualizados; CI remota alpha.13 não executada nesta sessão. Direitos de imagens ficam em P6-POLICY."
        }
      ]
    },
    {
      "id": 1,
      "name": "Tipos estruturados e especialização",
      "weight": 15,
      "items": [
        {
          "id": "P1-TYPES",
          "name": "Identidades, aplicações estruturadas e cache canônico limitado",
          "status": "complete",
          "evidence": "GENERICS.md"
        },
        {
          "id": "P1-FUN",
          "name": "Funções e structs genéricas por AST com validação concreta",
          "status": "complete",
          "evidence": "GENERICS.md"
        },
        {
          "id": "P1-CLASS",
          "name": "Classes genéricas, herança, métodos e privacidade nominal",
          "status": "complete",
          "evidence": "HANDOFF-3.3-ALPHA.4.md"
        },
        {
          "id": "P1-EFFECT",
          "name": "Tipos de função com efeitos, valores, callbacks e composição",
          "status": "complete",
          "evidence": "FUNCOES-E-EFEITOS.md"
        },
        {
          "id": "P1-COL",
          "name": "Corpos de Array/HashMap na especialização AST comum",
          "status": "complete",
          "evidence": "HANDOFF-3.3-ALPHA.5.md"
        }
      ]
    },
    {
      "id": 2,
      "name": "Ownership e dados funcionais",
      "weight": 20,
      "items": [
        {
          "id": "P2-LOCAL",
          "name": "Análise de fluxo e exclusividade para recursos da aplicação",
          "status": "complete",
          "evidence": "OWNERSHIP-FUNCOES.md",
          "notes": "Fluxo/exclusividade para buffers, coleções escalares/funções e structs gerenciadas; outros recursos continuam em P2-DROP."
        },
        {
          "id": "P2-LIFE",
          "name": "Consumo, empréstimos e vidas em assinaturas/retornos",
          "status": "complete",
          "evidence": "OWNERSHIP-FUNCOES.md",
          "notes": "Consumo e retornos com uma origem explícita; contratos também em generics/callbacks. Sem inferência ou união de vidas."
        },
        {
          "id": "P2-DROP",
          "name": "Campos proprietários, destruição composta e movimento parcial",
          "status": "complete",
          "evidence": "RECURSOS-E-FATIAS.md",
          "notes": "Structs/classes com campos own, receptor verificado, destruição dinâmica, movimentos parciais e lista proprietária limitada. Recursos externos requerem adaptadores; Array/HashMap legados não assumem elementos."
        },
        {
          "id": "P2-VALUE",
          "name": "Layout por valor, contratos Copy/Move e dados imutáveis",
          "status": "complete",
          "evidence": "VALORES-E-VARIANTES.md",
          "notes": "Copy inline imutável e Move explícito para recursos. Enums com payload own usam invólucro no heap e destruição por tag; registros Move inline não são suportados."
        },
        {
          "id": "P2-ADT",
          "name": "Variantes, Result/Option, matching e capturas verificadas",
          "status": "complete",
          "evidence": "CAPTURAS-E-VARIANTES-MOVE.md",
          "notes": "Enums Copy inline e Move próprios, matching exaustivo emprestado/consumidor; closures safe val/own/borrow com vidas lexicais e reduce_with. Sem Move inline, closures pure, captura borrow mut ou adaptação para ABI C."
        }
      ]
    },
    {
      "id": 3,
      "name": "Texto, números e aplicação CLI",
      "weight": 15,
      "items": [
        {
          "id": "P3-TEXT",
          "name": "Texto com comprimento/vidas, bytes e APIs Unicode",
          "status": "complete",
          "evidence": "BIBLIOTECA-unicode.md",
          "notes": "API nova unicode::String com UTF-8/NUL/comprimento, own em campos/listas e slices com vidas em parâmetros/retornos. text C e String global legado preservam contrato anterior; sem grafemas/normalização."
        },
        {
          "id": "P3-NUM",
          "name": "Inteiros de largura fixa e números de ponto flutuante",
          "status": "complete",
          "evidence": "NUMEROS.md",
          "notes": "Inteiros de largura fixa e f32/f64 nativos, layout/ABI/coleções, overflow/conversões e IEEE verificados; print real hexadecimal exato."
        },
        {
          "id": "P3-IO",
          "name": "Arquivos, caminhos e argumentos com aplicação A validada",
          "status": "complete",
          "evidence": "IO-E-APLICACAO-A.md",
          "notes": "Arquivos own, argumentos/caminhos Unicode e aplicação A em CSV numérico de uma coluna, com fluxo limitado, erros e permissões nos dois sistemas. Sem API geral de diretórios/JSON."
        },
        {
          "id": "P3-LIB",
          "name": "Bibliotecas CLI, JSON, tempo, logs e iteradores com recursos seguros",
          "status": "complete",
          "evidence": "BIBLIOTECAS.md",
          "notes": "CLI own, JSON UTF-8 com limites, tempo/logs e pipelines imutáveis entregues no escopo CLI. DOM/JSON incremental, CSV legado geral e APIs mais amplas permanecem evolução."
        },
        {
          "id": "P3-PKG",
          "name": "Namespaces e pacotes versionados com lockfile offline",
          "status": "complete",
          "evidence": "PACOTES-E-NAMESPACES.md",
          "notes": "Namespaces/visibilidade nominal, versões exatas, dependências transitivas vendorizadas e lockfile SHA-256 offline; sem registro/download."
        }
      ]
    },
    {
      "id": 4,
      "name": "Integração, rede e serviços",
      "weight": 15,
      "items": [
        {
          "id": "P4-FFI",
          "name": "ABI C/FFI com recursos e callbacks externos",
          "status": "complete",
          "evidence": "FFI-C.md",
          "notes": "ABI C escalar em Windows/Linux, callbacks síncronos, dependências explícitas e handles com drop. Agregados C por valor e callbacks em threads externas não são suportados."
        },
        {
          "id": "P4-EVENT",
          "name": "Event loop, temporizadores, cancelamento e efeitos explícitos",
          "status": "complete",
          "evidence": "EVENTOS-E-PERSISTENCIA.md",
          "notes": "Fila cooperativa limitada de uma thread, callbacks safe sem captura, relógios, prazos, IDs/cancelamento, reagendamento, parada e orçamento. Sem polling de descritores ou preempção."
        },
        {
          "id": "P4-NET",
          "name": "Rede, DNS e HTTP/TLS com limites e aplicação B",
          "status": "complete",
          "evidence": "BIBLIOTECA-net.md",
          "notes": "HTTP(S)/DNS assíncrono pelo cliente net, polling/cancelamento cooperativos, múltiplas requisições, limites e TLS com confiança isolada/certificado não confiado/hostname divergente. Aplicação B com cancelamento; dependência opcional libcurl nos dois sistemas, sem servidor HTTP ou resolvedor público."
        },
        {
          "id": "P4-STORE",
          "name": "Persistência, processos e IPC com aplicação C",
          "status": "complete",
          "evidence": "BIBLIOTECA-process.md",
          "notes": "Persistência, processos/pipes, supervisão de grupo/job, locks liberados pelo OS e serviço C com reinício/corrupção/erro de commit. Sem durabilidade por queda de energia."
        },
        {
          "id": "P4-SOAK",
          "name": "Concorrência definida e validação prolongada de 24 horas",
          "status": "complete",
          "evidence": "HANDOFF-3.3-ALPHA.15.md",
          "notes": "24 horas reais aprovadas em Windows e Linux/WSL2: quatro serviços por sistema, polling e intervalo de 1s; 342519/345056 rodadas, falhas HTTP e cancelamentos esperados, memória/handles controlados e recuperação dos oito contadores. Compiladores e fontes conferidos; carga declarada, sem alegação de throughput máximo."
        }
      ]
    },
    {
      "id": 5,
      "name": "Backend e depuração",
      "weight": 10,
      "items": [
        {
          "id": "P5-IR",
          "name": "Frontend separado e IR tipada com fluxo/efeitos",
          "status": "complete",
          "evidence": "BACKEND-IR-COMPLETA.md",
          "notes": "Emissão integral por valores e CFG tipados: endereços, memória, despacho, recursos, cleanup, retornos, TCO e escopos de depuração. AST descartada e emissores AST bloqueados antes de toda geração otimizada, inclusive --symbols. Referência --no-opt e 32 suítes Windows/Linux, GDB e reconstruções idênticas; sem SSA ou backend ARM64."
        },
        {
          "id": "P5-OPT",
          "name": "Otimizações comprovadas, TCO, intervalos e alocação de registradores",
          "status": "complete",
          "evidence": "BACKEND-ALPHA15.md",
          "notes": "Liveness global com ponto fixo/coloração e reutilização dos quatro registradores preservados, exclusão de locais endereçados, fallback limitado; intervalos em laços diretos/reversos com offsets e chamadas pure. Equivalência/adversos Windows/Linux e comparação com alpha.14; sem alegação de otimalidade do alocador."
        },
        {
          "id": "P5-ABI",
          "name": "ABI documentada e validada para interfaces e retornos compostos",
          "status": "complete",
          "evidence": "FFI-C.md",
          "notes": "LVS2 preservada e ABI C escalar pública delimitada, registradores mistos/pilha/retornos/callbacks validados contra biblioteca C independente; agregados C por valor são rejeitados."
        },
        {
          "id": "P5-DEBUG",
          "name": "ELF PIE, símbolos/linhas e depuração nativa",
          "status": "complete",
          "evidence": "RECURSOS-E-FATIAS.md",
          "notes": "ELF ET_DYN/PIE, RIP/vtables relativos, símbolos/DWARF e GDB com parâmetros/locais escalares e escopos. Windows conserva mapas; sem PDB ou descrição de compostos."
        },
        {
          "id": "P5-TARGET",
          "name": "Backend extensível e novos alvos ARM64/macOS validados",
          "status": "pending",
          "evidence": "BACKEND-IR-CONTROL.md",
          "notes": "CI b7f9212 aprovada em macOS Intel e hosts Linux/macOS ARM64 com saídas x86_64 por QEMU/Rosetta. Geração/runtime ARM64 nativos e instalador/depuração dos novos destinos continuam abertos."
        }
      ]
    },
    {
      "id": 6,
      "name": "Ferramentas e oferta delimitada",
      "weight": 10,
      "items": [
        {
          "id": "P6-INSTALL",
          "name": "Instalação, atualização e remoção offline preservam dados",
          "status": "complete",
          "evidence": "HANDOFF-3.3-ALPHA.15.md",
          "notes": "Catálogo com 20 bibliotecas, 259 caminhos obrigatórios, instaladores/versão e lockfile sincronizados; perfis mínimo/completo e preservação de dados exercitados pelos harnesses."
        },
        {
          "id": "P6-TOOLS",
          "name": "Editor, documentação, fmt/test/doc e LSP independente",
          "status": "complete",
          "evidence": "FERRAMENTAS-ALPHA.8.md",
          "notes": "fmt/test/doc nativos, editor com namespaces/pacotes e LSP independente por stdio, sem dependências npm. Formatter cobre indentação, LF e espaços finais."
        },
        {
          "id": "P6-RELEASE",
          "name": "Pacotes coerentes e reconstrução local limpa reproduzível",
          "status": "complete",
          "evidence": "HANDOFF-3.3-ALPHA.15.md",
          "notes": "Reconstruções limpas com binários idênticos Windows/Linux; ZIP/VSIX e compiladores extraídos verificados na alpha.15. Entrega local, sem tag ou publicação remota."
        },
        {
          "id": "P6-POLICY",
          "name": "Licença/procedência resolvidas e política de suporte/compatibilidade",
          "status": "partial",
          "evidence": "PROCEDENCIA.md",
          "notes": "Licença escolhida pelo responsável e avisos publicados; inventário técnico de ligação concluído na alpha.12. Direitos de imagens e revisão dos termos/fontes de redistribuição continuam abertos."
        },
        {
          "id": "P6-ACCEPT",
          "name": "Terceiro instala, depura e distribui aplicações A/B/C pelo manual",
          "status": "complete",
          "evidence": "ACEITE-RELATO-USUARIO-2026-10-28.md",
          "notes": "Confirmação humana encaminhada pelo responsável: pessoa distinta usou a versão mais recente disponível, seguiu o manual, testou comandos/exemplos, escreveu programa com IntelliSense e confirmou depuração/distribuição de A/B/C. Sistema e hash exato não informados. Aceite da distribuição disponível na ocasião, separado da validação automatizada do novo candidato P5-IR."
        }
      ]
    }
  ],
