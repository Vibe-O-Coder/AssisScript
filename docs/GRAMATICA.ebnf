(* AssisScript 3.3.0-alpha.14: sintaxe canônica; edição histórica separada. *)
programa = { diretiva | "namespace", nome, ";" | ["public"], (constante | classe | registro | variante | funcao | externo | plataforma) } ;
diretiva = "import", texto, ";" ;
constante = "const", nome, ":", tipo, "=", expressao_constante, ";" ;
expressao_constante = expressao ; (* somente literais/constantes e operadores escalares *)
classe = ["final"], "class", nome, [parametros_tipo], ["extends", nome, [argumentos_tipo]], "{", { campo | metodo }, "}" ;
registro = ["value"], "struct", nome, [parametros_tipo], "{", { campo }, "}" ;
variante = "enum", nome, [parametros_tipo], "{", caso, {caso}, "}" ;
caso = nome, ["(", [payload, {",", payload}], ")"], ";" ;
payload = ["own"], tipo ;
campo = ["private"], ("let" | "own"), nome, ":", tipo, ";" ;
funcao = ["pure" | "safe"], "fn", nome, [parametros_tipo], "(", [parametros], ")", ":", retorno, bloco ;
metodo = ["private"], "fn", nome, "(", [receptor, [",", parametros] | parametros], ")", ":", retorno, bloco ;
receptor = "borrow", ["mut"], "self" ;
modo = "own" | "borrow", ["mut"] ;
parametro = [modo], nome, ":", tipo ;
parametros = parametro, {",", parametro} ;
retorno = ["own" | "borrow", ["mut"], "(", (nome | "self"), ")"], tipo ;
parametros_tipo = "<", nome, {",", nome}, ">" ;
argumentos_tipo = "<", tipo, {",", tipo}, ">" ;
tipo = {"*"}, ("int" | "byte" | "i8" | "i16" | "i32" | "i64" | "u8" | "u16" | "u32" | "u64" | "f32" | "f64" | "bool" | "text" | "void" | "File" | "slice", "<", tipo, ">" | nome, [argumentos_tipo] | tipo_funcao | tipo_closure) ;
tipo_argumento = [modo], tipo ;
tipo_funcao = ["pure" | "safe"], "fn", "(", [tipo_argumento, {",", tipo_argumento}], ")", ":", ["own" | "borrow", ["mut"], "(", inteiro, ")"], tipo ;
tipo_closure = "closure", ["mut"], "(", [tipo_argumento, {",", tipo_argumento}], ")", ":", ["own" | "borrow", ["mut"], "(", (inteiro | "self"), ")"], tipo ;
closure = "closure", ["mut"], "[", [captura, {",", captura}], "]", "(", [parametros], ")", ":", retorno, bloco ;
captura = ("val" | "own" | "borrow"), nome, ":", tipo, "=", expressao ;
bloco = "{", {instrucao}, "}" ;
instrucao = bloco | ("let" | "val"), nome, ":", tipo, "=", expressao, ";"
          | "unsafe", bloco
          | ("own" | "borrow", ["mut"]), nome, ":", tipo, "=", expressao, ";"
          | "defer", "free", "(", nome, ")", ";"
          | "for", "(", inicializacao, expressao, ";", (atribuicao | incremento), ")", bloco
          | "if", "(", expressao, ")", bloco, ["else", (bloco | condicional)]
          | "while", "(", expressao, ")", bloco
          | "match", "(", expressao, ")", "{", {braco}, "}"
          | "return", [expressao], ";"
          | ("print" | "write"), argumentos, ";" | "free", "(", expressao, ")", ";"
          | "assert", "(", expressao, [",", expressao], ")", ";"
          | ("break" | "continue"), ";"
          | incremento, ";"
          | expressao, [operador_atribuicao, expressao], ";" ;
expressao = unaria, {operador_binario, unaria | ("is" | "as"), tipo} ; (* precedência descrita no manual *)
unaria = ["+" | "-" | "!" | "~" | "*" | "&"], primaria,
         {".", nome | argumentos | "[", expressao, "]" | "::", argumentos_tipo} ;
primaria = closure | caractere | inteiro | real_decimal | texto | "true" | "false" | "null" | "self" | "super" | nome
         | "(", expressao, ")" | "new", tipo, [".", nome], argumentos
         | "alloc", "<", tipo, ">", argumentos
         | ("utf8" | "len" | "slice_of" | "int" | "byte" | "i8" | "i16" | "i32" | "i64" | "u8" | "u16" | "u32" | "u64" | "f32" | "f64" | "bool" | "text" | "bytes" | "move" | "read_bytes" | "monotonic_ms"
            | "file_open" | "file_read" | "file_write" | "file_close" | "io_error"
            | "arg_count" | "arg_size" | "arg_copy" | "sleep_ms" | "civil_ms" | "write_bytes"
            | "file_sync" | "file_replace" | "file_remove"), argumentos
         | "[", [expressao, {",", expressao}, [","]], "]" ;
argumentos = "(", [expressao, {",", expressao}], ")" ;
braco = nome, ["(", [nome, {",", nome}], ")"], bloco ;
inicializacao = ("let" | "val" | "own" | "borrow", ["mut"]), nome, ":", tipo, "=", expressao, ";"
              | atribuicao, ";" | incremento, ";" | expressao, ";" ;
atribuicao = expressao, operador_atribuicao, expressao ;
incremento = ("++" | "--"), expressao | expressao, ("++" | "--") ;
(* Exige destino numérico gravável; é instrução sem valor, inclusive no for. *)
nome = (letra_ASCII | "_"), {letra_ASCII | digito | "_"} ;
(* Módulos agregadores também usam import. void só é retorno, não elemento/ponteiro.
   Funções globais, structs e classes admitem parâmetros de tipo; chamadas genéricas
   exigem ::<...>. Métodos usam parâmetros da classe; parâmetros de tipo próprios não são suportados.
   Array<T>/HashMap<K,V> continuam intrínsecos. Prefixo __assis_ é reservado.
   Literais de array exigem contexto Array<T>. Struct sem value usa referência nominal.
   value struct e enum Copy exigem valores Copy; payload own torna enum Move alocado.
   val: locais escalares/text/função/valores Copy; sem reatribuição ou endereço.
   pure: funções globais; escalares, funções pure e valores Copy; chamadas só pure.
   match é exaustivo; Copy copia, Move empresta ou consome com match(move(dono)).
   File é opaco, own/borrow e sem construção new; abertura é anulável.
   private: acesso somente pela classe declaradora; não concede acesso por arquivo.
   mut acompanha borrow ou closure; captura borrow mut permanece rejeitada. *)

(* Nomes de tipos/funções podem ser qualificados: nome, {"::", nome}.
   Isso é distinto de ::<argumentos_tipo>. Literais reais decimais têm ponto e/ou expoente e tipo f64.
   Novos tipos numéricos também são conversões explícitas na posição de chamada. *)

externo = "extern", "(", texto, ",", texto, ",", texto, ")", "fn", nome, "(", [parametros], ")", ":", tipo, ";" ;
plataforma = "platform", "(", ('"linux-x64"' | '"windows-x64"' | '"macos-x64"'), ")", "{", { ["public"], (classe | registro | variante | funcao | externo) }, "}" ;
(* c_callback(funcao_global) é builtin escalar unsafe; drop é método reservado em final class. *)

caractere = "'", (byte_fonte | escape_de_byte), "'" ; (* exatamente um byte *)
