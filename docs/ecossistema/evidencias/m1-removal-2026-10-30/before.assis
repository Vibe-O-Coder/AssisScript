extern("TEST_FIXTURE_PATH","TEST_FIXTURE_PATH","fault_enable") fn fault_enable():i32;import "BASELINE_ARENA_PATH";struct Item{let n:int;own data:*byte;}safe fn main():int{own a:arena::Arena<Item>=new arena::Arena<Item>(1,2,1,8);let h:arena::Handle=new arena::Handle();val s:arena::InsertStatus=a.try_insert(new Item(42,alloc<byte>(1)));match(s){Inserted(id){h=id;}Rejected(code){assert(false);}}unsafe{let keep:**byte=alloc<*byte>(8193);let n:int=0;assert(fault_enable()==i32(0));while(true){let p:*byte=try_alloc<byte>(1);if(p==null){break;}keep[n]=p;n++;assert(n<8193);}own result:arena::Removal<Item>=a.remove(h);for(let i:int=0;i<n;i++){free(keep[i]);}free(keep);}return 0;}