        if(!self.collect(tree,title)){return;}self.title_size=self.used;
        let node:doctree::NodeId=htdl::query(tree,0,utf8(""),new doctree::NodeId());
        while(!doctree::absent(node)){
            let kind:int=htdl::kind(tree,node);
            if(kind==21){
                val field:int=pageedit::kind(tree,node);
