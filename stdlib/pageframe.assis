            for(let j:int=i+1;j<self.count;j++){val q:int=j*46;if(self.data[q+3]!=i){continue;}
                if(self.data[p+11]==1){content=maximum(content,self.data[q+9]);}
                else{if(children>0){content+=self.data[p+12];}content+=self.data[q+9];}children++;}
