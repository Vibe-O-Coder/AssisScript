                if(self.data[q+14]!=0){clip=intersect(clip,new Rect(self.data[q+6]+self.data[q+10],self.data[q+7]+self.data[q+10],maximum(0,self.data[q+8]-2*self.data[q+10]-self.data[q+36]),maximum(0,self.data[q+9]-2*self.data[q+10])));}}
            self.data[p+31]=clip.x;self.data[p+32]=clip.y;self.data[p+33]=clip.width;self.data[p+34]=clip.height;
