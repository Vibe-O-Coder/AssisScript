    fn is_open(borrow self):bool{return self.active;}
    /// Compose exactly once on an unpublished candidate. Packet seals the Frame.
    /// Deltas propagate down the tree; flow sizes/scroll extent never change.
    fn compose(borrow mut self,borrow document:documents::Document,borrow motion:motionpage::Page):int{
        if(!self.current(document) || self.composed || self.sealed || !motion.ready(document) ||
           motion.candidate_style()!=self.style){return 204;}
        // Preflight every displacement before touching bounds, clips or runs.
        for(let i:int=0;i<self.count;i++){val p:int=i*46;val parent:int=self.data[p+3];
            val x:fluxstyle::Number=motion.value(document,self.node(i),1);val y:fluxstyle::Number=motion.value(document,self.node(i),2);
            if((x.code!=0 && x.code!=302) || (y.code!=0 && y.code!=302)){return 204;}
            let dx:int=0;let dy:int=0;if(x.code==0){dx=pixels(x.value)-self.data[p+21];}if(y.code==0){dy=pixels(y.value)-self.data[p+22];}
            if(parent>=0){dx+=self.data[parent*46+38];dy+=self.data[parent*46+39];}
            if(self.data[p+6]+dx< -16777216 || self.data[p+6]+dx>16777216 ||
               self.data[p+7]+dy< -16777216 || self.data[p+7]+dy>16777216){return 401;}
            self.data[p+38]=dx;self.data[p+39]=dy;
        }
        for(let i:int=0;i<self.count;i++){val p:int=i*46;val parent:int=self.data[p+3];
            val dx:int=self.data[p+38];val dy:int=self.data[p+39];self.data[p+6]+=dx;self.data[p+7]+=dy;
            let clip:Rect=self.viewport();if(parent>=0){clip=self.content_clip(parent);}
            self.data[p+31]=clip.x;self.data[p+32]=clip.y;self.data[p+33]=clip.width;self.data[p+34]=clip.height;
            for(let j:int=self.data[p+27];j<self.data[p+27]+self.data[p+28];j++){val run:Run=self.runs[j];
                self.runs[j]=new Run(i,run.start,run.size,new Rect(run.bounds.x+dx,run.bounds.y+dy,run.bounds.width,run.bounds.height));}
        }self.motion_revision=motion.candidate_version();self.composed=true;return 0;
    }
    fn seal(borrow mut self):void{self.sealed=true;}
    fn motion_version(borrow self):int{return self.motion_revision;}
    fn status(borrow self):int{return self.code;}
    fn diagnostic_node(borrow self):doctree::NodeId{return self.failed;}
    fn instance(borrow self):int{return self.instance_id;}
    fn semantic_version(borrow self):int{return self.semantic;}
    fn style_version(borrow self):int{return self.style;}
    fn version(borrow self):int{return self.revision;}
    fn size(borrow self):int{return self.count;}
    fn run_count(borrow self):int{return self.lines;}
    fn viewport(borrow self):Rect{return new Rect(0,0,self.width,self.height);}
    fn scroll_y(borrow self):int{return self.scroll;}
    fn max_scroll(borrow self):int{return maximum(0,self.extent-self.height);}
    fn box(borrow self,index:int):Box{
        assert(self.active && index>=0 && index<self.count);val p:int=index*46;
        return new Box(self.node(index),self.data[p+4],self.data[p+5]!=0,
            new Rect(self.data[p+6],self.data[p+7],self.data[p+8],self.data[p+9]),
            new Rect(self.data[p+31],self.data[p+32],self.data[p+33],self.data[p+34]),
            self.data[p+15],self.data[p+16],self.data[p+17],self.data[p+18],self.data[p+19]);
    }
    fn accessible_bounds(borrow self,index:int):Rect{val b:Box=self.box(index);return intersect(b.bounds,b.clip);}
    fn content_clip(borrow self,index:int):Rect{
        val b:Box=self.box(index);val p:int=index*46;if(self.data[p+14]==0){return b.clip;}
        return intersect(b.clip,new Rect(b.bounds.x+self.data[p+10],b.bounds.y+self.data[p+10],
            maximum(0,b.bounds.width-2*self.data[p+10]-self.data[p+36]),maximum(0,b.bounds.height-2*self.data[p+10])));
    }
    fn name(borrow self,index:int):borrow(self) slice<byte>{
        assert(self.active && index>=0 && index<self.count);return slice_of(self.content,self.data[index*46+29],self.data[index*46+30]);
    }
    fn run(borrow self,index:int):Run{assert(self.active && index>=0 && index<self.lines);return self.runs[index];}
    fn run_text(borrow self,index:int):borrow(self) slice<byte>{val r:Run=self.run(index);return slice_of(self.content,r.start,r.size);}
    fn title(borrow self):borrow(self) slice<byte>{assert(self.active);return slice_of(self.content,0,self.title_size);}
    /// A stale snapshot is never an authority for interaction with changed semantics.
    fn current(borrow self,borrow document:documents::Document):bool{
        return self.active && document.is_open() && document.instance()==self.instance_id && document.semantic_version()==self.semantic;
    }
    fn eligible(borrow self,borrow document:documents::Document,index:int):bool{
        if(!self.current(document) || index<0 || index>=self.count){return false;}
        val b:Box=self.box(index);return interactive(b.kind) && !b.disabled && document.nodes().contains(b.node);
    }
    fn checked(borrow self,node:doctree::NodeId):int{
        if(!self.active){return -1;}
        val index:int=self.find(node);
        if(index<0 || self.data[index*46+4]!=21){return -1;}
        return self.data[index*46+44];
    }
    fn checkbox_mark(borrow self,index:int):Rect{
        val b:Box=self.box(index);val p:int=index*46;val side:int=self.data[p+37];
        return new Rect(b.bounds.x+self.data[p+10]+3,b.bounds.y+self.data[p+10]+3,side,side);
    }
    fn edit_bounds(borrow self,index:int):Rect{
        val b:Box=self.box(index);
        val padding:int=self.data[index*46+10];
        return new Rect(b.bounds.x+padding+4,b.bounds.y+padding+4,
            maximum(0,b.bounds.width-2*padding-8),maximum(0,b.bounds.height-2*padding-8));
    }
    fn placeholder(borrow self,index:int):borrow(self) slice<byte>{
        val p:int=index*46;
        return slice_of(self.content,self.data[p+42],self.data[p+43]);
    }
    /// Copy state only within one document identity. Toggle before sealing.
    fn prepare_checks(borrow mut self,borrow document:documents::Document,borrow previous:Frame,toggle:doctree::NodeId):bool{
        if(!self.current(document) || !previous.current(document) || self.sealed || self.composed){return false;}
        if(!doctree::absent(toggle)){
            val index:int=self.find(toggle);
            if(!self.eligible(document,index) || self.data[index*46+4]!=21 || previous.checked(toggle)<0){return false;}
        }
        for(let i:int=0;i<self.count;i++){
            val p:int=i*46;if(self.data[p+4]!=21){continue;}
            val node:doctree::NodeId=self.node(i);val checked:int=previous.checked(node);
            if(checked>=0){self.data[p+44]=checked;}
            if(same(node,toggle)){self.data[p+44]=1-self.data[p+44];}
        }
        return true;
    }
    fn activation_target(borrow self,borrow document:documents::Document,node:doctree::NodeId):doctree::NodeId{
        let index:int=self.find(node);
        if(index>=0 && self.data[index*46+4]==20){index=self.data[index*46+45]-1;}
        if(!self.eligible(document,index)){return new doctree::NodeId();}
        return self.node(index);
    }
    fn form_of(borrow self,borrow document:documents::Document,node:doctree::NodeId):doctree::NodeId{
        if(!self.current(document) || !document.nodes().contains(node)){return new doctree::NodeId();}
        borrow tree:doctree::Tree=document.nodes();
        let ancestor:doctree::NodeId=tree.parent(node);
        while(!doctree::absent(ancestor) && htdl::kind(tree,ancestor)!=22){ancestor=tree.parent(ancestor);}
        return ancestor;
    }
    fn invalid_input(borrow self,borrow document:documents::Document,form:doctree::NodeId,
            borrow fields:pageedit::Fields):doctree::NodeId{
        if(!self.current(document) || htdl::kind(document.nodes(),form)!=22){return new doctree::NodeId();}
        borrow tree:doctree::Tree=document.nodes();
        let node:doctree::NodeId=htdl::first_element(tree,form);
        val end:doctree::NodeId=self.after(tree,form);
        while(!doctree::absent(node) && !same(node,end)){
            val kind:int=pageedit::kind(tree,node);
            if(kind>0 && !htdl::value_equals(tree,htdl::attribute(tree,node,8),utf8("true"))){
                val required:bool=htdl::value_equals(tree,htdl::attribute(tree,node,21),utf8("true"));
                if(kind==1 && required){
                    val checked:int=self.checked(node);
                    if(checked==0 || (checked<0 && !htdl::value_equals(tree,htdl::attribute(tree,node,22),utf8("true")))){return node;}
                }
                if(kind>1 && fields!=null && fields.has(node)){
                    borrow value:slice<byte>=fields.value(node);
                    if((required && len(value)==0) || (len(value)>0 && kind==3 && !pageedit::valid_number(value))){return node;}
                }
            }
            val child:doctree::NodeId=htdl::first_element(tree,node);
            if(doctree::absent(child)){node=self.after(tree,node);}
            else{node=child;}
        }
        return new doctree::NodeId();
    }
    fn hit(borrow self,borrow document:documents::Document,frame_version:int,x:int,y:int):doctree::NodeId{
        if(!self.current(document) || frame_version!=self.revision){return new doctree::NodeId();}
        for(let i:int=self.count-1;i>=0;i--){if(contains(self.accessible_bounds(i),x,y)){
            if(!doctree::absent(self.activation_target(document,self.node(i)))){return self.node(i);}return new doctree::NodeId();}}
        return new doctree::NodeId();
    }
    fn edit_hit(borrow self,borrow document:documents::Document,node:doctree::NodeId,x:int,y:int):bool{
        val index:int=self.find(node);
        return self.eligible(document,index) && editable(self.data[index*46+4]) && contains(self.accessible_bounds(index),x,y);
    }
    fn edit_point(borrow self,borrow fields:pageedit::Fields,node:doctree::NodeId,x:int,focused:bool,
            metric:safe fn(borrow slice<byte>,int,int):int):int{
        val index:int=self.find(node);if(index<0 || !fields.has(node)){return -1;}
        val box:Box=self.box(index);val area:Rect=self.edit_bounds(index);
        if(area.width<1){return -1;}
        borrow value:slice<byte>=fields.value(node);
        own boundaries:graphemes::Index=try_new graphemes::Index(value);
        if(boundaries==null || boundaries.status()!=0){return -1;}
        let point:int=x-area.x;
        if(focused){
            val measured:int=metric(slice_of(value,0,fields.selection(node).caret),box.text_size,box.weight);
            if(measured<0){return -1;}
            point+=maximum(0,measured%4294967296-area.width+1);
        }
        let at:int=0;let prior:int=0;
        while(at<len(value)){
            val next:int=boundaries.next(at);
            val measured:int=metric(slice_of(value,0,next),box.text_size,box.weight);
            if(measured<0){return -1;}
            val advance:int=measured%4294967296;
            if(advance<prior){return -1;}
            if(point<prior+(advance-prior)/2){return at;}
            prior=advance;at=next;
        }
        return at;
    }
    fn next_focus(borrow self,borrow document:documents::Document,previous:doctree::NodeId,backward:bool):doctree::NodeId{
        if(!self.current(document)){return new doctree::NodeId();}
        let at:int=self.find(previous);if(at<0 && backward){at=0;}
        for(let i:int=0;i<self.count;i++){
            if(backward){at--;}else{at++;}if(at<0){at=self.count-1;}if(at>=self.count){at=0;}
            if(self.eligible(document,at)){return self.node(at);}
        }return new doctree::NodeId();
    }
    fn marker(borrow self,index:int):borrow(self) slice<byte>{
        assert(self.active && index>=0 && index<self.count);val p:int=index*46;
        if(self.data[p+4]!=19){return slice_of(self.content,0,0);}
        return slice_of(self.content,self.data[p+42],self.data[p+43]);
    }
    fn marker_bounds(borrow self,index:int):Rect{
        val b:Box=self.box(index);val p:int=index*46;
        return new Rect(b.bounds.x+self.data[p+10],b.bounds.y+self.data[p+10],self.data[p+40],self.data[p+37]);
    }
    /// A fragment resolves only within this exact semantic snapshot. Inline IDs
    /// scroll to their containing block. Missing/hidden/stale targets fail closed.
    fn fragment_scroll(borrow self,borrow document:documents::Document,link:doctree::NodeId):int{
        if(!self.current(document) || !document.nodes().contains(link) || htdl::kind(document.nodes(),link)!=17 || self.find(link)<0){return -1;}
        borrow tree:doctree::Tree=document.nodes();val href:doctree::NodeId=htdl::attribute(tree,link,15);
        val size:int=htdl::value_size(tree,href);if(size<2 || size>257 || htdl::value_byte(tree,href,0)!=byte(35)){return -1;}
        own id:*byte=try_alloc<byte>(size-1);if(id==null){return -1;}
        for(let i:int=1;i<size;i++){id[i-1]=htdl::value_byte(tree,href,i);}
        let target:doctree::NodeId=htdl::find_id(tree,slice_of(id,0,size-1));
        if(doctree::absent(target) || self.hidden(tree,target)){return -1;}
        if(htdl::kind(tree,target)==7){target=tree.parent(target);}
        val index:int=self.find(target);if(index<0){return -1;}
        return minimum(self.max_scroll(),maximum(0,self.box(index).bounds.y+self.scroll));
    }
    fn close(borrow mut self):void{self.active=false;own data:*int=move(self.data);own content:*byte=move(self.content);own runs:*Run=move(self.runs);}
}
