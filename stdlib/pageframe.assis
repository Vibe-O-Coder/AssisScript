        val sample:int=metric(utf8("M"),self.data[p+18],self.data[p+19]);
        if(sample<0 || (sample>>32)<1 || (sample>>32)>1024){self.fail(304,self.node(index));return false;}
        val row:int=sample>>32;let y:int=0;
