                        if(sample<0 || (sample>>32)<1 || (sample>>32)>1024){self.fail(304,node);return;}
                        self.data[p+37]=(sample>>32)+8;
                        val hint:doctree::NodeId=htdl::attribute(tree,node,20);
                        self.data[p+42]=self.used;
                        if(!doctree::absent(hint)){
                            val size:int=htdl::value_size(tree,hint);
                            if(size>pageedit::byte_limit()){self.fail(401,node);return;}
                            for(let i:int=0;i<size;i++){if(!self.put(htdl::value_byte(tree,hint,i))){return;}}
                        }
