namespace pageframe;
import "std/flowpage.assis";
import "std/graphemes.assis";
import "std/motionpage.assis";
import "std/pageedit.assis";

public value struct Rect{let x:int;let y:int;let width:int;let height:int;}
public value struct Box{
    let node:doctree::NodeId;let kind:int;let disabled:bool;
    let bounds:Rect;let clip:Rect;let background:int;let foreground:int;let opacity:int;
    let text_size:int;let weight:int;
}
public value struct Run{let box:int;let start:int;let size:int;let bounds:Rect;}
public pure fn minimum(a:int,b:int):int{if(a<b){return a;}return b;}
public pure fn maximum(a:int,b:int):int{if(a>b){return a;}return b;}
public pure fn intersect(a:Rect,b:Rect):Rect{
    val x:int=maximum(a.x,b.x);val y:int=maximum(a.y,b.y);
    val width:int=maximum(0,minimum(a.x+a.width,b.x+b.width)-x);val height:int=maximum(0,minimum(a.y+a.height,b.y+b.height)-y);
    if(width==0 || height==0){return new Rect();}return new Rect(x,y,width,height);
}
public pure fn contains(a:Rect,x:int,y:int):bool{
    return x>=a.x && y>=a.y && x-a.x<a.width && y-a.y<a.height;
}
public pure fn pixels(q:int):int{return (q+32768)>>16;}
public pure fn same(a:doctree::NodeId,b:doctree::NodeId):bool{
    return a.instance==b.instance && a.slot==b.slot && a.generation==b.generation;
}
public pure fn editable(kind:int):bool{return kind==24 || kind==25;}
public pure fn interactive(kind:int):bool{return kind==9 || kind==17 || kind==21 || editable(kind);}
public pure fn structural(kind:int):bool{return kind==4 || kind==5 || (kind>=12 && kind<=16) || kind==18 || kind==19 || kind==22;}
/// Delimited reading catalog. Validate even hidden declarations: no resource or
/// event is silently ignored. The parser remains responsible for HTDL validity.
public safe fn reading_profile(borrow document:documents::Document):int{return local_profile(document,0);}
public safe fn forms_profile(borrow document:documents::Document):int{return local_profile(document,1);}
public safe fn editing_profile(borrow document:documents::Document):int{return local_profile(document,2);}
safe fn local_profile(borrow document:documents::Document,forms:int):int{
    if(!document.is_open() || !document.has_root()){return 204;}
    let reference_work:int=0;borrow tree:doctree::Tree=document.nodes();let n:doctree::NodeId=htdl::query(tree,0,utf8(""),new doctree::NodeId());
    while(!doctree::absent(n)){
        val k:int=htdl::kind(tree,n);
        if(k==11 || k>=23 || (forms==0 && k>=20)){return 203;}
        if(k==21 && forms<2 && pageedit::kind(tree,n)!=1){return 203;}
        if(k==20){
            reference_work+=document.source_size();
            if(reference_work>8000000 || htdl::value_size(tree,htdl::attribute(tree,n,17))>256){return 401;}
        }
        val live:doctree::NodeId=htdl::attribute(tree,n,24);
        if(!doctree::absent(live) && !htdl::value_equals(tree,live,utf8("off"))){return 203;}
        for(let key:int=25;key<=30;key++){if(!doctree::absent(htdl::attribute(tree,n,key))){return 203;}}
        if(k==17){reference_work+=document.source_size();if(reference_work>8000000){return 401;}val href:doctree::NodeId=htdl::attribute(tree,n,15);
            val size:int=htdl::value_size(tree,href);if(size<2 || size>257 || htdl::value_byte(tree,href,0)!=byte(35)){return 203;}
            own id:*byte=try_alloc<byte>(size-1);if(id==null){return 401;}
            for(let i:int=1;i<size;i++){id[i-1]=htdl::value_byte(tree,href,i);}
            if(doctree::absent(htdl::find_id(tree,slice_of(id,0,size-1)))){return 207;}
        }
        n=htdl::query(tree,0,utf8(""),n);
    }return 0;
}
/// Immutable local geometry, text and accessible names, independent of providers.
/// Construct a candidate and replace the previous owner only after is_open().
public final class Frame{
    // Words 40..43 hold list markers. Words 44..45 hold checked state and label target.
    private own data:*int;private own content:*byte;private own runs:*Run;
    private let count:int;private let used:int;private let lines:int;private let work:int;
    private let instance_id:int;private let semantic:int;private let style:int;private let revision:int;
    private let width:int;private let height:int;private let scroll:int;private let extent:int;
    private let title_size:int;
    private let code:int;private let failed:doctree::NodeId;private let active:bool;
    private let composed:bool;private let sealed:bool;private let motion_revision:int;
    private fn fail(borrow mut self,code:int,node:doctree::NodeId):void{
        if(self.code==0){self.code=code;self.failed=node;}
    }
    private fn node(borrow self,i:int):doctree::NodeId{
        return new doctree::NodeId(self.data[i*46],self.data[i*46+1],self.data[i*46+2]);
    }
    private fn find(borrow self,node:doctree::NodeId):int{
        for(let i:int=0;i<self.count;i++){if(same(self.node(i),node)){return i;}}return -1;
    }
    private fn put(borrow mut self,c:byte):bool{
        if(self.used==len(self.content)){self.fail(401,new doctree::NodeId());return false;}
        self.content[self.used]=c;self.used++;return true;
    }
    private fn property(borrow self,borrow page:flowpage::Page,borrow document:documents::Document,node:doctree::NodeId,key:int,fallback:int):int{
        if(page.has(document,node,key)){return page.value(document,node,key).value;}return fallback;
    }
    private fn hidden(borrow self,borrow tree:doctree::Tree,node:doctree::NodeId):bool{
        let n:doctree::NodeId=node;
        while(!doctree::absent(n)){
            if(htdl::value_equals(tree,htdl::attribute(tree,n,7),utf8("true"))){return true;}n=tree.parent(n);
        }return false;
    }
    private fn after(borrow self,borrow tree:doctree::Tree,node:doctree::NodeId):doctree::NodeId{
        let n:doctree::NodeId=node;while(!doctree::absent(n)){
            val sibling:doctree::NodeId=tree.next_sibling(n);if(!doctree::absent(sibling)){return sibling;}n=tree.parent(n);
        }return new doctree::NodeId();
    }
    private fn collect(borrow mut self,borrow tree:doctree::Tree,node:doctree::NodeId):bool{
        let n:doctree::NodeId=tree.first_child(node);val end:doctree::NodeId=self.after(tree,node);
        val start:int=self.used;let pending:bool=false;
        while(!doctree::absent(n) && !same(n,end)){
            if(self.hidden(tree,n)){n=self.after(tree,n);continue;}
            if(tree.kind(n)==2){for(let i:int=0;i<htdl::value_size(tree,n);i++){
                val c:byte=htdl::value_byte(tree,n,i);
                if(htdl::space(int(c))){pending=self.used>start;}
                else{if(pending){if(!self.put(byte(32))){return false;}pending=false;}if(!self.put(c)){return false;}}
            }}
            val child:doctree::NodeId=tree.first_child(n);if(!doctree::absent(child)){n=child;}else{n=self.after(tree,n);}
        }return true;
    }
    fn init(borrow mut self,borrow document:documents::Document,borrow page:flowpage::Page,
