            if(parent>=0){val q:int=parent*46;x=self.data[q+6]+self.data[q+10]+self.data[q+40];y=self.data[q+7]+self.data[q+10];
                let previous:int=0;for(let j:int=parent+1;j<i;j++){val r:int=j*46;if(self.data[r+3]!=parent){continue;}
                    if(self.data[q+11]==1){x+=self.data[r+8];}else{y+=self.data[r+9];}previous++;}
                if(self.data[q+11]==1){x+=previous*self.data[q+12];
                    val spare:int=maximum(0,self.data[q+9]-2*self.data[q+10]-self.data[p+9]);
                    if(self.data[q+13]==1){y+=spare/2;}if(self.data[q+13]==2){y+=spare;}
                    if(self.data[q+13]==3 && self.data[p+24]==0){self.data[p+9]+=spare;}
                }else{y+=previous*self.data[q+12];val spare:int=maximum(0,self.data[q+8]-2*self.data[q+10]-self.data[q+36]-self.data[q+40]-self.data[p+8]);
                    if(self.data[q+13]==1){x+=spare/2;}if(self.data[q+13]==2){x+=spare;}}
