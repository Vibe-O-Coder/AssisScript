            val size:int=htdl::value_size(tree,reference);
            if(size<1 || size>256){self.fail(207,label);return false;}
            own id:*byte=try_alloc<byte>(size);if(id==null){self.fail(401,label);return false;}
            for(let j:int=0;j<size;j++){id[j]=htdl::value_byte(tree,reference,j);}
            val target:int=self.find(htdl::find_id(tree,slice_of(id,0,size)));
