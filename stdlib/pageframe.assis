            if(end==at || self.lines==32768){self.fail(303,self.node(index));return false;}
            let x:int=0;if(self.data[p+20]==1){x=(available-measured)/2;}if(self.data[p+20]==2){x=available-measured;}
            self.runs[self.lines]=new Run(index,start+at,end-at,new Rect(x,y,measured,row));self.lines++;y+=row;at=resume;
