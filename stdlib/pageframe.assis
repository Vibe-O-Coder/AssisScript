                }else{
                    if(!structural(kind) && kind!=6 && kind!=8 && kind!=20 && !interactive(kind)){self.fail(203,node);return;}
                    if(self.count==256){self.fail(401,node);return;}
                    val p:int=self.count*46;val parent:int=self.find(tree.parent(node));
                    if(kind!=4 && parent<0){self.fail(204,node);return;}
                    self.data[p]=node.instance;self.data[p+1]=node.slot;self.data[p+2]=node.generation;
                    self.data[p+3]=parent;self.data[p+4]=kind;self.data[p+5]=int(htdl::value_equals(tree,htdl::attribute(tree,node,8),utf8("true")));
                    self.data[p+10]=pixels(self.property(page,document,node,3,0));
                    self.data[p+11]=self.property(page,document,node,4,0)%4;
                    self.data[p+12]=pixels(self.property(page,document,node,4,0)/4);
                    self.data[p+13]=self.property(page,document,node,5,0);self.data[p+14]=self.property(page,document,node,6,0);
                    let background:int=0;if(kind==9){background=0xd9e6e4ff;}
                    let foreground:int=0x223143ff;if(kind==17){foreground=0x006d77ff;}
                    self.data[p+15]=self.property(page,document,node,7,background);self.data[p+16]=self.property(page,document,node,8,foreground);
                    // Rounded corners require a matching clipping/raster provider.
                    if(self.property(page,document,node,9,0)!=0){self.fail(203,node);return;}
                    self.data[p+17]=self.property(page,document,node,10,65536);
                    val size:int=self.property(page,document,node,11,16*65536);
                    self.data[p+18]=(size*text_scale+32768)>>16;self.data[p+19]=self.property(page,document,node,12,400*65536);
                    self.data[p+20]=self.property(page,document,node,13,0);
                    self.data[p+21]=pixels(self.property(page,document,node,14,0));self.data[p+22]=pixels(self.property(page,document,node,15,0));
                    self.data[p+23]=int(page.has(document,node,1));self.data[p+24]=int(page.has(document,node,2));
                    self.data[p+8]=pixels(self.property(page,document,node,1,width*65536));self.data[p+9]=pixels(self.property(page,document,node,2,0));
                    if(self.data[p+18]<65536 || self.data[p+18]>256*65536){self.fail(303,node);return;}
                    if(kind==19){
                        let ordinal:int=1;let sibling:doctree::NodeId=htdl::first_element(tree,tree.parent(node));
                        while(!doctree::absent(sibling) && !same(sibling,node)){
                            if(!self.hidden(tree,sibling)){ordinal++;}sibling=htdl::next_element(tree,sibling);
                        }
                        self.data[p+41]= -1;
                        if(htdl::value_equals(tree,htdl::attribute(tree,tree.parent(node),16),utf8("true"))){self.data[p+41]=ordinal;}
                        self.data[p+42]=self.used;
                        if(self.data[p+41]<0){if(!self.put(byte(226)) || !self.put(byte(128)) || !self.put(byte(162))){return;}}
                        else{if(ordinal>=100){if(!self.put(byte(48+ordinal/100))){return;}}
                            if(ordinal>=10){if(!self.put(byte(48+(ordinal/10)%10))){return;}}
                            if(!self.put(byte(48+ordinal%10)) || !self.put(byte(46))){return;}}
                        self.data[p+43]=self.used-self.data[p+42];
                        val mark:int=metric(slice_of(self.content,self.data[p+42],self.data[p+43]),self.data[p+18],self.data[p+19]);
                        if(mark<0 || (mark>>32)<1 || (mark>>32)>1024 || mark%4294967296>16384){self.fail(304,node);return;}
                        self.data[p+40]=mark%4294967296+maximum(1,pixels(self.data[p+18])/2);self.data[p+37]=mark>>32;
                    }
                    if(parent>=0){val q:int=parent*46;val available:int=maximum(0,self.data[q+8]-2*self.data[q+10]-self.data[q+36]-self.data[q+40]);
                        if(self.data[q+11]==1 && self.data[p+23]==0){self.fail(303,node);return;}
                        if(self.data[p+23]==0){self.data[p+8]=available;}
                    }
