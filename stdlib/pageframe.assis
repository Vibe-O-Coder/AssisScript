        val profile:int=editing_profile(document);if(profile!=0){self.fail(profile,new doctree::NodeId());return;}
        self.data=try_alloc<int>(256*46);self.content=try_alloc<byte>(2*document.source_size()+2048);self.runs=try_alloc<pageframe::Run>(32768);
        if(self.data==null || self.content==null || self.runs==null){self.fail(401,new doctree::NodeId());return;}
        self.width=width;self.height=height;self.scroll=scroll_y;
        self.instance_id=document.instance();self.semantic=document.semantic_version();self.revision=frame_version;
        if(page.document_instance()==document.instance()){self.style=page.version();}
        borrow tree:doctree::Tree=document.nodes();
