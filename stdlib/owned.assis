namespace owned;

struct Link<T> { own value:T; own next:Link<T>; }

safe fn element<T>(borrow no:Link<T>,indice:int):borrow(no) T {
    assert(no!=null && indice>=0);
    if(indice==0){return no.value;}
    return element::<T>(no.next,indice-1);
}

/// Coleção limitada de recursos Move. Inserção/remoção na frente O(1), leitura
/// por índice O(n). Destruição O(n) recursiva; limite de 1024 nós.
public final class OwnedList<T> {
    private own start:Link<T>;
    private let count:int;

    fn size(borrow self):int{return self.count;}

    fn push_front(borrow mut self,own value:T):void {
        assert(self.count<1024);
        own anterior:Link<T>=move(self.start);
        self.start=new Link<T>(move(value),move(anterior));
        self.count+=1;
    }

    fn get(borrow self,indice:int):borrow(self) T {
        assert(indice>=0 && indice<self.count);
        return element::<T>(self.start,indice);
    }

    fn pop_front(borrow mut self):own T {
        assert(self.count>0);
        own no:Link<T>=move(self.start);
        self.start=move(no.next);
        self.count-=1;
        return move(no.value);
    }
}

// A sparse binary index keeps both lookup and destruction depth logarithmic.
// Leaf values move independently; internal nodes only own child nodes.
struct ArrayNode<T>{own value:T;own left:ArrayNode<T>;own right:ArrayNode<T>;}
safe fn array_put<T>(borrow mut node:ArrayNode<T>,index:int,capacity:int,own value:T):void {
    if(capacity==1){node.value=move(value);return;}
    val half:int=capacity/2;
    if(index<half){if(node.left==null){node.left=new ArrayNode<T>();}array_put::<T>(node.left,index,half,move(value));}
    else{if(node.right==null){node.right=new ArrayNode<T>();}array_put::<T>(node.right,index-half,half,move(value));}
}
safe fn array_get<T>(borrow node:ArrayNode<T>,index:int,capacity:int):borrow(node) T {
    if(capacity==1){return node.value;}
    val half:int=capacity/2;
    if(index<half){return array_get::<T>(node.left,index,half);}
    return array_get::<T>(node.right,index-half,half);
}
safe fn array_take<T>(borrow mut node:ArrayNode<T>,index:int,capacity:int):own T {
    if(capacity==1){return move(node.value);}
    val half:int=capacity/2;
    if(index<half){return array_take::<T>(node.left,index,half);}
    return array_take::<T>(node.right,index-half,half);
}

/// Indexed collection of Move resources, without the linked list's 1024 limit.
/// push/get/pop O(log capacity), destruction O(n) with O(log capacity) stack.
/// This initial representation uses tree nodes, not a contiguous memory buffer.
public final class OwnedArray<T> {
    private own root:ArrayNode<T>;
    private let count:int;
    private let capacity:int;
    fn size(borrow self):int{return self.count;}
    fn push(borrow mut self,own value:T):void {
        if(self.capacity==0){self.root=new ArrayNode<T>();self.capacity=1;}
        else if(self.count==self.capacity){
            assert(self.capacity<=0x2000_0000_0000_0000);
            own previous:ArrayNode<T>=move(self.root);self.root=new ArrayNode<T>();self.root.left=move(previous);self.capacity*=2;
        }
        val index:int=self.count;val capacity:int=self.capacity;
        array_put::<T>(self.root,index,capacity,move(value));self.count+=1;
    }
    fn get(borrow self,index:int):borrow(self) T {
        assert(index>=0 && index<self.count);return array_get::<T>(self.root,index,self.capacity);
    }
    fn pop(borrow mut self):own T {
        assert(self.count>0);self.count-=1;val index:int=self.count;val capacity:int=self.capacity;
        return array_take::<T>(self.root,index,capacity);
    }
}
