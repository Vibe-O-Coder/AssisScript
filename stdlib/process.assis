        fn drop(borrow mut self):void{unsafe{if(self.handle!=u64(0)){let ignored:i32=close(self.handle);}}}
    }
    final class Native {
        let process:u64;let thread:u64;let job:u64;let reader:u64;let writer:u64;
        fn drop(borrow mut self):void{unsafe{
            if(self.job!=u64(0)){let ignored:i32=terminate(self.job,u32(125));}
            if(self.process!=u64(0)){let ignored:i32=terminate_process(self.process,u32(125));let waited:u32=wait(self.process,u32(5000));ignored=close(self.process);}
            if(self.thread!=u64(0)){let ignored:i32=close(self.thread);}if(self.reader!=u64(0)){let ignored:i32=close(self.reader);}if(self.writer!=u64(0)){let ignored:i32=close(self.writer);}if(self.job!=u64(0)){let ignored:i32=close(self.job);}
