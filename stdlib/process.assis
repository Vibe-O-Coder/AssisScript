}

/// Explicit trusted shell command (/bin/sh -c or system cmd.exe /d /s /c).
/// This API interprets shell syntax. Keep untrusted data out of commands.
/// No shared memory: process isolation is the supported concurrency model.
public safe fn run_shell(borrow command:*byte,timeout_ms:int,max_bytes:int):own Output {
    if(timeout_ms<1||timeout_ms>60000||max_bytes<0||max_bytes>16777216||len(command)<2||len(command)>16384||command[len(command)-1]!=byte(0)){return failure(-1);}
    for(let i:int=0;i<len(command)-1;i+=1){if(command[i]==byte(0)){return failure(-1);}}
    return run(command,timeout_ms,max_bytes);
}

/// Nonblocking exclusive OS lock; released on close or process termination.
/// The lock file remains on disk and can be reused after a crash.
public safe fn lock(borrow path:*byte):own Lock {
    if(len(path)<2||len(path)>16384||path[len(path)-1]!=byte(0)){own empty:*byte=alloc<byte>(1);return new Lock(empty);}
    for(let i:int=0;i<len(path)-1;i+=1){if(path[i]==byte(0)){own empty:*byte=alloc<byte>(1);return new Lock(empty);}}
    return new Lock(path);
}
