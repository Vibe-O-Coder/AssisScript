    extern("libc.so.6","unused.dll","kill") fn kill(pid:i32,signal:i32):i32;
    extern("libc.so.6","unused.dll","__errno_location") fn errno_address():*i32;
    extern("libc.so.6","unused.dll","open") fn open_lock(borrow path:*byte,flags:i32,mode:i32):i32;
    extern("libc.so.6","unused.dll","flock") fn flock(fd:i32,operation:i32):i32;
    public final class Lock {
        private let handle:i32;private let held:bool;
        fn init(borrow mut self,borrow path:*byte):void{self.handle=i32(-1);unsafe{self.handle=open_lock(path,i32(524354),i32(384));if(self.handle>=i32(0)){self.held=flock(self.handle,i32(6))==i32(0);}}}
        fn acquired(borrow self):bool{return self.held;}
        fn drop(borrow mut self):void{unsafe{if(self.handle>=i32(0)){let ignored:i32=close(self.handle);}}}
    }
    final class Native {
        let pid:i32;let reader:i32;let writer:i32;
        fn init(borrow mut self):void{self.reader=i32(-1);self.writer=i32(-1);}
        fn drop(borrow mut self):void{unsafe{
            if(self.reader>=i32(0)){let ignored:i32=close(self.reader);}if(self.writer>=i32(0)){let ignored:i32=close(self.writer);}
            if(self.pid>i32(0)){let ignored:i32=kill(-self.pid,i32(9));ignored=kill(self.pid,i32(9));own status:*i32=alloc<i32>(1);while(wait(self.pid,status,i32(0))==i32(-1)){if(*errno_address()!=i32(4)){break;}}}
        }}
    }
    safe fn run(borrow command:*byte,timeout:int,limit:int):own Output {
        own state:Native=new Native();own fds:*i32=alloc<i32>(2);own status:*i32=alloc<i32>(1);own info:*i32=alloc<i32>(32);own data:*byte=alloc<byte>(limit);own chunk:*byte=alloc<byte>(4096);
        let count:int=0;let error:int=0;let code:int=-1;let done:bool=false;let eof:bool=false;val started:int=monotonic_ms();
        unsafe {
            if(pipe(fds,i32(524288))!=i32(0)){return failure(-4);}
            state.reader=fds[0];state.writer=fds[1];state.pid=fork();if(state.pid<i32(0)){state.pid=i32(0);return failure(-4);}
            if(state.pid==i32(0)){
                let ignored:i32=group(i32(0),i32(0));if(ignored==i32(-1)){exit(i32(126));}
                if(duplicate(state.writer,i32(1))==i32(-1)||duplicate(state.writer,i32(2))==i32(-1)){exit(i32(126));}
                ignored=close(state.reader);ignored=close(state.writer);ignored=close(i32(0));
                ignored=execute("/bin/sh","sh","-c",command,u64(0));exit(i32(127));return failure(-4);
            }
            let ignored:i32=group(state.pid,state.pid);ignored=close(state.writer);state.writer=i32(-1);
            if(flags(state.reader,i32(4),i32(2048))==i32(-1)){return failure(-4);}
            while(true){
                let amount:int=read(state.reader,chunk,u64(4096));
                if(amount>0){if(amount>limit-count){error=-2;break;}for(let i:int=0;i<amount;i+=1){data[count+i]=chunk[i];}count+=amount;}
                else if(amount==0){eof=true;}
                else {let native:i32=*errno_address();if(native!=i32(11)&&native!=i32(4)){error=-4;break;}}
                if(!done){
                    info[4]=i32(0);let observed:i32=observe(i32(1),u32(state.pid),info,i32(16777221));
                    if(observed==i32(0)&&info[4]!=i32(0)){
                        // WNOWAIT pins the leader PID until descendants have
                        // been stopped; never signal a reaped/reused PID.
                        ignored=kill(-state.pid,i32(9));let reaped:i32=wait(state.pid,status,i32(0));while(reaped==i32(-1)&&*errno_address()==i32(4)){reaped=wait(state.pid,status,i32(0));}
                        if(reaped!=state.pid){error=-4;break;}done=true;state.pid=i32(0);
                        if((int(status[0])&127)==0){code=(int(status[0])>>8)&255;}else{code=128+(int(status[0])&127);}
                    }else if(observed==i32(-1)&&*errno_address()!=i32(4)){error=-4;break;}
                }
                if(done&&eof){break;}if(monotonic_ms()-started>=timeout){error=-3;break;}
                if(amount<=0){let slept:int=sleep_ms(1);}
            }
        }
        return new Output(move(data),count,code,error);
    }
}

