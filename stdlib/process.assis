namespace process;

/// Captured stdout and stderr, merged into one bounded binary buffer.
/// error(): 0 completed, -1 invalid input, -2 output limit, -3 timeout,
/// -4 OS failure. exit_code() is the child's status, separate from errors.
public final class Output {
    private own data:*byte;private let count:int;private let code:int;private let failure:int;
    fn init(borrow mut self,own data:*byte,count:int,code:int,failure:int):void{self.data=move(data);self.count=count;self.code=code;self.failure=failure;}
    fn body(borrow self):borrow(self) slice<byte>{return slice_of(self.data,0,self.count);}
    fn size(borrow self):int{return self.count;}
    fn exit_code(borrow self):int{return self.code;}
    fn error(borrow self):int{return self.failure;}
}
safe fn failure(code:int):own Output{return new Output(alloc<byte>(0),0,-1,code);}

