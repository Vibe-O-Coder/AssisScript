    safe fn run(borrow command:*byte,timeout:int,limit:int):own Output {
        own state:Native=new Native();own reader:*u64=alloc<u64>(1);own writer:*u64=alloc<u64>(1);own attributes:*u64=alloc<u64>(3);attributes[0]=u64(24);attributes[2]=u64(1);
