namespace pagevm;

/// ASV1 is an experimental integer/boolean register machine, not an AssisScript
/// page backend or an OS sandbox. No FFI, file, network, process or clock opcode.
public pure fn version():int{return 1;}
safe fn word(borrow data:slice<byte>,at:int):int{
    return int(data[at])+int(data[at+1])*256+int(data[at+2])*65536+int(data[at+3])*16777216;
}
safe fn signed_word(borrow data:slice<byte>,at:int):int{
    val n:int=word(data,at);if(n>=2147483648){return n-4294967296;}return n;
}
safe fn valid_instruction(borrow data:slice<byte>,at:int,count:int):bool{
    val op:int=int(data[at]);val a:int=int(data[at+1]);
    val b:int=int(data[at+2]);val c:int=int(data[at+3]);val immediate:int=signed_word(data,at+4);
    if(op>15 || a>=16){return false;}
    if(op==0 || op==11){return b==0 && c==0 && immediate==0;}
    if(op==1){return b==0 && c==0;}
    if(op>=2 && op<=7){return b<16 && c<16 && immediate==0;}
    if(op==8){return a==0 && b==0 && c==0 && immediate>=0 && immediate<count;}
    if(op==9){return b==0 && c==0 && immediate>=0 && immediate<count;}
    if(op==10){return b<16 && c==0 && immediate>=0 && immediate<count;}
    if(op==12){return b<16 && c==0 && immediate==1;}
    return b<16 && c==0 && immediate==0;
}

/// A host constructs each instance with non-reused identity/origin/generation.
/// All bytecode and mutable state are independently owned and bounded before
/// allocation. Raw bytecode never supplies identity or grants authority.
public final class Instance{
    private own code:*byte;private own memory:*byte;private own registers:*int;
    private own returns:*int;private own destinations:*int;
    private let instance_id:int;private let origin_id:int;private let generation_id:int;
    private let instruction_count:int;private let memory_size:int;private let pc:int;
    private let frame:int;private let frames:int;private let fuel_limit:int;private let fuel_used:int;
    private let host_limit:int;private let host_used:int;private let counter_value:int;
    private let granted:bool;private let state:int;private let output:int;
    fn init(borrow mut self,instance:int,origin:int,generation:int,borrow data:slice<byte>,
            max_memory:int,max_frames:int,max_steps:int,max_host_calls:int):void{
        self.state=-1;
        if(instance<=0 || origin<=0 || generation<=0 || len(data)<16 || len(data)>131088 ||
           max_memory<0 || max_memory>65536 || max_frames<1 || max_frames>128 ||
           max_steps<1 || max_steps>1000000 || max_host_calls<0 || max_host_calls>10000){return;}
        if(data[0]!=65 || data[1]!=83 || data[2]!=86 || data[3]!=49){return;}
        val count:int=word(data,4);val entry:int=word(data,8);val memory:int=word(data,12);
        if(count<1 || count>16384 || len(data)!=16+count*8 || entry>=count || memory>max_memory){return;}
        for(let i:int=0;i<count;i++){if(!valid_instruction(data,16+i*8,count)){return;}}
        self.state=-4;
        self.code=try_alloc<byte>(count*8);self.memory=try_alloc<byte>(memory);
        self.registers=try_alloc<int>(max_frames*16);self.returns=try_alloc<int>(max_frames);
        self.destinations=try_alloc<int>(max_frames);
        if(self.code==null || self.memory==null || self.registers==null || self.returns==null || self.destinations==null){return;}
        for(let i:int=0;i<count*8;i++){self.code[i]=data[i+16];}
        self.instance_id=instance;self.origin_id=origin;self.generation_id=generation;
        self.instruction_count=count;self.memory_size=memory;self.pc=entry;self.frames=max_frames;
        self.fuel_limit=max_steps;self.host_limit=max_host_calls;self.state=0;
    }
    fn status(borrow self):int{return self.state;}
    fn result(borrow self):int{return self.output;}
    fn steps(borrow self):int{return self.fuel_used;}
    fn host_calls(borrow self):int{return self.host_used;}
    fn counter(borrow self):int{return self.counter_value;}
    /// Counter capability is granted by trusted host only; bytecode has no way
    /// to call this API. Local import index zero has no authority without it.
    fn grant_counter(borrow mut self,instance:int,origin:int,generation:int):bool{
        if(self.state!=0 || instance!=self.instance_id || origin!=self.origin_id || generation!=self.generation_id){return false;}
        self.granted=true;return true;
    }
    /// Revocation is permanent for this loaded instance and cancels execution.
    fn revoke(borrow mut self):void{self.granted=false;if(self.state>=0){self.state=-2;}}
    fn close(borrow mut self):void{self.granted=false;self.state=-9;}
    fn drop(borrow mut self):void{self.close();}
    /// Cooperative slice: 1 yielded, 2 halted, negative terminal error. Total
    /// fuel survives yields, host calls and recursion; no wall-clock import.
    fn run(borrow mut self,max_work:int):int{
        if(self.state!=0){return self.state;}
        if(max_work<1 || max_work>10000){return -1;}
        let work:int=0;
        while(work<max_work){
            if(self.fuel_used==self.fuel_limit){self.state=-3;return self.state;}
            if(self.pc<0 || self.pc>=self.instruction_count){self.state=-5;return self.state;}
            self.fuel_used++;work++;
            val at:int=self.pc*8;val op:int=int(self.code[at]);
            val a:int=int(self.code[at+1]);val b:int=int(self.code[at+2]);val c:int=int(self.code[at+3]);
            val immediate:int=signed_word(slice_of(self.code,0,len(self.code)),at+4);
            val base:int=self.frame*16;self.pc++;
            if(op==0){self.output=self.registers[base+a];self.state=2;return 2;}
            else if(op==1){self.registers[base+a]=immediate;}
            else if(op==2){self.registers[base+a]=self.registers[base+b]+self.registers[base+c];}
            else if(op==3){self.registers[base+a]=self.registers[base+b]-self.registers[base+c];}
            else if(op==4){self.registers[base+a]=self.registers[base+b]*self.registers[base+c];}
            else if(op==5){
                val left:int=self.registers[base+b];val right:int=self.registers[base+c];
                if(right==0){self.state=-7;return self.state;}
                if(left== -9223372036854775808 && right== -1){self.registers[base+a]=left;}
                else{self.registers[base+a]=left/right;}
            }
            else if(op==6){self.registers[base+a]=int(self.registers[base+b]==self.registers[base+c]);}
            else if(op==7){self.registers[base+a]=int(self.registers[base+b]<self.registers[base+c]);}
            else if(op==8){self.pc=immediate;}
            else if(op==9){if(self.registers[base+a]==0){self.pc=immediate;}}
            else if(op==10){
                if(self.frame+1==self.frames){self.state=-6;return self.state;}
                val argument:int=self.registers[base+b];self.frame++;
                self.returns[self.frame]=self.pc;self.destinations[self.frame]=a;
                for(let i:int=0;i<16;i++){self.registers[self.frame*16+i]=0;}
                self.registers[self.frame*16]=argument;self.pc=immediate;
            }
            else if(op==11){
                val result:int=self.registers[base+a];
                if(self.frame==0){self.output=result;self.state=2;return 2;}
                self.pc=self.returns[self.frame];val dest:int=self.destinations[self.frame];
                self.frame--;self.registers[self.frame*16+dest]=result;
            }
            else if(op==12){
                if(!self.granted){self.state=-2;return self.state;}
                if(self.host_used==self.host_limit){self.state=-8;return self.state;}
                val delta:int=self.registers[base+b];
                if(delta< -1000000 || delta>1000000){self.state=-10;return self.state;}
                self.host_used++;self.counter_value+=delta;self.registers[base+a]=self.counter_value;
            }
            else if(op==13 || op==14){
                let address:int=self.registers[base+b];if(op==14){address=self.registers[base+a];}
                if(address<0 || address>=self.memory_size){self.state=-5;return self.state;}
                if(op==13){self.registers[base+a]=int(self.memory[address]);}
                else{self.memory[address]=byte(self.registers[base+b]);}
            }
            else if(op==15){self.registers[base+a]=int(self.registers[base+b]==0);}
        }
        return 1;
    }
}
