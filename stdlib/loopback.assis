namespace loopback;

// The adapters below use the IPv4 sockaddr and pollfd layouts of the native
// 64-bit targets. Every socket is nonblocking and private to the server.
platform("windows-x64") {
    extern("unused.so","ws2_32.dll","WSAStartup") fn start(version:u16,borrow mut data:*int):i32;
    extern("unused.so","ws2_32.dll","WSACleanup") fn finish():i32;
    extern("unused.so","ws2_32.dll","WSAGetLastError") fn last_error():i32;
    extern("unused.so","ws2_32.dll","WSASocketW") fn socket_create(domain:i32,type:i32,protocol:i32,info:u64,group:u32,flags:u32):int;
    extern("unused.so","ws2_32.dll","ioctlsocket") fn socket_mode(socket:int,command:u32,borrow mut value:*u32):i32;
    extern("unused.so","ws2_32.dll","setsockopt") fn socket_option(socket:int,level:i32,option:i32,borrow value:*i32,size:i32):i32;
    extern("unused.so","ws2_32.dll","bind") fn socket_bind(socket:int,borrow address:*byte,size:i32):i32;
    extern("unused.so","ws2_32.dll","listen") fn socket_listen(socket:int,backlog:i32):i32;
    extern("unused.so","ws2_32.dll","getsockname") fn socket_name(socket:int,borrow mut address:*byte,borrow mut size:*i32):i32;
    extern("unused.so","ws2_32.dll","accept") fn socket_accept(socket:int,address:u64,size:u64):int;
    extern("unused.so","ws2_32.dll","closesocket") fn socket_close(socket:int):i32;
    extern("unused.so","ws2_32.dll","recv") fn socket_receive(socket:int,borrow mut buffer:*byte,size:i32,flags:i32):i32;
    extern("unused.so","ws2_32.dll","send") fn socket_send(socket:int,borrow buffer:*byte,size:i32,flags:i32):i32;
    extern("unused.so","ws2_32.dll","WSAPoll") fn socket_poll(borrow mut entries:*int,count:u32,timeout:i32):i32;
    extern("unused.so","kernel32.dll","SetHandleInformation") fn handle_flags(handle:int,mask:u32,flags:u32):i32;

    safe fn initialize():bool {
        own data:*int=try_alloc<int>(64);
        if(data==null){return false;}
        unsafe{return start(u16(0x0202),data)==i32(0);}
    }
    safe fn cleanup():void {unsafe{finish();}}
    safe fn nonblocking(socket:int):bool {
        own mode:*u32=try_alloc<u32>(1);
        if(mode==null){return false;}
        mode[0]=u32(1);
        unsafe{return socket_mode(socket,u32(0x8004667e),mode)==i32(0);}
    }
    safe fn close(socket:int):void {unsafe{socket_close(socket);}}
    safe fn create(borrow option:*i32):int {
        unsafe {
            val socket:int=socket_create(i32(2),i32(1),i32(6),u64(0),u32(0),u32(0x80));
            if(socket== -1){return -1;}
            if(socket_option(socket,i32(65535),i32(-5),option,i32(4))==i32(0) && nonblocking(socket)){return socket;}
            close(socket);
            return -1;
        }
    }
    safe fn accept(listener:int):int {
        unsafe {
            val socket:int=socket_accept(listener,u64(0),u64(0));
            if(socket== -1){
                val error:int=int(last_error());
                if(error==10035 || error==10004 || error==10053 || error==10054){return -2;}
                return -1;
            }
            if(handle_flags(socket,u32(1),u32(0))!=i32(0) && nonblocking(socket)){return socket;}
            close(socket);
            return -1;
        }
    }
    safe fn result(count:int):int {
        if(count>=0){return count;}
        unsafe{val error:int=int(last_error());if(error==10035 || error==10004){return -2;}}
        return -1;
    }
    safe fn receive(socket:int,borrow mut buffer:*byte,limit:int):int {
        unsafe{return result(int(socket_receive(socket,buffer,i32(limit),i32(0))));}
    }
    safe fn send(socket:int,borrow buffer:*byte,amount:int):int {
        unsafe{return result(int(socket_send(socket,buffer,i32(amount),i32(0))));}
    }
    safe fn entry(borrow mut entries:*int,index:int,socket:int,writing:bool):void {
        entries[2*index]=socket;
        entries[2*index+1]=256;
        if(writing){entries[2*index+1]=16;}
    }
    safe fn poll(borrow mut entries:*int,count:int,wait:int):int {
        unsafe{return result(int(socket_poll(entries,u32(count),i32(wait))));}
    }
}

platform("linux-x64") {
    extern("libc.so.6","unused.dll","socket") fn socket_create(domain:i32,type:i32,protocol:i32):i32;
    extern("libc.so.6","unused.dll","setsockopt") fn socket_option(socket:i32,level:i32,option:i32,borrow value:*i32,size:i32):i32;
    extern("libc.so.6","unused.dll","bind") fn socket_bind(socket:i32,borrow address:*byte,size:i32):i32;
    extern("libc.so.6","unused.dll","listen") fn socket_listen(socket:i32,backlog:i32):i32;
    extern("libc.so.6","unused.dll","getsockname") fn socket_name(socket:i32,borrow mut address:*byte,borrow mut size:*i32):i32;
    extern("libc.so.6","unused.dll","accept4") fn socket_accept(socket:i32,address:u64,size:u64,flags:i32):i32;
    extern("libc.so.6","unused.dll","close") fn socket_close(socket:i32):i32;
    extern("libc.so.6","unused.dll","recv") fn socket_receive(socket:i32,borrow mut buffer:*byte,size:int,flags:i32):int;
    extern("libc.so.6","unused.dll","send") fn socket_send(socket:i32,borrow buffer:*byte,size:int,flags:i32):int;
    extern("libc.so.6","unused.dll","poll") fn socket_poll(borrow mut entries:*int,count:u64,timeout:i32):i32;
    extern("libc.so.6","unused.dll","__errno_location") fn errno_address():*i32;

    pure fn initialize():bool {return true;}
    safe fn cleanup():void {}
    safe fn close(socket:int):void {unsafe{socket_close(i32(socket));}}
    safe fn create(borrow option:*i32):int {
        unsafe {
            // SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC.
            val socket:i32=socket_create(i32(2),i32(0x80801),i32(6));
            if(socket<i32(0)){return -1;}
            if(socket_option(socket,i32(1),i32(2),option,i32(4))==i32(0)){return int(socket);}
            close(int(socket));
            return -1;
        }
    }
    safe fn accept(listener:int):int {
        unsafe {
            val socket:i32=socket_accept(i32(listener),u64(0),u64(0),i32(0x80800));
            if(socket>=i32(0)){return int(socket);}
            val error:int=int(errno_address()[0]);
            if(error==11 || error==4 || error==103){return -2;}
            return -1;
        }
    }
    safe fn result(count:int):int {
        if(count>=0){return count;}
        unsafe{val error:int=int(errno_address()[0]);if(error==11 || error==4){return -2;}}
        return -1;
    }
    safe fn receive(socket:int,borrow mut buffer:*byte,limit:int):int {
        unsafe{return result(socket_receive(i32(socket),buffer,limit,i32(0)));}
    }
    safe fn send(socket:int,borrow buffer:*byte,amount:int):int {
        // MSG_NOSIGNAL keeps a peer reset local to its connection.
        unsafe{return result(socket_send(i32(socket),buffer,amount,i32(0x4000)));}
    }
    safe fn entry(borrow mut entries:*int,index:int,socket:int,writing:bool):void {
        let event:int=1;
        if(writing){event=4;}
        entries[index]=socket|(event<<32);
    }
    safe fn poll(borrow mut entries:*int,count:int,wait:int):int {
        unsafe{return result(int(socket_poll(entries,u64(count),i32(wait))));}
    }
}

// Unsupported targets still check and build without importing a foreign ABI.
platform("linux-arm64") {
    pure fn initialize():bool {return false;}
    safe fn cleanup():void {}
    safe fn create(borrow option:*i32):int {return -1;}
    safe fn close(socket:int):void {}
    pure fn accept(listener:int):int {return -1;}
    safe fn receive(socket:int,borrow mut buffer:*byte,limit:int):int {return -1;}
    safe fn send(socket:int,borrow buffer:*byte,amount:int):int {return -1;}
    safe fn entry(borrow mut entries:*int,index:int,socket:int,writing:bool):void {}
    safe fn poll(borrow mut entries:*int,count:int,wait:int):int {return -1;}
    safe fn bind_port(socket:int,borrow mut address:*byte,borrow mut size:*i32,capacity:int):bool {return false;}
}
platform("macos") {
    pure fn initialize():bool {return false;}
    safe fn cleanup():void {}
    safe fn create(borrow option:*i32):int {return -1;}
    safe fn close(socket:int):void {}
    pure fn accept(listener:int):int {return -1;}
    safe fn receive(socket:int,borrow mut buffer:*byte,limit:int):int {return -1;}
    safe fn send(socket:int,borrow buffer:*byte,amount:int):int {return -1;}
    safe fn entry(borrow mut entries:*int,index:int,socket:int,writing:bool):void {}
    safe fn poll(borrow mut entries:*int,count:int,wait:int):int {return -1;}
    safe fn bind_port(socket:int,borrow mut address:*byte,borrow mut size:*i32,capacity:int):bool {return false;}
}

platform("windows-x64") {
    safe fn bind_port(socket:int,borrow mut address:*byte,borrow mut size:*i32,capacity:int):bool {
        unsafe{return socket_bind(socket,address,i32(16))==i32(0) && socket_listen(socket,i32(capacity))==i32(0) && socket_name(socket,address,size)==i32(0);}
    }
}
platform("linux-x64") {
    safe fn bind_port(socket:int,borrow mut address:*byte,borrow mut size:*i32,capacity:int):bool {
        val fd:i32=i32(socket);
        unsafe{return socket_bind(fd,address,i32(16))==i32(0) && socket_listen(fd,i32(capacity))==i32(0) && socket_name(fd,address,size)==i32(0);}
    }
}
/// IPv4 loopback listener and at most 16 connections. No DNS or remote bind.
/// The caller owns slot use and closes a connection before reusing its slot.
public final class Server {
    private own sockets:*int;
    private own entries:*int;
    private let initialized:bool;
    private let listener:int;
    private let limit:int;
    private let bound_port:int;

    fn init(borrow mut self,port:int,capacity:int):void {
        self.listener= -1;
        if(port<0 || port>65535 || capacity<1 || capacity>16){return;}
        own address:*byte=try_alloc<byte>(16);
        own size:*i32=try_alloc<i32>(1);
        self.sockets=try_alloc<int>(capacity);
        self.entries=try_alloc<int>(2*(capacity+1));
        if(address==null || size==null || self.sockets==null || self.entries==null){return;}
        self.limit=capacity;
        for(let slot:int=0;slot<capacity;slot++){self.sockets[slot]= -1;}
        if(!initialize()){return;}
        self.initialized=true;
        size[0]=i32(1);
        self.listener=create(size);
        if(self.listener== -1){return;}
        address[0]=byte(2);
        address[2]=byte(port>>8);address[3]=byte(port&255);
        address[4]=byte(127);address[7]=byte(1);
        size[0]=i32(16);
        if(!bind_port(self.listener,address,size,capacity) || size[0]!=i32(16)){return;}
        self.bound_port=int(address[2])*256+int(address[3]);
    }
    fn port(borrow self):int {return self.bound_port;}
    fn connected(borrow self,slot:int):bool {
        return slot>=0 && slot<self.limit && self.sockets[slot]!= -1;
    }
    fn accept(borrow mut self):int {
        if(self.bound_port==0){return -1;}
        for(let slot:int=0;slot<self.limit;slot++){
            if(self.sockets[slot]!= -1){continue;}
            val peer:int=accept(self.listener);
            if(peer<0){return peer;}
            self.sockets[slot]=peer;
            return slot;
        }
        return -2;
    }
    fn wait(borrow mut self,writing:int,timeout:int):int {
        if(self.bound_port==0 || writing<0 || timeout<0 || timeout>1000){return -1;}
        let count:int=0;
        for(let slot:int=0;slot<self.limit;slot++){
            val socket:int=self.sockets[slot];
            if(socket== -1){continue;}
            entry(self.entries,count,socket,(writing&(1<<slot))!=0);
            count++;
        }
        if(count<self.limit){
            val listener:int=self.listener;
            entry(self.entries,count,listener,false);
            count++;
        }
        return poll(self.entries,count,timeout);
    }
    fn receive(borrow self,slot:int,borrow mut buffer:*byte,limit:int):int {
        if(!self.connected(slot) || limit<1 || limit>len(buffer) || limit>65536){return -1;}
        return receive(self.sockets[slot],buffer,limit);
    }
    fn send(borrow self,slot:int,borrow buffer:*byte,amount:int):int {
        if(!self.connected(slot) || amount<1 || amount>len(buffer) || amount>65536){return -1;}
        return send(self.sockets[slot],buffer,amount);
    }
    fn disconnect(borrow mut self,slot:int):void {
        if(self.connected(slot)){close(self.sockets[slot]);self.sockets[slot]= -1;}
    }
    fn drop(borrow mut self):void {
        for(let slot:int=0;slot<self.limit;slot++){self.disconnect(slot);}
        if(self.listener!= -1){close(self.listener);}
        if(self.initialized){cleanup();}
    }
}
