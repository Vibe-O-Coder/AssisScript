namespace htdl_v1;

// A page-asv2 build resolves exactly these signatures to bounded VM imports.
// Native builds require an explicitly linked test provider; no native library
// is distributed or downloaded for page execution.
extern("assis_htdl_v1","assis_htdl_v1","counter_add_v1") fn native_counter(delta:int):int;
extern("assis_htdl_v1","assis_htdl_v1","event_get_v1") fn native_event(field:int):int;
extern("assis_htdl_v1","assis_htdl_v1","state_get_v1") fn native_get(slot:int):int;
extern("assis_htdl_v1","assis_htdl_v1","state_set_v1") fn native_set(slot:int,value:int):int;
