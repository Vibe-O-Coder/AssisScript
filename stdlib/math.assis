/// Retorna o menor entre a e b, em comparação de inteiros com sinal.
fn min(a: int, b: int): int { if (a < b) { return a; } return b; }
/// Retorna o maior entre a e b, em comparação de inteiros com sinal.
fn max(a: int, b: int): int { if (a > b) { return a; } return b; }
/// Restringe valor ao intervalo fechado [inferior, superior]. Exige inferior <= superior.
fn clamp(value: int, inferior: int, superior: int): int {
    assert(inferior <= superior);
    return min(max(value, inferior), superior);
}
/// Retorna o valor absoluto. O mínimo int (-2^63) preserva o próprio valor por overflow modular.
fn abs(value: int): int { if (value < 0) { return -value; } return value; }

// Compatibilidade com 2.x
// Biblioteca padrão: mínimo, máximo, limite e value abs em int.
/// Retorna o menor entre os dois inteiros (API legada de minimo).
fn Assis_assis_fodase(AssisAssis: int, AssisFodase: int): int {
    if (AssisAssis < AssisFodase) { return AssisAssis; }
    return AssisFodase;
}
/// Retorna o maior entre os dois inteiros (API legada de maximo).
fn Assis_fodase_assis(AssisAssis: int, AssisFodase: int): int {
    if (AssisAssis > AssisFodase) { return AssisAssis; }
    return AssisFodase;
}
/// Aplica maximo(valor, inferior) e minimo(resultado, superior), sem validar a ordem dos limites (API legada).
fn Assis_fodase_fodase(AssisAssis: int, AssisFodase: int, FodaseAssis: int): int {
    return Assis_assis_fodase(Assis_fodase_assis(AssisAssis, AssisFodase), FodaseAssis);
}
// O mínimo de 64 bits preserva o próprio value pela regra de overflow.
/// Calcula valor absoluto com overflow modular; -2^63 permanece inalterado (API legada).
fn Assis_assis_assis(AssisAssis: int): int {
    if (AssisAssis < 0) { return -AssisAssis; }
    return AssisAssis;
}
