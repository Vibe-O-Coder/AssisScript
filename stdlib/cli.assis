namespace cli;

import "std/parse.assis";

public struct Argument { let ok: bool; own data: *byte; let size: int; }
public value struct ParsedInt { let ok: bool; let value: int; let position: int; }

/// Cópia independente de argumento Unicode, com comprimento e NUL final.
public safe fn argument(indice: int): own Argument {
    val n: int = arg_size(indice);
    if (n < 0 || n == 0x7fff_ffff_ffff_ffff) { return new Argument(false, alloc<byte>(0), 0); }
    own data: *byte = alloc<byte>(n + 1);
    if (arg_copy(indice, data, n + 1) != n) { return new Argument(false, alloc<byte>(0), 0); }
    return new Argument(true, move(data), n);
}

/// Decimal int64 estrito sobre bytes; não depende de terminador ou text C.
public safe fn parse_integer(borrow data: *byte, size: int): ParsedInt {
    if (size <= 0 || size > len(data)) { return new ParsedInt(false, 0, 0); }
    val result: parse::Parsed<int> = parse::parse_i64(slice_of(data, 0, size));
    if (!result.ok) { return new ParsedInt(false, 0, result.position); }
    return new ParsedInt(true, result.value, size);
}

/// Lê até EOF; retorna -1 em falha ou se o arquivo exceder a capacidade.
/// Capacidade zero aceita somente arquivo vazio. Memória auxiliar: 4096 bytes.
public safe fn read_bounded(borrow mut arquivo: File, borrow mut destino: *byte): int {
    own bloco: *byte = alloc<byte>(4096);let total: int = 0;
    while (true) {
        val n: int = file_read(arquivo, bloco, 4096);if (n < 0) { return -1; }if (n == 0) { return total; }
        if (n > len(destino) - total) { return -1; }
        for (let i: int = 0; i < n; i += 1) { destino[total + i] = bloco[i]; }total += n;
    }
}

/// Escrita completa com tratamento de operações parciais. -1 em falha.
public safe fn write_all(borrow mut arquivo: File, borrow data: *byte, size: int): int {
    if (size < 0 || size > len(data)) { return -1; }
    own bloco: *byte = alloc<byte>(4096);let total: int = 0;
    while (total < size) {
        let n: int = size - total;if (n > 4096) { n = 4096; }
        for (let i: int = 0; i < n; i += 1) { bloco[i] = data[total + i]; }
        val escritos: int = file_write(arquivo, bloco, n);if (escritos <= 0) { return -1; }total += escritos;
    }
    return total;
}

/// Saída binária completa em stdout (1) ou stderr (2), incluindo NUL.
public safe fn write_output(canal: int, borrow data: *byte, size: int): int {
    if (size < 0 || size > len(data) || (canal != 1 && canal != 2)) { return -1; }
    own bloco: *byte = alloc<byte>(4096);let total: int = 0;
    while (total < size) {
        let n: int = size - total;if (n > 4096) { n = 4096; }
        for (let i: int = 0; i < n; i += 1) { bloco[i] = data[total + i]; }
        val escritos: int = write_bytes(canal, bloco, n);if (escritos <= 0) { return -1; }total += escritos;
    }
    return total;
}

/// Leitor exclusivo de stdin, com leitura antecipada de até 4096 bytes.
/// Construa uma vez, com o limite de bytes por linha, e reutilize a instância.
public final class Stdin {
    private own chunk: *byte;
    private own content: *byte;
    private let limit: int;
    private let setup_error: int;
    private let cursor: int;
    private let available: int;
    private let count: int;
    private let eof: bool;

    fn init(borrow mut self, limit: int): void {
        if (limit < 0 || limit == 0x7fff_ffff_ffff_ffff) { self.setup_error = 7; return; }
        self.limit = limit;
        self.chunk = try_alloc<byte>(4096);
        self.content = try_alloc<byte>(limit + 1);
        if (self.chunk == null || self.content == null) { self.setup_error = 4; }
    }

    /// Linha lida com sucesso em readln, válida até a próxima leitura.
    fn line(borrow self): borrow(self) slice<byte> {
        return slice_of(self.content, 0, self.count);
    }

    /// Retorna o número de bytes da linha UTF-8, incluindo NUL, sem LF/CRLF.
    /// 5 EOF, 6 IO, 7 limite inválido/excedido. Uma linha longa é descartada.
    fn readln(borrow mut self): parse::Parsed<int> {
        self.count = 0;
        if (self.setup_error != 0) { return parse::failure::<int>(0, self.setup_error, -1); }
        let size: int = 0;
        let too_long: bool = false;
        let newline: bool = false;
        while (!self.eof) {
            if (self.cursor == self.available) {
                val got: int = read_bytes(self.chunk, 4096);
                if (got < 0) { return parse::failure::<int>(0, 6, -1); }
                if (got == 0) { self.eof = true; break; }
                self.cursor = 0;
                self.available = got;
            }
            val c: byte = self.chunk[self.cursor];
            self.cursor += 1;
            if (c == 10) { newline = true; break; }
            if (size < len(self.content)) { self.content[size] = c; size += 1; }
            else { too_long = true; }
        }
        if (size == 0 && !newline) { return parse::failure::<int>(0, 5, -1); }
        if (newline && size > 0 && self.content[size - 1] == 13) { size -= 1; }
        if (too_long || size > self.limit) { return parse::failure::<int>(0, 7, self.limit); }
        val result: parse::Parsed<int> = parse::parse_text(slice_of(self.content, 0, size));
        if (result.ok) { self.count = size; }
        return result;
    }

    fn readint(borrow mut self): parse::Parsed<int> {
        val line: parse::Parsed<int> = self.readln();
        if (!line.ok) { return line; }
        return parse::parse_i64(self.line());
    }

    fn readfloat(borrow mut self): parse::Parsed<f64> {
        val line: parse::Parsed<int> = self.readln();
        if (!line.ok) { return parse::failure::<f64>(0.0, line.code, line.position); }
        return parse::parse_f64(self.line());
    }

    fn readbool(borrow mut self): parse::Parsed<bool> {
        val line: parse::Parsed<int> = self.readln();
        if (!line.ok) { return parse::failure::<bool>(false, line.code, line.position); }
        return parse::parse_bool(self.line());
    }
}
