namespace cli;

public struct Argument { let ok: bool; own data: *byte; let size: int; }
public value struct ParsedInt { let ok: bool; let value: int; let position: int; }

/// Cópia independente de argumento Unicode, com comprimento e NUL final.
public safe fn argument(indice: int): own Argument {
    val n: int = arg_size(indice);
    if (n < 0 || n == 0x7fff_ffff_ffff_ffff) { return new Argument(false, alloc<byte>(0), 0); }
    own data: *byte = alloc<byte>(n + 1);
    if (arg_copy(indice, data, n + 1) != n) { return new Argument(false, alloc<byte>(0), 0); }
    return new Argument(true, move(data), n);
}

/// Decimal int64 estrito sobre bytes; não depende de terminador ou text C.
public safe fn parse_integer(borrow data: *byte, size: int): ParsedInt {
    if (size <= 0 || size > len(data)) { return new ParsedInt(false, 0, 0); }
    let i: int = 0;let negativo: bool = false;
    if (data[0] == 45 || data[0] == 43) { negativo = data[0] == 45;i = 1; }
    if (i == size) { return new ParsedInt(false, 0, i); }
    let limite: int = -0x7fff_ffff_ffff_ffff;
    if (negativo) { limite = -0x8000_0000_0000_0000; }
    let value: int = 0;
    while (i < size) {
        val c: int = int(data[i]);if (c < 48 || c > 57) { return new ParsedInt(false, 0, i); }
        val d: int = c - 48;
        if (value < limite / 10) { return new ParsedInt(false, 0, i); }
        value *= 10;if (value < limite + d) { return new ParsedInt(false, 0, i); }value -= d;i += 1;
    }
    if (!negativo) { value = -value; }return new ParsedInt(true, value, size);
}

/// Lê até EOF; retorna -1 em falha ou se o arquivo exceder a capacidade.
/// Capacidade zero aceita somente arquivo vazio. Memória auxiliar: 4096 bytes.
public safe fn read_bounded(borrow mut arquivo: File, borrow mut destino: *byte): int {
    own bloco: *byte = alloc<byte>(4096);let total: int = 0;
    while (true) {
        val n: int = file_read(arquivo, bloco, 4096);if (n < 0) { return -1; }if (n == 0) { return total; }
        if (n > len(destino) - total) { return -1; }
        for (let i: int = 0; i < n; i += 1) { destino[total + i] = bloco[i]; }total += n;
    }
}

/// Escrita completa com tratamento de operações parciais. -1 em falha.
public safe fn write_all(borrow mut arquivo: File, borrow data: *byte, size: int): int {
    if (size < 0 || size > len(data)) { return -1; }
    own bloco: *byte = alloc<byte>(4096);let total: int = 0;
    while (total < size) {
        let n: int = size - total;if (n > 4096) { n = 4096; }
        for (let i: int = 0; i < n; i += 1) { bloco[i] = data[total + i]; }
        val escritos: int = file_write(arquivo, bloco, n);if (escritos <= 0) { return -1; }total += escritos;
    }
    return total;
}

/// Saída binária completa em stdout (1) ou stderr (2), incluindo NUL.
public safe fn saida(canal: int, borrow data: *byte, size: int): int {
    if (size < 0 || size > len(data) || (canal != 1 && canal != 2)) { return -1; }
    own bloco: *byte = alloc<byte>(4096);let total: int = 0;
    while (total < size) {
        let n: int = size - total;if (n > 4096) { n = 4096; }
        for (let i: int = 0; i < n; i += 1) { bloco[i] = data[total + i]; }
        val escritos: int = write_bytes(canal, bloco, n);if (escritos <= 0) { return -1; }total += escritos;
    }
    return total;
}
