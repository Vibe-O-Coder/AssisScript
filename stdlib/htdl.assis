    private fn invalid(borrow mut self,borrow t:doctree::Tree,n:doctree::NodeId,code:int):void{self.fail(code,span_start(t,n),span_end(t,n));}
    private fn validate(borrow mut self,borrow t:doctree::Tree,n:doctree::NodeId,parent_kind:int):void{
