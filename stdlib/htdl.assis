                val body_child:bool=ck==5 || ck==6 || ck==8 || ck==9 || (ck>=12 && ck<=18) || (ck>=20 && ck<=23);
                if((k==1 && !((elements==1 && ck==2) || (elements==2 && ck==4))) ||
