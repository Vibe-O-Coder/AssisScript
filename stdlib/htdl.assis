    private fn sift(borrow mut self,borrow t:doctree::Tree,start:int,count:int):void{
        let root:int=start;
        while(root*2+1<count){let child:int=root*2+1;
            if(child+1<count && self.compare_id(t,self.ids[child],self.ids[child+1])<0){child++;}
            if(self.compare_id(t,self.ids[root],self.ids[child])>=0){return;}
            val v:int=self.ids[root];self.ids[root]=self.ids[child];self.ids[child]=v;root=child;
        }
    }
    private fn check_ids(borrow mut self,borrow t:doctree::Tree):void{
        // Heapsort gives O(n log n) comparisons without hash-collision attacks.
        for(let i:int=self.id_count/2-1;i>=0;i--){self.sift(t,i,self.id_count);}
        for(let end:int=self.id_count-1;end>0;end--){val v:int=self.ids[0];self.ids[0]=self.ids[end];self.ids[end]=v;self.sift(t,0,end);}
        let duplicate:int=-1;let i:int=0;
        while(i<self.id_count){
            let first:int=self.ids[i];let second:int=-1;let j:int=i+1;
            while(j<self.id_count && self.compare_id(t,self.ids[i],self.ids[j])==0){
                val slot:int=self.ids[j];
                if(slot<first){second=first;first=slot;}
                else if(second<0 || slot<second){second=slot;}j++;
            }
            if(second>=0 && (duplicate<0 || second<duplicate)){duplicate=second;}i=j;
        }
        if(duplicate>=0){self.invalid(t,new doctree::NodeId(t.root().instance,duplicate,1),205);}
