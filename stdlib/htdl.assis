namespace htdl;
import "std/documents.assis";

/// Versioned bootstrap and static-catalog-0.1-v1; codes are suffixes of Hxxx.
public value struct Diagnostic{
    let code:int;let start:int;let end:int;
    let line:int;let column:int;let end_line:int;let end_column:int;
}
public value struct Position{let line:int;let column:int;}
/// Caller-owned editor output, capped at 64 copied diagnostics. No tree/source escapes.
public final class Diagnostics{
    private own words:*int;private let capacity:int;private let count:int;private let overflow:bool;
    fn init(borrow mut self,capacity:int):void{
        if(capacity<1 || capacity>64){return;}self.words=try_alloc<int>(capacity*7);
        if(self.words!=null){self.capacity=capacity;}
    }
    fn is_ready(borrow self):bool{return self.words!=null;}
    fn size(borrow self):int{return self.count;}
    fn truncated(borrow self):bool{return self.overflow;}
    fn reset(borrow mut self):void{self.count=0;self.overflow=false;}
    fn add(borrow mut self,d:Diagnostic):void{
        for(let i:int=0;i<self.count;i++){val p:int=i*7;
            if(self.words[p]==d.code && self.words[p+1]==d.start && self.words[p+2]==d.end){return;}}
        if(self.count==self.capacity){self.overflow=true;return;}
        val p:int=self.count*7;self.words[p]=d.code;self.words[p+1]=d.start;self.words[p+2]=d.end;
        self.words[p+3]=d.line;self.words[p+4]=d.column;self.words[p+5]=d.end_line;self.words[p+6]=d.end_column;self.count++;
    }
    fn get(borrow self,index:int):Diagnostic{
        assert(index>=0 && index<self.count);val p:int=index*7;
        return new Diagnostic(self.words[p],self.words[p+1],self.words[p+2],self.words[p+3],self.words[p+4],self.words[p+5],self.words[p+6]);
    }
}
public pure fn space(c:int):bool{return c==32 || c==9 || c==10 || c==13;}
pure fn letter(c:int):bool{return (c>=65 && c<=90) || (c>=97 && c<=122);}
pure fn digit(c:int):bool{return c>=48 && c<=57;}
pure fn name_char(c:int):bool{return letter(c) || digit(c) || c==45 || c==58 || c==95;}
pure fn identifier_start(c:int):bool{return letter(c) || c==95;}
pure fn identifier_char(c:int):bool{return identifier_start(c) || digit(c) || c==45;}
pure fn scalar(c:int):bool{return c>0 && c<=1114111 && !(c>=55296 && c<=57343) && (c>=32 || c==9 || c==10 || c==13);}
safe fn equal_source(borrow s:slice<byte>,start:int,end:int,borrow value:slice<byte>):bool{
    if(end-start!=len(value)){return false;}
    for(let i:int=0;i<len(value);i++){if(s[start+i]!=value[i]){return false;}}return true;
}
public safe fn position(borrow source:slice<byte>,offset:int):Position{
    let line:int=1;let column:int=1;let i:int=0;
    while(i<offset && i<len(source)){
        val c:int=int(source[i]);
        if(c==13){line++;column=1;i++;if(i<offset && source[i]==10){i++;}}
        else if(c==10){line++;column=1;i++;}
        else if(c<128){column++;i++;}
        else if(c>=192){if(c>=240){column+=2;i+=4;}else if(c>=224){column++;i+=3;}else{column++;i+=2;}}
        else{column++;i++;}
    }
    return new Position(line,column);
}
safe fn diagnostic(borrow s:slice<byte>,code:int,start:int,end:int):Diagnostic{
    let first:int=start;let last:int=end;
    if(first>len(s)){first=len(s);}if(last>len(s)){last=len(s);}if(last<first){last=first;}
    val a:Position=position(s,first);val b:Position=position(s,last);
    return new Diagnostic(code,first,last,a.line,a.column,b.line,b.column);
}

/// Internal tree encoding: element=1, character data=2, attribute=100+key.
/// Payload starts with two eight-digit hexadecimal source offsets, then UTF-8.
public safe fn span_start(borrow tree:doctree::Tree,id:doctree::NodeId):int{
    let result:int=0;for(let i:int=0;i<8;i++){val c:int=int(tree.text_byte(id,i));result=result*16+c-48;}return result;
}
public safe fn span_end(borrow tree:doctree::Tree,id:doctree::NodeId):int{
    let result:int=0;for(let i:int=8;i<16;i++){val c:int=int(tree.text_byte(id,i));result=result*16+c-48;}return result;
}
public safe fn value_size(borrow tree:doctree::Tree,id:doctree::NodeId):int{return tree.text_size(id)-16;}
public safe fn value_byte(borrow tree:doctree::Tree,id:doctree::NodeId,index:int):byte{
    assert(index>=0 && index<value_size(tree,id));return tree.text_byte(id,index+16);
}
public safe fn value_equals(borrow tree:doctree::Tree,id:doctree::NodeId,borrow value:slice<byte>):bool{
    if(doctree::absent(id) || value_size(tree,id)!=len(value)){return false;}
    for(let i:int=0;i<len(value);i++){if(value_byte(tree,id,i)!=value[i]){return false;}}return true;
}
/// Fixed attribute keys 1..30: see PERFIL-HTDL-CATALOGO-V1.md. Dynamic data-*
/// records use kind=200 and data_attribute, never an ambiguous numeric lookup.
public safe fn attribute(borrow tree:doctree::Tree,node:doctree::NodeId,key:int):doctree::NodeId{
    if(key<1 || key>30){return new doctree::NodeId();}
    let child:doctree::NodeId=tree.first_child(node);
    while(!doctree::absent(child)){if(tree.kind(child)==100+key){return child;}child=tree.next_sibling(child);}
    return new doctree::NodeId();
}
/// Dynamic data-* attributes keep their original name span and decoded value.
public safe fn data_attribute(borrow document:documents::Document,node:doctree::NodeId,borrow name:slice<byte>):doctree::NodeId{
    if(!document.is_open() || !document.nodes().contains(node)){return new doctree::NodeId();}
    let a:doctree::NodeId=document.nodes().first_child(node);
    while(!doctree::absent(a)){
        if(document.nodes().kind(a)==200){val start:int=span_start(document.nodes(),a);let end:int=start;
            while(end<document.source_size() && name_char(int(document.source_byte(end)))){end++;}
            if(end-start==len(name)){let same:bool=true;
                for(let i:int=0;i<len(name);i++){if(document.source_byte(start+i)!=name[i]){same=false;break;}}
                if(same){return a;}}}
        a=document.nodes().next_sibling(a);
    }return new doctree::NodeId();
}
/// Semantic types: document=1, head=2, title=3, body=4, container=5,
/// paragraph=6, text=7, heading=8, button=9; catalog extends 10..23 without
/// renumbering bootstrap IDs. 0 denotes an unknown type or non-element.
public safe fn kind(borrow tree:doctree::Tree,node:doctree::NodeId):int{
    if(tree.kind(node)!=1){return 0;}val t:doctree::NodeId=attribute(tree,node,1);
    if(value_equals(tree,t,utf8("document"))){return 1;}if(value_equals(tree,t,utf8("head"))){return 2;}
    if(value_equals(tree,t,utf8("title"))){return 3;}if(value_equals(tree,t,utf8("body"))){return 4;}
    if(value_equals(tree,t,utf8("container"))){return 5;}if(value_equals(tree,t,utf8("paragraph"))){return 6;}
    if(value_equals(tree,t,utf8("text"))){return 7;}if(value_equals(tree,t,utf8("heading"))){return 8;}
    if(value_equals(tree,t,utf8("button"))){return 9;}
    if(value_equals(tree,t,utf8("meta"))){return 10;}if(value_equals(tree,t,utf8("script"))){return 11;}
    if(value_equals(tree,t,utf8("main"))){return 12;}if(value_equals(tree,t,utf8("section"))){return 13;}
    if(value_equals(tree,t,utf8("header"))){return 14;}if(value_equals(tree,t,utf8("footer"))){return 15;}
    if(value_equals(tree,t,utf8("nav"))){return 16;}if(value_equals(tree,t,utf8("link"))){return 17;}
    if(value_equals(tree,t,utf8("list"))){return 18;}if(value_equals(tree,t,utf8("item"))){return 19;}
    if(value_equals(tree,t,utf8("label"))){return 20;}if(value_equals(tree,t,utf8("input"))){return 21;}
    if(value_equals(tree,t,utf8("form"))){return 22;}if(value_equals(tree,t,utf8("image"))){return 23;}return 0;
}
public safe fn first_element(borrow tree:doctree::Tree,node:doctree::NodeId):doctree::NodeId{
    let c:doctree::NodeId=tree.first_child(node);
    while(!doctree::absent(c)){if(tree.kind(c)==1){return c;}c=tree.next_sibling(c);}return c;
}
public safe fn next_element(borrow tree:doctree::Tree,node:doctree::NodeId):doctree::NodeId{
    let c:doctree::NodeId=tree.next_sibling(node);
    while(!doctree::absent(c)){if(tree.kind(c)==1){return c;}c=tree.next_sibling(c);}return c;
}
safe fn next_node(borrow tree:doctree::Tree,node:doctree::NodeId):doctree::NodeId{
    val child:doctree::NodeId=tree.first_child(node);if(!doctree::absent(child)){return child;}
    let n:doctree::NodeId=node;
    while(!doctree::absent(n)){val sibling:doctree::NodeId=tree.next_sibling(n);if(!doctree::absent(sibling)){return sibling;}n=tree.parent(n);}
    return new doctree::NodeId();
}
/// Local, read-only query; source IDs are not authorization capabilities.
public safe fn find_id(borrow tree:doctree::Tree,borrow id:slice<byte>):doctree::NodeId{
    let n:doctree::NodeId=tree.root();
    while(!doctree::absent(n)){if(tree.kind(n)==1 && value_equals(tree,attribute(tree,n,5),id)){return n;}n=next_node(tree,n);}
    return new doctree::NodeId();
}
/// Ordered local selector: semantic type (0=any), one exact normalized class
/// token (empty=any), and an optional live cursor. No CSS or authority lookup.
public safe fn query(borrow tree:doctree::Tree,type_id:int,borrow token:slice<byte>,after:doctree::NodeId):doctree::NodeId{
    if(type_id<0 || type_id>23 || len(token)>65536){return new doctree::NodeId();}
    for(let i:int=0;i<len(token);i++){if(space(int(token[i]))){return new doctree::NodeId();}}
    let n:doctree::NodeId=tree.root();
    if(!doctree::absent(after)){if(!tree.contains(after)){return new doctree::NodeId();}n=next_node(tree,after);}
    let work:int=0;
    while(!doctree::absent(n)){
        if(tree.kind(n)==1 && (type_id==0 || kind(tree,n)==type_id)){
            if(len(token)==0){return n;}
            val a:doctree::NodeId=attribute(tree,n,6);
            if(!doctree::absent(a)){
                let at:int=0;while(at<value_size(tree,a)){
                    let end:int=at;while(end<value_size(tree,a) && value_byte(tree,a,end)!=32){end++;work++;if(work>8000000){return new doctree::NodeId();}}
                    if(end-at==len(token)){let equal:bool=true;for(let i:int=0;i<len(token);i++){
                        work++;if(work>8000000){return new doctree::NodeId();}
                        if(value_byte(tree,a,at+i)!=token[i]){equal=false;break;}}
                        if(equal){return n;}}
                    at=end+1;
                }
            }
        }n=next_node(tree,n);
    }return new doctree::NodeId();
}

/// Parser temporary storage is reserved before allocation and never escapes.
final class Parser{
    private own scratch:*byte;
    private own ids:*int;
    private let cursor:int;private let used:int;private let code:int;
    private let first:int;private let last:int;private let nodes:int;
    private let id_count:int;private let work:int;private let ready:bool;

    fn init(borrow mut self,capacity:int,id_capacity:int):void{
        self.scratch=try_alloc<byte>(capacity);if(self.scratch==null){return;}
        self.ids=try_alloc<int>(id_capacity);if(self.ids==null){return;}self.ready=true;
    }
    private fn fail(borrow mut self,code:int,start:int,end:int):void{
        if(self.code==0){self.code=code;self.first=start;self.last=end;}
    }
    private fn prefix(borrow mut self,start:int,end:int):void{
        let a:int=start;let b:int=end;
        // Digits 0..15 are encoded as ASCII 48..63 (internal, never source).
        for(let i:int=7;i>=0;i--){self.scratch[i]=byte(48+a%16);a/=16;self.scratch[i+8]=byte(48+b%16);b/=16;}
    }
    private fn append(borrow mut self,borrow mut d:documents::Document,parent:doctree::NodeId,kind:int,start:int,end:int):doctree::NodeId{
        if(kind<100){if(self.nodes>=20000){self.fail(401,start,end);return new doctree::NodeId();}self.nodes++;}
        self.prefix(start,end);
        val r:doctree::Append=d.try_append(parent,kind,slice_of(self.scratch,0,self.used));
        match(r){Appended(id){return id;}Rejected(code){self.fail(401,start,end);return new doctree::NodeId();}}
    }
    private fn emit_scalar(borrow mut self,value:int):void{
        if(value<128){self.scratch[self.used]=byte(value);self.used++;}
        else if(value<2048){self.scratch[self.used]=byte(192+value/64);self.scratch[self.used+1]=byte(128+value%64);self.used+=2;}
        else if(value<65536){self.scratch[self.used]=byte(224+value/4096);self.scratch[self.used+1]=byte(128+(value/64)%64);self.scratch[self.used+2]=byte(128+value%64);self.used+=3;}
        else{self.scratch[self.used]=byte(240+value/262144);self.scratch[self.used+1]=byte(128+(value/4096)%64);self.scratch[self.used+2]=byte(128+(value/64)%64);self.scratch[self.used+3]=byte(128+value%64);self.used+=4;}
    }
    private fn entity(borrow mut self,borrow source:slice<byte>):void{
        val start:int=self.cursor;self.cursor++;let value:int=-1;
        if(self.cursor<len(source) && source[self.cursor]==35){
            self.cursor++;let base:int=10;
            if(self.cursor<len(source) && source[self.cursor]==120){base=16;self.cursor++;}
            val digits:int=self.cursor;value=0;
            while(self.cursor<len(source) && source[self.cursor]!=59){
                val c:int=int(source[self.cursor]);let n:int=-1;
                if(digit(c)){n=c-48;}else if(base==16 && c>=65 && c<=70){n=c-55;}else if(base==16 && c>=97 && c<=102){n=c-87;}
                if(n<0 || n>=base || value>(1114111-n)/base){self.fail(102,start,self.cursor+1);return;}
                value=value*base+n;self.cursor++;
            }
            if(self.cursor==digits){self.fail(102,start,self.cursor);return;}
        }else{
            val begin:int=self.cursor;
            while(self.cursor<len(source) && letter(int(source[self.cursor]))){self.cursor++;}
            if(equal_source(source,begin,self.cursor,utf8("amp"))){value=38;}
            else if(equal_source(source,begin,self.cursor,utf8("lt"))){value=60;}
            else if(equal_source(source,begin,self.cursor,utf8("gt"))){value=62;}
            else if(equal_source(source,begin,self.cursor,utf8("quot"))){value=34;}
            else if(equal_source(source,begin,self.cursor,utf8("apos"))){value=39;}
        }
        if(self.cursor>=len(source) || source[self.cursor]!=59 || !scalar(value)){
            self.fail(102,start,self.cursor);return;
        }
        self.cursor++;self.emit_scalar(value);
    }
    private fn decode(borrow mut self,borrow source:slice<byte>,quote:int):void{
        self.used=16;
        while(self.cursor<len(source) && self.code==0){
            val c:int=int(source[self.cursor]);
            if((quote>0 && c==quote) || (quote==0 && c==60) || (quote<0 && (space(c) || c==62))){return;}
            if(c==60 || (quote<0 && (c==34 || c==39 || c==96 || c==61 || c==38 || c==47))){self.fail(102,self.cursor,self.cursor+1);return;}
            if(c==38){self.entity(source);}
            else if(c==13){self.scratch[self.used]=byte(10);self.used++;self.cursor++;if(self.cursor<len(source) && source[self.cursor]==10){self.cursor++;}}
            else{self.scratch[self.used]=source[self.cursor];self.used++;self.cursor++;}
            if(quote!=0 && self.used-16>65536){self.fail(401,self.cursor-1,self.cursor);}
        }
    }
    private fn skip_space(borrow mut self,borrow source:slice<byte>):void{
        while(self.cursor<len(source) && space(int(source[self.cursor]))){self.cursor++;}
    }
    private fn starts(borrow self,borrow s:slice<byte>,borrow value:slice<byte>):bool{
        return len(value)<=len(s)-self.cursor && equal_source(s,self.cursor,self.cursor+len(value),value);
    }
    private fn comment(borrow mut self,borrow s:slice<byte>):void{
        val begin:int=self.cursor;self.cursor+=4;
        while(self.cursor<len(s)){
            if(self.starts(s,utf8("-->"))){self.cursor+=3;return;}
            if(self.starts(s,utf8("--"))){self.fail(102,self.cursor,self.cursor+2);return;}self.cursor++;
        }
        self.fail(102,begin,self.cursor);
    }
    private fn key(borrow self,borrow s:slice<byte>,a:int,b:int):int{
        if(equal_source(s,a,b,utf8("type"))){return 1;}if(equal_source(s,a,b,utf8("version"))){return 2;}
        if(equal_source(s,a,b,utf8("lang"))){return 3;}if(equal_source(s,a,b,utf8("level"))){return 4;}
        if(equal_source(s,a,b,utf8("id"))){return 5;}if(equal_source(s,a,b,utf8("class"))){return 6;}
        if(equal_source(s,a,b,utf8("hidden"))){return 7;}if(equal_source(s,a,b,utf8("disabled"))){return 8;}
        if(equal_source(s,a,b,utf8("action"))){return 9;}if(equal_source(s,a,b,utf8("a11y-label"))){return 10;}
        if(equal_source(s,a,b,utf8("name"))){return 11;}
        if(equal_source(s,a,b,utf8("content"))){return 12;}
        if(equal_source(s,a,b,utf8("src"))){return 13;}
        if(equal_source(s,a,b,utf8("format"))){return 14;}
        if(equal_source(s,a,b,utf8("href"))){return 15;}
        if(equal_source(s,a,b,utf8("ordered"))){return 16;}
        if(equal_source(s,a,b,utf8("for"))){return 17;}
        if(equal_source(s,a,b,utf8("kind"))){return 18;}
        if(equal_source(s,a,b,utf8("value"))){return 19;}
        if(equal_source(s,a,b,utf8("placeholder"))){return 20;}
        if(equal_source(s,a,b,utf8("required"))){return 21;}
        if(equal_source(s,a,b,utf8("checked"))){return 22;}
        if(equal_source(s,a,b,utf8("alt"))){return 23;}
        if(equal_source(s,a,b,utf8("a11y-live"))){return 24;}
        if(equal_source(s,a,b,utf8("on:click"))){return 25;}
        if(equal_source(s,a,b,utf8("on:input"))){return 26;}
        if(equal_source(s,a,b,utf8("on:change"))){return 27;}
        if(equal_source(s,a,b,utf8("on:submit"))){return 28;}
        if(equal_source(s,a,b,utf8("on:focus"))){return 29;}
        if(equal_source(s,a,b,utf8("on:blur"))){return 30;}
        if(b-a>=6 && s[a]==100 && s[a+1]==97 && s[a+2]==116 && s[a+3]==97 && s[a+4]==45){
            if(s[a+5]<97 || s[a+5]>122){return 0;}
            for(let i:int=a+6;i<b;i++){val c:int=int(s[i]);if(!(c>=97 && c<=122) && !digit(c) && c!=45){return 0;}}
            return 100;
        }return 0;
    }
    private fn classes(borrow mut self,start:int,end:int):void{
        let read:int=16;let write:int=16;
        while(read<self.used && self.code==0){
            while(read<self.used && space(int(self.scratch[read]))){read++;}if(read==self.used){break;}
            val begin:int=read;
            if(!identifier_start(int(self.scratch[read]))){self.fail(206,start,end);return;}read++;
            while(read<self.used && !space(int(self.scratch[read]))){
                if(!identifier_char(int(self.scratch[read]))){self.fail(206,start,end);return;}read++;
            }
            let previous:int=16;let duplicate:bool=false;
            while(previous<write){
                self.work++;if(self.work>8000000){self.fail(401,start,end);return;}
                let stop:int=previous;while(stop<write && self.scratch[stop]!=32){
                    stop++;self.work++;if(self.work>8000000){self.fail(401,start,end);return;}}
                if(stop-previous==read-begin){let same:bool=true;for(let i:int=0;i<read-begin;i++){
                    self.work++;if(self.work>8000000){self.fail(401,start,end);return;}
                    if(self.scratch[previous+i]!=self.scratch[begin+i]){same=false;break;}
                }if(same){duplicate=true;break;}}previous=stop+1;
            }
            if(!duplicate){if(write>16){self.scratch[write]=byte(32);write++;}
                for(let i:int=begin;i<read;i++){self.scratch[write]=self.scratch[i];write++;}}
        }
        self.used=write;
    }
    private fn opening(borrow mut self,borrow mut d:documents::Document,borrow s:slice<byte>,parent:doctree::NodeId,catalog:bool):doctree::NodeId{
        val begin:int=self.cursor;
        if(!self.starts(s,utf8("<div"))){self.fail(102,begin,begin+1);return new doctree::NodeId();}
        self.cursor+=4;
        if(self.cursor==len(s) || (!space(int(s[self.cursor])) && s[self.cursor]!=62)){self.fail(102,begin,self.cursor);return new doctree::NodeId();}
        self.used=16;val node:doctree::NodeId=self.append(d,parent,1,begin,begin);
        let attrs:int=0;
        while(self.code==0 && self.cursor<len(s) && s[self.cursor]!=62){
            val before:int=self.cursor;self.skip_space(s);
            if(self.cursor<len(s) && s[self.cursor]==62){break;}
            if(before==self.cursor || self.cursor==len(s) || !letter(int(s[self.cursor]))){self.fail(102,self.cursor,self.cursor);break;}
            val a:int=self.cursor;self.cursor++;
            while(self.cursor<len(s) && name_char(int(s[self.cursor]))){self.cursor++;}
            val name_end:int=self.cursor;val k:int=self.key(s,a,name_end);self.skip_space(s);
            if(self.cursor==len(s) || s[self.cursor]!=61){self.fail(102,a,self.cursor);break;}self.cursor++;self.skip_space(s);
            if(self.cursor==len(s)){self.fail(102,a,self.cursor);break;}
            let quote:int=-1;if(s[self.cursor]==34 || s[self.cursor]==39){quote=int(s[self.cursor]);self.cursor++;}
            val value_start:int=self.cursor;self.decode(s,quote);
            if(self.code!=0){break;}
            if(quote>0){if(self.cursor==len(s)){self.fail(102,a,self.cursor);break;}self.cursor++;}
            else if(self.cursor==value_start){self.fail(102,a,self.cursor);break;}
            attrs++;if(attrs>64){self.fail(401,a,self.cursor);break;}
            if(k==0 || (!catalog && k>10)){self.fail(203,a,self.cursor);break;}
            if(k==100){
                let previous:doctree::NodeId=d.nodes().first_child(node);
                while(!doctree::absent(previous)){
                    if(d.nodes().kind(previous)==200){val start:int=span_start(d.nodes(),previous);let stop:int=start;
                        while(stop<len(s) && name_char(int(s[stop]))){stop++;}
