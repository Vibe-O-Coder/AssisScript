    private fn parse_tree(borrow mut self,borrow mut d:documents::Document,borrow s:slice<byte>,catalog:bool):void{
        if(!self.ready){self.fail(401,0,0);return;}
        if(len(s)>=3 && s[0]==239 && s[1]==187 && s[2]==191){self.cursor=3;}
        while(self.code==0){self.skip_space(s);if(self.starts(s,utf8("<!--"))){self.comment(s);}else{break;}}
        if(self.code==0){
            let node:doctree::NodeId=self.opening(d,s,new doctree::NodeId(),catalog);let depth:int=1;
            while(self.code==0 && depth>0 && self.cursor<len(s)){
                if(self.starts(s,utf8("</div>"))){
                    self.cursor+=6;val start:int=span_start(d.nodes(),node);self.prefix(start,self.cursor);
                    if(!d.try_set_text(node,slice_of(self.scratch,0,16))){self.fail(401,start,self.cursor);}
                    node=d.nodes().parent(node);depth--;
                }else if(self.starts(s,utf8("<!--"))){self.comment(s);}
                else if(s[self.cursor]==60){
                    if(depth>=256){self.fail(401,self.cursor,self.cursor);}
                    else{node=self.opening(d,s,node,catalog);depth++;}
                }else{val start:int=self.cursor;self.decode(s,0);if(self.code==0){self.append(d,node,2,start,self.cursor);}}
            }
            if(self.code==0 && depth!=0){self.fail(102,span_start(d.nodes(),node),self.cursor);}
        }
        while(self.code==0){self.skip_space(s);if(self.starts(s,utf8("<!--"))){self.comment(s);}else{break;}}
        if(self.code==0 && self.cursor!=len(s)){self.fail(102,self.cursor,self.cursor+1);}
    }
    fn run(borrow mut self,borrow mut d:documents::Document,borrow s:slice<byte>,catalog:bool):Diagnostic{
        self.parse_tree(d,s,catalog);
        if(self.code==0){
            let node:doctree::NodeId=d.nodes().root();
            while(self.code==0 && !doctree::absent(node)){
                if(d.nodes().kind(node)==1){val parent:doctree::NodeId=d.nodes().parent(node);let pk:int=0;
                    if(!doctree::absent(parent)){pk=kind(d.nodes(),parent);}if(catalog){self.validate_catalog(d.nodes(),node,pk);}else{self.validate(d.nodes(),node,pk);}}
                node=next_node(d.nodes(),node);
            }
        }
        if(self.code==0){self.check_ids(d.nodes());}
        if(self.code==0 && catalog){
            let node:doctree::NodeId=d.nodes().root();while(self.code==0 && !doctree::absent(node)){
                if(d.nodes().kind(node)==1){self.references(d.nodes(),node);}node=next_node(d.nodes(),node);}}
