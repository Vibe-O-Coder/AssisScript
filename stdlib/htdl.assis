                    (k==8 && key==4) || ((k==9 || k==21) && key==8) || (k==9 && key==9) ||
                    ((interactive || k==13 || k==16 || k==22) && key==10) ||
                    ((k==10 || k==21) && key==11) || (k==10 && key==12) || ((k==11 || k==23) && key==13) ||
                    (k==11 && key==14) || (k==17 && key==15) || (k==18 && key==16) || (k==20 && key==17) ||
                    (k==21 && key>=18 && key<=22) || (k==23 && key==23) ||
                    ((k==6 || k==5 || k==13) && key==24) || ((k==9 || k==17) && key==25) ||
