    private fn compare_id(borrow self,borrow t:doctree::Tree,a:int,b:int):int{
        val x:doctree::NodeId=new doctree::NodeId(t.root().instance,a,1);
        val y:doctree::NodeId=new doctree::NodeId(t.root().instance,b,1);
        let size:int=value_size(t,x);if(value_size(t,y)<size){size=value_size(t,y);}
        for(let i:int=0;i<size;i++){val d:int=int(value_byte(t,x,i))-int(value_byte(t,y,i));if(d!=0){return d;}}
        return value_size(t,x)-value_size(t,y);
