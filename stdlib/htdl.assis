                if(k==20 && self.same_value(t,target,attribute(t,p,5))){if(pk!=21){self.invalid(t,n,207);return;}found=true;}
                if(needs_label && pk==20 && self.same_value(t,id,attribute(t,p,17))){labelled=true;}
                if(check_name && pk==21 && p.slot<n.slot && self.same_value(t,name,attribute(t,p,11))){
                    val other:doctree::NodeId=self.ancestor(t,p,22);if(other.instance==form.instance && other.slot==form.slot){self.invalid(t,name,205);return;}}
