                if(!allowed){self.invalid(t,a,203);return;}
                if((key==7 || key==8) && !value_equals(t,a,utf8("true")) && !value_equals(t,a,utf8("false"))){self.invalid(t,a,206);return;}
                if(key==9 && !value_equals(t,a,utf8("button"))){self.invalid(t,a,206);return;}
