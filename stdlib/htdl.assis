    }
    /// Editor synchronization never invents bytes or exports the partial tree.
    /// It stops before '<', so a missing quote/terminator cannot swallow the
    /// next sibling. A broken comment instead consumes to its own terminator.
    private fn synchronize(borrow mut self,borrow s:slice<byte>,comment:bool):void{
        while(self.cursor<len(s)){
            if(comment){if(self.starts(s,utf8("-->"))){self.cursor+=3;return;}}
            else{if(s[self.cursor]==60){return;}if(s[self.cursor]==62){self.cursor++;return;}}
            self.cursor++;
        }
    }
    private fn report(borrow mut self,borrow s:slice<byte>,borrow mut output:Diagnostics):bool{
        if(self.code==0){return true;}
        output.add(diagnostic(s,self.code,self.first,self.last));
        if(self.code==401 || output.truncated()){return false;}self.code=0;return true;
    }
    private fn parse_editor(borrow mut self,borrow mut d:documents::Document,borrow s:slice<byte>,borrow mut output:Diagnostics):void{
        if(!self.ready){output.add(diagnostic(s,401,0,0));return;}
        if(len(s)>=3 && s[0]==239 && s[1]==187 && s[2]==191){self.cursor=3;}
        let node:doctree::NodeId=new doctree::NodeId();let depth:int=0;
        while(self.cursor<len(s) && !output.truncated()){
            val before:int=self.cursor;
            if(self.starts(s,utf8("<!--"))){
                self.comment(s);if(self.code!=0){if(!self.report(s,output)){return;}self.synchronize(s,true);}
            }else if(self.starts(s,utf8("</div>"))){
                self.cursor+=6;
                if(depth==0){output.add(diagnostic(s,102,before,self.cursor));}
                else{val start:int=span_start(d.nodes(),node);self.prefix(start,self.cursor);
                    if(!d.try_set_text(node,slice_of(self.scratch,0,16))){output.add(diagnostic(s,401,start,self.cursor));return;}
                    node=d.nodes().parent(node);depth--;}
            }else if(s[self.cursor]==60){
                if(depth>=256){output.add(diagnostic(s,401,before,before));return;}
                if(depth==0 && !doctree::absent(d.nodes().root())){
                    // Multiple roots are ambiguous: retain the first diagnostic,
                    // do not turn a second root into a fictitious child.
                    output.add(diagnostic(s,102,before,before+1));return;
                }
                val child:doctree::NodeId=self.opening(d,s,node,true);
                if(!doctree::absent(child)){node=child;depth++;}
                if(self.code!=0){if(!self.report(s,output)){return;}
                    if(self.cursor==before){self.cursor++;}self.synchronize(s,false);}
            }else if(depth==0){
                self.skip_space(s);
                if(self.cursor==before){self.fail(102,before,before+1);if(!self.report(s,output)){return;}
                    while(self.cursor<len(s) && s[self.cursor]!=60){self.cursor++;}}
            }else{
                self.decode(s,0);
                if(self.code==0){self.append(d,node,2,before,self.cursor);if(!self.report(s,output)){return;}}
                else{if(!self.report(s,output)){return;}
                    // An invalid entity does not hide the rest of this text.
                    // Consuming one offending byte guarantees forward progress.
                    if(self.cursor<len(s) && s[self.cursor]!=60){self.cursor++;}}
            }
            if(self.cursor<=before){output.add(diagnostic(s,102,before,before+1));self.cursor=before+1;}
        }
        if(depth!=0 && !output.truncated()){output.add(diagnostic(s,102,span_start(d.nodes(),node),self.cursor));}
        if(doctree::absent(d.nodes().root()) && output.size()==0){output.add(diagnostic(s,102,self.cursor,self.cursor));}
    }
    fn analyze(borrow mut self,borrow mut d:documents::Document,borrow s:slice<byte>,borrow mut output:Diagnostics):void{
        self.parse_editor(d,s,output);
        // Syntax-damaged trees have no semantic meaning. They are always aborted.
        if(output.size()!=0){return;}
        let node:doctree::NodeId=d.nodes().root();
        while(!doctree::absent(node) && !output.truncated()){
            if(d.nodes().kind(node)==1){
                self.code=0;val parent:doctree::NodeId=d.nodes().parent(node);let pk:int=0;
                if(!doctree::absent(parent)){pk=kind(d.nodes(),parent);}
                self.validate_catalog(d.nodes(),node,pk);
                if(self.code!=0){output.add(diagnostic(s,self.code,self.first,self.last));if(self.code==401){return;}}
            }node=next_node(d.nodes(),node);
        }
        self.code=0;self.check_ids(d.nodes());if(self.code!=0){output.add(diagnostic(s,self.code,self.first,self.last));}
        node=d.nodes().root();
        while(!doctree::absent(node) && !output.truncated()){
            if(d.nodes().kind(node)==1){self.code=0;self.references(d.nodes(),node);
                if(self.code!=0){output.add(diagnostic(s,self.code,self.first,self.last));if(self.code==401){return;}}}
            node=next_node(d.nodes(),node);
        }
    }
}

/// Native v1 object body (confirmed against IR allocationBytes by the suite).
public pure fn parser_bytes():int{return 96;}
public safe fn workspace_bytes(source_bytes:int):int{
    if(source_bytes<0 || source_bytes>1048576){return -1;}
    let ids:int=source_bytes/11+1;if(ids>20000){ids=20000;}
    return parser_bytes()+source_bytes+16+ids*8;
}
/// Parse/validate before atomic activation. Any failure aborts only our candidate.
/// Store/instance failures use H401; diagnostic spans remain in the input source.
safe fn stage_profile(borrow mut store:documents::Store,instance:int,borrow source:slice<byte>,temporary_bytes:int,catalog:bool):Diagnostic{
    if(len(source)>1048576){return diagnostic(source,401,0,len(source));}
    val bad:int=unicode::error(source);if(bad>=0){return diagnostic(source,101,bad,bad+1);}
    for(let i:int=0;i<len(source);i++){val c:int=int(source[i]);if(c<32 && c!=9 && c!=10 && c!=13){return diagnostic(source,101,i,i+1);}}
    if(temporary_bytes<0 || temporary_bytes>2097152){return diagnostic(source,401,0,0);}
    val reserved:int=workspace_bytes(len(source))+temporary_bytes;
    val begin:int=store.begin_reserved(instance,source,reserved);
    if(begin!=0){return diagnostic(source,401,0,0);}
    let result:Diagnostic=new Diagnostic();
    {
        let ids:int=len(source)/11+1;if(ids>20000){ids=20000;}
        own parser:Parser=try_new Parser(len(source)+16,ids);
        if(parser==null){result=diagnostic(source,401,0,0);}
        else{borrow mut d:documents::Document=store.candidate();result=parser.run(d,source,catalog);}
    }
    if(result.code!=0){assert(store.abort(instance));return result;}
    return result;
}

/// Frozen bootstrap entry point, including rejection of unsupported catalog types.
public safe fn stage(borrow mut store:documents::Store,instance:int,borrow source:slice<byte>,temporary_bytes:int):Diagnostic{
    return stage_profile(store,instance,source,temporary_bytes,false);
}
/// Catalog syntax/static semantics only. This grants no resource or execution authority.
public safe fn stage_catalog(borrow mut store:documents::Store,instance:int,borrow source:slice<byte>,temporary_bytes:int):Diagnostic{
    return stage_profile(store,instance,source,temporary_bytes,true);
}
public safe fn load_catalog(borrow mut store:documents::Store,instance:int,borrow source:slice<byte>):Diagnostic{
    val result:Diagnostic=stage_catalog(store,instance,source,0);
    if(result.code==0){assert(store.commit(instance));}return result;
}
/// Editor-only bounded syntax/semantic recovery. ALWAYS aborts its candidate.
/// Output is external caller memory (40+capacity*56 bytes), not document storage.
public safe fn inspect(borrow mut store:documents::Store,instance:int,borrow source:slice<byte>,borrow mut output:Diagnostics):bool{
    output.reset();if(!output.is_ready()){return false;}
    if(len(source)>1048576){output.add(diagnostic(source,401,0,len(source)));return true;}
    val bad:int=unicode::error(source);if(bad>=0){output.add(diagnostic(source,101,bad,bad+1));return true;}
    for(let i:int=0;i<len(source);i++){val c:int=int(source[i]);if(c<32 && c!=9 && c!=10 && c!=13){output.add(diagnostic(source,101,i,i+1));return true;}}
    if(store.begin_reserved(instance,source,workspace_bytes(len(source)))!=0){output.add(diagnostic(source,401,0,0));return true;}
    {
        let ids:int=len(source)/11+1;if(ids>20000){ids=20000;}
        own parser:Parser=try_new Parser(len(source)+16,ids);
        if(parser==null){output.add(diagnostic(source,401,0,0));}
        else{borrow mut d:documents::Document=store.candidate();parser.analyze(d,source,output);}
    }
    assert(store.abort(instance));return true;
}

/// Existing load contract: validate then activate, without exposing a candidate.
public safe fn load(borrow mut store:documents::Store,instance:int,borrow source:slice<byte>):Diagnostic{
    val result:Diagnostic=stage(store,instance,source,0);
    if(result.code==0){assert(store.commit(instance));}return result;
}

/// Bounded source edit. It never mutates a live tree; stage reparses all semantics.
/// The output body is additional temporary storage, reserved by Session::prepare_patch.
public final class Patch{
    private own data:*byte;private let active:bool;private let instance_id:int;
    fn init(borrow mut self,borrow document:documents::Document,start:int,end:int,borrow replacement:slice<byte>):void{
        if(!document.is_open() || start<0 || end<start || end>document.source_size() || len(replacement)>1048576){return;}
        val base:int=document.source_size()-(end-start);
        if(base>1048576-len(replacement)){return;}
        self.data=try_alloc<byte>(base+len(replacement));if(self.data==null){return;}
        for(let i:int=0;i<start;i++){self.data[i]=document.source_byte(i);}
        for(let i:int=0;i<len(replacement);i++){self.data[start+i]=replacement[i];}
        for(let i:int=end;i<document.source_size();i++){self.data[start+len(replacement)+i-end]=document.source_byte(i);}
        if(unicode::error(slice_of(self.data,0,len(self.data)))>=0){return;}
        self.instance_id=document.instance();self.active=true;
    }
    fn is_open(borrow self):bool{return self.active;}
    fn instance(borrow self):int{return self.instance_id;}
    fn source(borrow self):borrow(self) slice<byte>{assert(self.active);return slice_of(self.data,0,len(self.data));}
}
/// Only boolean semantic attributes; missing attributes are inserted after '<div'.
public safe fn set_boolean(borrow document:documents::Document,node:doctree::NodeId,key:int,value:bool):own Patch{
    let start:int= -1;let end:int= -1;
    if(document.is_open() && document.nodes().contains(node) && document.nodes().kind(node)==1 && (key==7 || key==8)){
        val a:doctree::NodeId=attribute(document.nodes(),node,key);
        start=span_start(document.nodes(),node)+4;end=start;
        if(!doctree::absent(a)){start=span_start(document.nodes(),a);end=span_end(document.nodes(),a);}
    }
    if(key==7){
        if(value){return try_new Patch(document,start,end,utf8(" hidden=\"true\" "));}
        return try_new Patch(document,start,end,utf8(" hidden=\"false\" "));
    }
    if(value){return try_new Patch(document,start,end,utf8(" disabled=\"true\" "));}
    return try_new Patch(document,start,end,utf8(" disabled=\"false\" "));
}
