                    if(value_size(t,a)==0 || !identifier_start(int(value_byte(t,a,0)))){self.invalid(t,a,206);return;}
                    for(let i:int=1;i<value_size(t,a);i++){if(!identifier_char(int(value_byte(t,a,i)))){self.invalid(t,a,206);return;}}
