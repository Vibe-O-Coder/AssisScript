            if(htdl::space(c)){self.cursor++;continue;}
            if(c==47 && self.cursor+1<self.length && self.source[self.cursor+1]==47){self.cursor+=2;
                while(self.cursor<self.length && self.source[self.cursor]!=10 && self.source[self.cursor]!=13){self.cursor++;}continue;}
            if(c==47 && self.cursor+1<self.length && self.source[self.cursor+1]==42){
                val start:int=self.cursor;self.cursor+=2;let depth:int=1;
                while(self.cursor<self.length && depth>0){
