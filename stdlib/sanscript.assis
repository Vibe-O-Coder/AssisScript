    }
    private fn word(borrow self,borrow value:slice<byte>):bool{return self.token==1 && self.eq(self.begin,self.end,value);}
    private fn letter(borrow self,c:int):bool{return (c>=65 && c<=90) || (c>=97 && c<=122) || c==95;}
    private fn digit(borrow self,c:int):bool{return c>=48 && c<=57;}
    private fn next(borrow mut self):void{
