        for(let i:int=0;i<3 && self.code==0;i++){
            let kind:int=0;if(self.word(utf8("target"))){kind=1;}if(self.word(utf8("frequency"))){kind=2;}if(self.word(utf8("dampingRatio"))){kind=3;}
            if(kind==0 || (args&(1<<kind))!=0){self.fail(201,self.begin,self.end);return;}args|=1<<kind;
            self.next();self.expect(58);
            if(kind==1){self.expect_word(utf8("fs"));self.expect(46);self.expect_word(utf8("target"));self.expect(46);axis=self.axis();}
            else{let negative:bool=false;if(self.token==45){negative=true;self.next();}
                if(self.token!=2){self.fail(204,self.begin,self.end);return;}
                if((kind==2 && self.unit!=5) || (kind==3 && self.unit!=2)){self.fail(204,self.begin,self.end);return;}
                let value:int=self.value;if(negative){value= -value;}
                if(kind==2){frequency=value;}else{damping=value;}self.next();}
            if(i<2){if(self.token!=44){self.fail(201,self.begin,self.end);return;}self.next();}
        }
        if(args!=14 || self.token==44){self.fail(201,start,self.end);return;}self.expect(41);self.expect(200);self.expect_word(utf8("presentation"));self.expect(46);
        val output:int=self.axis();if(axis!=output){self.fail(203,start,self.end);return;}self.expect(59);
        if(frequency<32768 || frequency>655360 || damping<6554 || damping>262144){self.fail(202,start,self.begin);return;}
        if(coefficients(frequency,damping).code!=0){self.fail(402,start,self.begin);return;}
        if(self.channel_count==64){self.fail(403,start,self.begin);return;}
        for(let i:int=0;i<self.channel_count;i++){if(self.channels[i*6]==motion && self.channels[i*6+1]==axis){self.fail(301,start,self.begin);return;}}
        val p:int=self.channel_count*6;self.channels[p]=motion;self.channels[p+1]=axis;self.channels[p+2]=frequency;self.channels[p+3]=damping;
        self.channels[p+4]=start;self.channels[p+5]=self.begin;self.channel_count++;
