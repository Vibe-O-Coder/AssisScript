/// Checked int64 product with Q16 scaling. Physical velocity is wider than Q32.
public pure fn product(a:int,b:int):fluxstyle::Number{
    if(a==0 || b==0){return new fluxstyle::Number(0,0);}
    if(a== -9223372036854775807-1 || b== -9223372036854775807-1){return new fluxstyle::Number(401,0);}
    let aa:int=a;let bb:int=b;if(aa<0){aa= -aa;}if(bb<0){bb= -bb;}
    if(aa!=0 && bb>(9223372036854775807-32768)/aa){return new fluxstyle::Number(401,0);}
    return new fluxstyle::Number(0,(a*b+32768)>>16);
}
final class Channel{
    private let matrix:Matrix;private let target:int;private let position:int;private let velocity:int;
    private let calm:int;private let resting:bool;private let active:bool;
    fn init(borrow mut self,frequency:int,damping:int,target:int):void{
        self.matrix=coefficients(frequency,damping);
        if(self.matrix.code!=0 || !fluxstyle::in_range(target)){return;}
        self.target=target;self.position=target;self.resting=true;self.active=true;
    }
    fn is_open(borrow self):bool{return self.active;}
    fn value(borrow self):int{return self.position;}
    fn speed(borrow self):int{return self.velocity;}
    fn asleep(borrow self):bool{return self.resting;}
    fn compatible(borrow self,borrow previous:Channel):bool{
        return previous.active && self.matrix.m11==previous.matrix.m11 && self.matrix.m12==previous.matrix.m12 &&
           self.matrix.m21==previous.matrix.m21 && self.matrix.m22==previous.matrix.m22;
    }
    fn inherit(borrow mut self,borrow previous:Channel):bool{
        if(!self.compatible(previous)){return false;}
        val target:int=self.target;self.target=previous.target;self.position=previous.position;
        self.velocity=previous.velocity;self.calm=previous.calm;self.resting=previous.resting;
        self.retarget(target);return true;
    }
    fn snap(borrow mut self):void{self.position=self.target;self.velocity=0;self.calm=0;self.resting=true;}
    fn freeze(borrow mut self):void{self.velocity=0;self.calm=0;self.resting=self.position==self.target;}
    fn retarget(borrow mut self,target:int):int{
        if(!fluxstyle::in_range(target)){return 401;}
        if(target==self.target){return 0;}self.target=target;self.calm=0;self.resting=false;
        if(target< -268435456 || target>268435456){self.snap();return 401;}return 0;
    }
    fn step(borrow mut self):int{
        if(!self.active){return 403;}if(self.resting){return 0;}
        val x:int=self.position-self.target;val a:fluxstyle::Number=product(self.matrix.m11,x);
        val b:fluxstyle::Number=product(self.matrix.m12,self.velocity);
        val c:fluxstyle::Number=product(self.matrix.m21,x);val d:fluxstyle::Number=product(self.matrix.m22,self.velocity);
        if(a.code!=0 || b.code!=0 || c.code!=0 || d.code!=0){self.snap();return 401;}
        // Each scaled checked product is at most 2^47 in magnitude.
        val relative:int=a.value+b.value;val velocity:int=c.value+d.value;
        val position:int=self.target+relative;
        if(!fluxstyle::in_range(position)){self.snap();return 401;}
        self.position=position;self.velocity=velocity;
        if(relative> -1024 && relative<1024 && velocity> -32768 && velocity<32768){self.calm++;}else{self.calm=0;}
        if(self.calm>=3){self.snap();}return 0;
    }
}

/// One node, up to two channels. Aggregate page/channel quota belongs to the host.
public final class Motion{
    private own x:Channel;private own y:Channel;private let bound:doctree::NodeId;
    private let revision:int;private let mask:int;private let code:int;private let remainder:int;
    private let tab_paused:bool;private let node_hidden:bool;private let protected:bool;private let active:bool;
    fn init(borrow mut self,node:doctree::NodeId,version:int,mask:int,fx:int,dx:int,fy:int,dy:int,tx:int,ty:int,status:int):void{
        self.code=status;if(status!=0){return;}
        if(version<=0 || doctree::absent(node) || mask<0 || mask>3){self.code=403;return;}
        if((mask&1)!=0){self.x=try_new Channel(fx,dx,tx);if(self.x==null || !self.x.is_open()){self.code=403;return;}}
        if((mask&2)!=0){self.y=try_new Channel(fy,dy,ty);if(self.y==null || !self.y.is_open()){self.code=403;return;}}
        self.bound=node;self.revision=version;self.mask=mask;self.active=true;
        if(((mask&1)!=0 && (tx< -268435456 || tx>268435456)) || ((mask&2)!=0 && (ty< -268435456 || ty>268435456))){self.code=401;}
    }
    fn is_open(borrow self):bool{return self.active;}
    fn status(borrow self):int{return self.code;}
    fn version(borrow self):int{return self.revision;}
    fn channels(borrow self):int{if(!self.active){return 0;}return int(self.x!=null)+int(self.y!=null);}
    /// Trusted coordinator: preserve dynamics when rebuilding the same binding.
    /// A different identity/channel profile starts at its own current target.
    fn inherit(borrow mut self,borrow previous:Motion):bool{
        if(!self.active || !previous.active || self.mask!=previous.mask || self.revision<previous.revision ||
           self.bound.instance!=previous.bound.instance || self.bound.slot!=previous.bound.slot ||
           self.bound.generation!=previous.bound.generation){return false;}
        // Compare both axes before changing either channel.
        if(self.x!=null && !self.x.compatible(previous.x)){return false;}
        if(self.y!=null && !self.y.compatible(previous.y)){return false;}
        if(self.x!=null){self.x.inherit(previous.x);}if(self.y!=null){self.y.inherit(previous.y);}
        self.remainder=previous.remainder;self.tab_paused=previous.tab_paused;
        self.node_hidden=previous.node_hidden;self.protected=previous.protected;return true;
    }
    fn at(borrow self,axis:int):fluxstyle::Number{
        if(!self.active){return new fluxstyle::Number(403,0);}
        if(axis==1 && self.x!=null){return new fluxstyle::Number(0,self.x.value());}
        if(axis==2 && self.y!=null){return new fluxstyle::Number(0,self.y.value());}return new fluxstyle::Number(302,0);
    }
    fn speed(borrow self,axis:int):fluxstyle::Number{
        if(!self.active){return new fluxstyle::Number(403,0);}
        if(axis==1 && self.x!=null){return new fluxstyle::Number(0,self.x.speed());}
        if(axis==2 && self.y!=null){return new fluxstyle::Number(0,self.y.speed());}return new fluxstyle::Number(302,0);
    }
    fn asleep(borrow self):bool{return self.active && (self.x==null || self.x.asleep()) && (self.y==null || self.y.asleep());}
    fn close(borrow mut self):void{
        self.active=false;self.remainder=0;own x:Channel=move(self.x);own y:Channel=move(self.y);
    }
    private fn live(borrow self,borrow document:documents::Document):bool{
        return self.active && document.is_open() && document.nodes().contains(self.bound);
    }
    fn update(borrow mut self,borrow document:documents::Document,borrow style:fluxstyle::Style):int{
        if(!self.live(document)){self.close();return 403;}
        val node:doctree::NodeId=style.node();
        if(node.instance!=self.bound.instance || node.slot!=self.bound.slot || node.generation!=self.bound.generation || style.version()<=self.revision){return 403;}
        if(((self.mask&1)!=0 && !style.has(14)) || ((self.mask&2)!=0 && !style.has(15))){return 302;}
        if(((self.mask&1)!=0 && !fluxstyle::in_range(style.value(14))) || ((self.mask&2)!=0 && !fluxstyle::in_range(style.value(15)))){return 401;}
        let status:int=0;
        if(self.x!=null){val r:int=self.x.retarget(style.value(14));if(r!=0){status=r;}}
        if(self.y!=null){val r:int=self.y.retarget(style.value(15));if(r!=0){status=r;}}
        self.revision=style.version();self.code=status;return status;
    }
    fn advance(borrow mut self,borrow document:documents::Document,elapsed_ms:int,tab_visible:bool,node_visible:bool,protected:bool,reduced:bool):int{
        if(!self.live(document)){self.close();return 403;}
        if(elapsed_ms<0 || elapsed_ms>60000){self.remainder=0;self.code=401;return 401;}
        self.code=0;
        if(reduced){if(self.x!=null){self.x.snap();}if(self.y!=null){self.y.snap();}self.remainder=0;}
        if(!node_visible){self.node_hidden=true;self.remainder=0;return 0;}
        if(self.node_hidden){self.node_hidden=false;if(self.x!=null){self.x.snap();}if(self.y!=null){self.y.snap();}self.remainder=0;return 0;}
        if(!tab_visible){self.tab_paused=true;self.remainder=0;return 0;}
        if(self.tab_paused){self.tab_paused=false;self.remainder=0;return 0;}
        if(protected){self.protected=true;if(self.x!=null){self.x.freeze();}if(self.y!=null){self.y.freeze();}self.remainder=0;return 0;}
        if(self.protected){self.protected=false;self.remainder=0;return 0;}
        if(reduced){return 0;}
        val total:int=self.remainder+elapsed_ms*120;let due:int=total/1000;self.remainder=total%1000;if(due>8){due=8;}
        for(let i:int=0;i<due;i++){
            if(self.x!=null){val r:int=self.x.step();if(r!=0){self.code=r;}}
            if(self.y!=null){val r:int=self.y.step();if(r!=0){self.code=r;}}
        }return self.code;
    }
}

/// Finite-profile SSC grammar and static/binding checks; no runtime coefficient generation.
public final class Program{
    private own source:*byte;private own motions:*int;private own channels:*int;private own bindings:*int;
    private let length:int;private let cursor:int;private let begin:int;private let end:int;private let token:int;
    private let value:int;private let unit:int;private let motion_count:int;private let channel_count:int;private let binding_count:int;
    private let code:int;private let first:int;private let last:int;private let work:int;private let active:bool;
    private fn fail(borrow mut self,code:int,start:int,end:int):void{if(self.code==0){self.code=code;self.first=start;self.last=end;}}
    private fn eq(borrow self,start:int,end:int,borrow value:slice<byte>):bool{
