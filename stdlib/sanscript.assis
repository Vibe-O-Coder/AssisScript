    private fn motion(borrow mut self):void{
        self.next();val start:int=self.begin;val end:int=self.end;self.expect(1);
        if(self.motion_count==32 || end-start>128){self.fail(403,start,end);return;}
        if(self.eq(start,end,utf8("motion")) || self.eq(start,end,utf8("bind")) || self.eq(start,end,utf8("to"))){self.fail(205,start,end);return;}
        for(let i:int=0;i<self.motion_count;i++){if(self.same(start,end,self.motions[i*2],self.motions[i*2+1])){self.fail(205,start,end);return;}}
        val index:int=self.motion_count;self.motion_count++;self.motions[index*2]=start;self.motions[index*2+1]=end;self.expect(123);
        while(self.code==0 && self.token!=125 && self.token!=0){if(!self.word(utf8("spring"))){self.fail(101,self.begin,self.end);return;}self.channel(index);}self.expect(125);
    }
    private fn binding(borrow mut self):void{
        self.next();val kind:int=self.token;if(kind!=35 && kind!=46){self.fail(101,self.begin,self.end);return;}
        val start:int=self.cursor;if(self.cursor==self.length || !self.letter(int(self.source[self.cursor]))){self.fail(101,start,start);return;}
        self.cursor++;while(self.cursor<self.length && (self.letter(int(self.source[self.cursor])) || self.digit(int(self.source[self.cursor])) || self.source[self.cursor]==45)){self.cursor++;}
        val end:int=self.cursor;if(end-start>128){self.fail(403,start,end);return;}self.next();self.expect_word(utf8("to"));
        val a:int=self.begin;val b:int=self.end;self.expect(1);self.expect(59);if(self.binding_count==128){self.fail(403,start,end);return;}
        val p:int=self.binding_count*6;self.bindings[p]=kind;self.bindings[p+1]=start;self.bindings[p+2]=end;self.bindings[p+3]=a;self.bindings[p+4]=b;self.bindings[p+5]= -1;self.binding_count++;
    }
    fn init(borrow mut self,borrow input:slice<byte>,max_bytes:int):void{
        if(len(input)>65536 || max_bytes<20000+len(input)){self.fail(403,0,0);return;}
        self.source=try_alloc<byte>(len(input)+1);if(self.source==null){self.fail(403,0,0);return;}
        self.length=len(input);for(let i:int=0;i<len(input);i++){self.source[i]=input[i];}
        val bad:int=unicode::error(input);if(bad>=0){self.fail(101,bad,bad+1);return;}
        for(let i:int=0;i<len(input);i++){if(input[i]<32 && !htdl::space(int(input[i]))){self.fail(101,i,i+1);return;}}
        self.motions=try_alloc<int>(64);self.channels=try_alloc<int>(64*6);self.bindings=try_alloc<int>(128*6);
        if(self.motions==null || self.channels==null || self.bindings==null){self.fail(403,0,0);return;}
        if(self.length>=3 && self.source[0]==239 && self.source[1]==187 && self.source[2]==191){self.cursor=3;}
        self.next();while(self.code==0 && self.token!=0){if(self.word(utf8("motion"))){self.motion();}else if(self.word(utf8("bind"))){self.binding();}else{self.fail(101,self.begin,self.end);}}
        for(let i:int=0;i<self.binding_count && self.code==0;i++){val p:int=i*6;
            for(let j:int=0;j<self.motion_count;j++){if(self.same(self.bindings[p+3],self.bindings[p+4],self.motions[j*2],self.motions[j*2+1])){self.bindings[p+5]=j;break;}}
            if(self.bindings[p+5]<0){self.fail(205,self.bindings[p+3],self.bindings[p+4]);}}
        self.active=self.code==0;
    }
    fn is_open(borrow self):bool{return self.active;}
    fn diagnostic(borrow self):htdl::Diagnostic{
        let a:htdl::Position=new htdl::Position(1,1);let b:htdl::Position=new htdl::Position(1,1);
        if(self.source!=null){a=htdl::position(slice_of(self.source,0,self.length),self.first);b=htdl::position(slice_of(self.source,0,self.length),self.last);}
        return new htdl::Diagnostic(self.code,self.first,self.last,a.line,a.column,b.line,b.column);
    }
    private fn matches(borrow mut self,borrow tree:doctree::Tree,node:doctree::NodeId,index:int):bool{
        val p:int=index*6;val start:int=self.bindings[p+1];val end:int=self.bindings[p+2];
        if(self.bindings[p]==35){return htdl::value_equals(tree,htdl::attribute(tree,node,5),slice_of(self.source,start,end-start));}
        val attribute:doctree::NodeId=htdl::attribute(tree,node,6);if(doctree::absent(attribute)){return false;}
        let at:int=0;while(at<htdl::value_size(tree,attribute)){let stop:int=at;
            while(stop<htdl::value_size(tree,attribute) && htdl::value_byte(tree,attribute,stop)!=32){
                stop++;self.work++;if(self.work>1000000){self.fail(403,start,end);return false;}}
            if(stop-at==end-start){let equal:bool=true;for(let i:int=0;i<end-start;i++){
                self.work++;if(self.work>1000000){self.fail(403,start,end);return false;}
                if(htdl::value_byte(tree,attribute,at+i)!=self.source[start+i]){equal=false;break;}}if(equal){return true;}}at=stop+1;}
        return false;
    }
    fn attach(borrow mut self,borrow document:documents::Document,node:doctree::NodeId,borrow style:fluxstyle::Style):own Motion{
        if(self.active){self.code=0;self.first=0;self.last=0;}self.work=0;
        let status:int=0;let selected:int=0;let mask:int=0;let fx:int=0;let dx:int=0;let fy:int=0;let dy:int=0;let tx:int=0;let ty:int=0;
        val target:doctree::NodeId=style.node();
        if(!self.active || !document.is_open() || !document.nodes().contains(node) || style.version()<=0 ||
           target.instance!=node.instance || target.slot!=node.slot || target.generation!=node.generation){status=403;}
        if(status==0){
            for(let i:int=0;i<self.binding_count && self.code==0;i++){if(self.matches(document.nodes(),node,i)){selected|=1<<self.bindings[i*6+5];}}
            if(self.code!=0){status=self.code;}
            for(let i:int=0;i<self.channel_count && status==0;i++){val p:int=i*6;if((selected&(1<<self.channels[p]))==0){continue;}
                val axis:int=self.channels[p+1];if((mask&(1<<(axis-1)))!=0){status=301;self.fail(status,self.channels[p+4],self.channels[p+5]);break;}mask|=1<<(axis-1);
                if(!style.has(13+axis)){status=302;self.fail(status,self.channels[p+4],self.channels[p+5]);break;}
                if(axis==1){fx=self.channels[p+2];dx=self.channels[p+3];tx=style.value(14);}
                else{fy=self.channels[p+2];dy=self.channels[p+3];ty=style.value(15);}}
        }
        return try_new Motion(node,style.version(),mask,fx,dx,fy,dy,tx,ty,status);
    }
}
