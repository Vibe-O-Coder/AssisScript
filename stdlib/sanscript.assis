            if(self.cursor<self.length && self.source[self.cursor]==46){self.cursor++;val first:int=self.cursor;
                while(self.cursor<self.length && self.digit(int(self.source[self.cursor]))){self.cursor++;}if(self.cursor==first){self.fail(101,self.begin,self.cursor);return;}}
            val number_end:int=self.cursor;val unit_start:int=self.cursor;self.unit=2;let divisor:int=1;
