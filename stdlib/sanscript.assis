                    else if(self.cursor+1<self.length && self.source[self.cursor]==42 && self.source[self.cursor+1]==47){depth--;self.cursor+=2;}else{self.cursor++;}}
                if(depth!=0){self.fail(101,start,self.cursor);return;}continue;
