#yuri <std/erros.assis>
#yuri <std/texto.assis>

/// Converte decimal estrito, com sinal opcional, sem espaços ou separadores. Detecta overflow e aceita INT64_MIN. Erro aponta o primeiro byte inválido (offset zero). Libere o ResultadoInt com free.
assis inteiro_de_texto(entrada: text): ResultadoInt {
    let n: int = len(entrada);
    if (n == 0) { return resultado_erro(1, 0); }
    let dados: *byte = bytes(entrada); let i: int = 0; let negativo: bool = false;
    if (dados[0] == 45 || dados[0] == 43) { negativo = dados[0] == 45; i = 1; }
    if (i == n) { return resultado_erro(2, i); }
    // Acumular negativamente permite representar INT64_MIN sem overflow.
    let limite: int = -0x7fff_ffff_ffff_ffff;
    if (negativo) { limite = -0x8000_0000_0000_0000; }
    let corte: int = limite / 10; let valor: int = 0;
    while (i < n) {
        let c: int = int(dados[i]);
        if (c < 48 || c > 57) { return resultado_erro(2, i); }
        let digito: int = c - 48;
        if (valor < corte) { return resultado_erro(3, i); }
        valor *= 10;
        if (valor < limite + digito) { return resultado_erro(3, i); }
        valor -= digito; i += 1;
    }
    if (!negativo) { valor = -valor; }
    return resultado_ok(valor);
}

/// Formata qualquer int64 em decimal, incluindo INT64_MIN. Retorna Texto proprietário; use resultado.dispose(); free(resultado); após a última leitura.
assis texto_de_inteiro(valor: int): Texto {
    let resultado: Texto = new Texto(); let buffer: *byte = alloc<byte>(20);
    let negativo: bool = valor < 0;
    if (valor > 0) { valor = -valor; }
    let n: int = 0;
    while (valor <= -10) { buffer[n] = byte(48 - valor % 10); n += 1; valor /= 10; }
    buffer[n] = byte(48 - valor); n += 1;
    if (negativo) { resultado.adicionar_byte(byte(45)); }
    while (n > 0) { n -= 1; resultado.adicionar_byte(buffer[n]); }
    free(buffer); return resultado;
}
/// Escreve decimal ASCII sem alocação ou terminador. Exige buffer gerenciado de pelo menos 20 bytes.
/// Retorna comprimento, ou -1 para capacidade insuficiente. Inclui INT64_MIN.
safe assis formatar_int_buffer(numero: int, borrow mut destino: *byte): int {
    if (len(destino) < 20) { return -1; }
    let negativo: bool = numero < 0; let valor: int = numero;
    if (valor > 0) { valor = -valor; }
    let tamanho: int = 0;
    while (true) {
        destino[tamanho] = byte(48 - (valor % 10)); tamanho += 1; valor /= 10;
        if (valor == 0) { break; }
    }
    if (negativo) { destino[tamanho] = byte(45); tamanho += 1; }
    let a: int = 0; let b: int = tamanho - 1;
    while (a < b) { let temp: byte = destino[a]; destino[a] = destino[b]; destino[b] = temp; a += 1; b -= 1; }
    return tamanho;
}
