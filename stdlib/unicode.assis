namespace unicode;

/// Offset do primeiro erro UTF-8, ou -1. NUL é dado válido. Rejeita overlong,
/// substitutos, continuações isoladas, truncamento e pontos acima de U+10FFFF.
public safe fn error(borrow data:slice<byte>):int {
    let i:int=0;
    while(i<len(data)){
        val c:int=int(data[i]);let n:int=0;let min:int=128;let max:int=191;
        if(c<128){i+=1;continue;}
        if(c>=194 && c<=223){n=2;}
        else if(c>=224 && c<=239){n=3;if(c==224){min=160;}if(c==237){max=159;}}
        else if(c>=240 && c<=244){n=4;if(c==240){min=144;}if(c==244){max=143;}}
        else{return i;}
        if(n>len(data)-i){return i;}
        val segundo:int=int(data[i+1]);if(segundo<min || segundo>max){return i+1;}
        for(let j:int=2;j<n;j+=1){if(data[i+j]<128 || data[i+j]>191){return i+j;}}
        i+=n;
    }
    return -1;
}

/// Próximo offset de byte. Requer entrada UTF-8 válida e fronteira de código.
public safe fn next(borrow data:slice<byte>,indice:int):int {
    assert(indice>=0 && indice<len(data));val c:int=int(data[indice]);
    if(c<128){return indice+1;}if(c<224){return indice+2;}if(c<240){return indice+3;}return indice+4;
}

/// String com bytes/comprimento explícitos e propriedade automática. Todos os
/// estados públicos são UTF-8 válidos, inclusive vazio e NUL. Não normaliza.
public final class String {
    private own data:*byte;
    private let count:int;
    private let capacity:int;

    fn init(borrow mut self):void{self.data=alloc<byte>(0);}
    fn size(borrow self):int{return self.count;}

    /// Falha recuperável preserva o conteúdo anterior. O(n), cópia independente.
    fn load(borrow mut self,borrow entrada:slice<byte>):bool {
        if(error(entrada)>=0){return false;}
        own novos:*byte=alloc<byte>(len(entrada));
        for(let i:int=0;i<len(entrada);i+=1){novos[i]=entrada[i];}
        self.data=move(novos);self.count=len(entrada);self.capacity=len(entrada);return true;
    }

    /// Grow geometrically; existing borrowed views must end before mutation.
    fn reserve(borrow mut self,capacity:int):void {
        assert(capacity>=0 && capacity<=0x3fff_ffff_ffff_ffff);
        if(capacity<=self.capacity){return;}
        let next:int=self.capacity;if(next<32){next=32;}
        while(next<capacity){if(next>0x1fff_ffff_ffff_ffff){next=capacity;}else{next*=2;}}
        own data:*byte=alloc<byte>(next);
        for(let i:int=0;i<self.count;i+=1){data[i]=self.data[i];}
        self.data=move(data);self.capacity=next;
    }

    /// Append validated UTF-8, including embedded NUL, with amortized growth.
    /// Literal arguments are converted to a static slice automatically.
    fn append(borrow mut self,borrow data:slice<byte>):bool {
        if(error(data)>=0){return false;}
        assert(len(data)<=0x3fff_ffff_ffff_ffff-self.count);
        self.reserve(self.count+len(data));
        for(let i:int=0;i<len(data);i+=1){self.data[self.count+i]=data[i];}
        self.count+=len(data);return true;
    }

    fn clear(borrow mut self):void{self.count=0;}

    /// Decimal formatting of the full signed int range, including INT64_MIN.
    fn append_int(borrow mut self,value:int):void {
        own digits:*byte=alloc<byte>(20);let count:int=0;let n:int=value;
        if(n>0){n=-n;}
        while(true){digits[count]=byte(48-(n%10));count+=1;n/=10;if(n==0){break;}}
        if(value<0){digits[count]='-';count+=1;}
        for(let i:int=0;i<count/2;i+=1){val c:byte=digits[i];digits[i]=digits[count-i-1];digits[count-i-1]=c;}
        assert(self.append(slice_of(digits,0,count)));
    }

    /// Fixed decimal formatting, 0..9 fractional places, rounding half away
    /// from zero. Reject NaN, infinity or a scaled magnitude above 9e18.
    /// This is a display formatter, not an exact decimal arithmetic type.
    fn append_decimal(borrow mut self,value:f64,places:int):bool {
        if(places<0 || places>9 || value!=value){return false;}
        let scale:int=1;for(let i:int=0;i<places;i+=1){scale*=10;}
        let magnitude:f64=value;if(magnitude<0.0){magnitude=-magnitude;}
        val scaled:f64=magnitude*f64(scale)+0.5;
        if(scaled>9000000000000000000.0){return false;}
        val rounded:int=int(scaled);
        if(value<0.0){assert(self.append("-"));}
        self.append_int(rounded/scale);
        if(places>0){
            assert(self.append("."));own digits:*byte=alloc<byte>(places);let fraction:int=rounded%scale;
            for(let i:int=places-1;i>=0;i-=1){digits[i]=byte(48+fraction%10);fraction/=10;}
            assert(self.append(slice_of(digits,0,places)));
        }
        return true;
    }

    fn as_slice(borrow self):borrow(self) slice<byte>{return slice_of(self.data,0,self.count);}

    /// Recorte por offset de bytes; exige fronteiras UTF-8. Empréstimo conserva
    /// a origem, bloqueia mutação/liberação do texto até o fim de seu escopo.
    fn slice_range(borrow self,start:int,count:int):borrow(self) slice<byte> {
        assert(start>=0 && start<=self.count && count>=0 && count<=self.count-start);
        val end:int=start+count;
        assert(start==self.count || self.data[start]<128 || self.data[start]>=192);
        assert(end==self.count || self.data[end]<128 || self.data[end]>=192);
        return slice_of(self.data,start,count);
    }
}
