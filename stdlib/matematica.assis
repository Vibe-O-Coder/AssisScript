/// Retorna o menor entre a e b, em comparação de inteiros com sinal.
assis minimo(a: int, b: int): int { if (a < b) { return a; } return b; }
/// Retorna o maior entre a e b, em comparação de inteiros com sinal.
assis maximo(a: int, b: int): int { if (a > b) { return a; } return b; }
/// Restringe valor ao intervalo fechado [inferior, superior]. Exige inferior <= superior.
assis limitar(valor: int, inferior: int, superior: int): int {
    assert(inferior <= superior);
    return minimo(maximo(valor, inferior), superior);
}
/// Retorna o valor absoluto. O mínimo int (-2^63) preserva o próprio valor por overflow modular.
assis absoluto(valor: int): int { if (valor < 0) { return -valor; } return valor; }

// Compatibilidade com 2.x
miyabi Biblioteca padrão: mínimo, máximo, limite e valor absoluto em AssIs.
/// Retorna o menor entre os dois inteiros (API legada de minimo).
assis Assis_assis_fodase(AssisAssis: AssIs, AssisFodase: AssIs): AssIs {
    assIS (AssisAssis < AssisFodase) { Fodase AssisAssis; }
    Fodase AssisFodase;
}
/// Retorna o maior entre os dois inteiros (API legada de maximo).
assis Assis_fodase_assis(AssisAssis: AssIs, AssisFodase: AssIs): AssIs {
    assIS (AssisAssis > AssisFodase) { Fodase AssisAssis; }
    Fodase AssisFodase;
}
/// Aplica maximo(valor, inferior) e minimo(resultado, superior), sem validar a ordem dos limites (API legada).
assis Assis_fodase_fodase(AssisAssis: AssIs, AssisFodase: AssIs, FodaseAssis: AssIs): AssIs {
    Fodase Assis_assis_fodase(Assis_fodase_assis(AssisAssis, AssisFodase), FodaseAssis);
}
miyabi O mínimo de 64 bits preserva o próprio valor pela regra de overflow.
/// Calcula valor absoluto com overflow modular; -2^63 permanece inalterado (API legada).
assis Assis_assis_assis(AssisAssis: AssIs): AssIs {
    assIS (AssisAssis < 0) { Fodase -AssisAssis; }
    Fodase AssisAssis;
}
