namespace fluxstyle;
import "std/htdl.assis";

/// fs-local-v1: Q16.16, positive tie for arithmetic, away from zero for literals.
public value struct Number{let code:int;let value:int;}
public pure fn in_range(value:int):bool{return value>= -2147483648 && value<=2147483647;}
pure fn checked(value:int):Number{if(!in_range(value)){return new Number(401,0);}return new Number(0,value);}
public pure fn add(a:int,b:int):Number{
    if(!in_range(a) || !in_range(b)){return new Number(401,0);}return checked(a+b);
}
public pure fn subtract(a:int,b:int):Number{
    if(!in_range(a) || !in_range(b)){return new Number(401,0);}return checked(a-b);
}
public pure fn multiply(a:int,b:int):Number{
    if(!in_range(a) || !in_range(b)){return new Number(401,0);}
    // A product of two signed 32-bit values plus 32768 fits int64.
    return checked((a*b+32768)>>16);
}
public pure fn divide(a:int,b:int):Number{
    if(!in_range(a) || !in_range(b)){return new Number(401,0);}if(b==0){return new Number(402,0);}
    let numerator:int=a*65536;let denominator:int=b;
    if(denominator<0){denominator= -denominator;numerator= -numerator;}
    val scaled:int=numerator*2+denominator;val divisor:int=denominator*2;
    let result:int=scaled/divisor;if(scaled%divisor<0){result--;}
    return checked(result);
}
pure fn letter(c:int):bool{return (c>=65 && c<=90) || (c>=97 && c<=122) || c==95;}
pure fn digit(c:int):bool{return c>=48 && c<=57;}
pure fn name_char(c:int):bool{return letter(c) || digit(c);}
pure fn hex(c:int):int{
    if(digit(c)){return c-48;}if(c>=65 && c<=70){return c-55;}if(c>=97 && c<=102){return c-87;}return -1;
}
/// Decimal input has no unit/sign, <=9 fractional digits, bounded integer part.
/// One extra positive magnitude is admitted for the exact negative endpoint.
public safe fn decimal(borrow source:slice<byte>,negative:bool,multiplier:int,divisor:int):Number{
    if((multiplier!=1 && multiplier!=1000) || (divisor!=1 && divisor!=100 && divisor!=1000) || len(source)==0){return new Number(101,0);}
    let whole:int=0;let fraction:int=0;let scale:int=1;let at:int=0;
    while(at<len(source) && digit(int(source[at]))){
        if(whole>(32768000-(int(source[at])-48))/10){return new Number(401,0);}
        whole=whole*10+int(source[at])-48;at++;
    }
    if(at==0){return new Number(101,0);}
    if(at<len(source) && source[at]==46){at++;val first:int=at;
        while(at<len(source) && digit(int(source[at]))){
            if(scale==1000000000){return new Number(401,0);}
            fraction=fraction*10+int(source[at])-48;scale*=10;at++;
        }if(at==first){return new Number(101,0);}
    }
    if(at!=len(source)){return new Number(101,0);}
    val integral:int=whole*65536*multiplier;
    val denominator:int=scale*divisor;
    let result:int=integral/divisor+((integral%divisor)*scale+fraction*65536*multiplier+denominator/2)/denominator;
    if(negative){result= -result;}
    if(result< -2147483648 || result>2147483648){return new Number(401,0);}
    return new Number(0,result);
}

/// Host supplies typed input values by program-local index. No pointers/capabilities.
public final class Inputs{
    private own data:*int;private let count:int;
    fn init(borrow mut self,capacity:int):void{
        if(capacity<1 || capacity>2048){return;}self.data=try_alloc<int>(capacity*3);
        if(self.data!=null){self.count=capacity;}
    }
    fn is_ready(borrow self):bool{return self.data!=null;}
    fn has(borrow self,index:int):bool{return index>=0 && index<self.count && self.data[index*3]!=0;}
    fn type(borrow self,index:int):int{if(!self.has(index)){return 0;}return self.data[index*3+1];}
    fn value(borrow self,index:int):int{assert(self.has(index));return self.data[index*3+2];}
    fn set(borrow mut self,index:int,type:int,value:int):bool{
        if(index<0 || index>=self.count || type<1 || type>11){return false;}
        if((type==1 && value!=0 && value!=1) || (type>=2 && type<=5 && !in_range(value)) ||
           ((type==10 || type==11) && value!=0 && value!=1)){return false;}
        self.data[index*3]=1;self.data[index*3+1]=type;self.data[index*3+2]=value;return true;
    }
    fn clear(borrow mut self):void{for(let i:int=0;i<self.count*3;i++){self.data[i]=0;}}
}
/// Caller-owned last valid author outputs for one live semantic node.
public final class Style{
    private own data:*int;private let mask:int;private let revision:int;private let bound:doctree::NodeId;
    fn init(borrow mut self):void{self.data=try_alloc<int>(15);}
    fn is_ready(borrow self):bool{return self.data!=null;}
    fn version(borrow self):int{return self.revision;}
    fn node(borrow self):doctree::NodeId{return self.bound;}
    fn has(borrow self,property:int):bool{return property>=1 && property<=15 && (self.mask&(1<<(property-1)))!=0;}
    fn value(borrow self,property:int):int{assert(self.has(property));return self.data[property-1];}
    /// Trusted host operation; copies all values before exposing the new version.
    fn commit(borrow mut self,node:doctree::NodeId,version:int,mask:int,borrow values:slice<int>):bool{
        if(!self.is_ready() || version<=self.revision || len(values)!=15){return false;}
        if(self.revision>0 && (self.bound.instance!=node.instance || self.bound.slot!=node.slot || self.bound.generation!=node.generation)){return false;}
        for(let i:int=0;i<15;i++){self.data[i]=values[i];}
        self.bound=node;self.mask=mask;self.revision=version;return true;
    }
}

/// Closed, bounded parser/type graph/evaluator. No effects or final geometry inputs.
public final class Program{
    private own source:*byte;private own nodes:*int;private own marks:*int;private own values:*int;
    private own definitions:*int;private own flows:*int;private own bindings:*int;private own outputs:*int;private own pending:*int;
    private let length:int;private let cursor:int;private let token:int;private let begin:int;private let end:int;
    private let literal:int;private let literal_type:int;private let count:int;private let definition_count:int;
    private let flow_count:int;private let binding_count:int;private let output_count:int;private let current_flow:int;
    private let code:int;private let first:int;private let last:int;private let work:int;private let active:bool;

