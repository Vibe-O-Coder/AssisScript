        if(primitive>=45){
            if(self.token!=41){if(primitive==45){self.fail(207,start,self.end);return 0;}
                self.expect_word(utf8("gap"));self.expect(58);a=self.expression(1,depth+1);arity=1;}
            if(arity==0){a=self.make(1,0,0,0,0,3,start,self.begin);}
