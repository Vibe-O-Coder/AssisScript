                if(self.token==44){self.next();b=self.expression(1,depth+1);arity=2;
                    if(self.token==44){self.next();c=self.expression(1,depth+1);arity=3;}}}
            let expected:int=2;if(primitive==40 || primitive==43){expected=3;}if(primitive==44){expected=1;}
            if(arity!=expected || self.token!=41){self.fail(207,start,self.end);return 0;}
