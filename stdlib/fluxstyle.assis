        self.nodes[index*16+13]=key_start;self.nodes[index*16+14]=key_end;self.nodes[index*16+15]=scope;self.define(index,start,end);
    }
    private fn property(borrow self,a:int,b:int,c:int,d:int):int{
        if(self.eq(a,b,utf8("layout"))){
            if(self.eq(c,d,utf8("width"))){return 1;}if(self.eq(c,d,utf8("height"))){return 2;}if(self.eq(c,d,utf8("padding"))){return 3;}
            if(self.eq(c,d,utf8("children"))){return 4;}if(self.eq(c,d,utf8("align"))){return 5;}if(self.eq(c,d,utf8("overflow"))){return 6;}}
        if(self.eq(a,b,utf8("paint"))){
            if(self.eq(c,d,utf8("background"))){return 7;}if(self.eq(c,d,utf8("text"))){return 8;}
            if(self.eq(c,d,utf8("radius"))){return 9;}if(self.eq(c,d,utf8("opacity"))){return 10;}}
        if(self.eq(a,b,utf8("text"))){if(self.eq(c,d,utf8("size"))){return 11;}if(self.eq(c,d,utf8("weight"))){return 12;}if(self.eq(c,d,utf8("align"))){return 13;}}
        if(self.eq(a,b,utf8("target"))){if(self.eq(c,d,utf8("offsetX"))){return 14;}if(self.eq(c,d,utf8("offsetY"))){return 15;}}return 0;
    }
    private fn property_type(borrow self,property:int):int{
        if(property==4){return 9;}if(property==5 || property==13){return 7;}if(property==6){return 8;}
        if(property==7 || property==8){return 6;}if(property==10 || property==12){return 2;}return 3;
    }
    private fn flow_declaration(borrow mut self):void{
        self.next();val start:int=self.begin;val end:int=self.end;self.expect(1);
        if(end-start>128 || self.reserved(start,end)){self.fail(206,start,end);return;}
        if(self.flow_count==32){self.fail(401,start,end);return;}
        for(let i:int=0;i<self.flow_count;i++){if(self.same(start,end,self.flows[i*2],self.flows[i*2+1])){self.fail(206,start,end);return;}}
        self.current_flow=self.flow_count;self.flows[self.flow_count*2]=start;self.flows[self.flow_count*2+1]=end;self.flow_count++;
        self.expect(123);
        while(self.code==0 && self.token!=125 && self.token!=0){
            if(self.word(utf8("input"))){self.input_declaration();}
            else if(self.word(utf8("let"))){self.next();val a:int=self.begin;val b:int=self.end;self.expect(1);self.expect(61);
                val expression:int=self.expression(1,0);self.expect(59);val index:int=self.make(4,expression,0,0,0,0,a,self.begin);self.define(index,a,b);}
            else{val expression:int=self.expression(1,0);self.expect(200);
                val a:int=self.begin;val b:int=self.end;self.expect(1);self.expect(46);val c:int=self.begin;val d:int=self.end;self.expect(1);
                val property:int=self.property(a,b,c,d);if(property==0){self.fail(202,a,d);return;}self.expect(59);
                if(self.output_count==480){self.fail(401,a,d);return;}
                for(let i:int=0;i<self.output_count;i++){if(self.outputs[i*3]==self.current_flow && self.outputs[i*3+1]==property){self.fail(302,a,d);return;}}
                val p:int=self.output_count*3;self.outputs[p]=self.current_flow;self.outputs[p+1]=property;self.outputs[p+2]=expression;self.output_count++;}
        }self.expect(125);
