    fn init(borrow mut self,borrow input:slice<byte>,max_bytes:int):void{
        // Conservative requested-storage budget, including an extra 1 KiB for bodies.
        if(len(input)>65536 || max_bytes<400000+len(input)){self.fail(401,0,0);return;}
        self.source=try_alloc<byte>(len(input)+1);if(self.source==null){self.fail(401,0,0);return;}
        self.length=len(input);for(let i:int=0;i<self.length;i++){self.source[i]=input[i];}
        val bad:int=unicode::error(input);if(bad>=0){self.fail(101,bad,bad+1);return;}
        for(let i:int=0;i<len(input);i++){if(input[i]<32 && !htdl::space(int(input[i]))){self.fail(101,i,i+1);return;}}
        self.nodes=try_alloc<int>(2048*16);self.marks=try_alloc<int>(2048);
        self.values=try_alloc<int>(2048);self.definitions=try_alloc<int>(256);self.flows=try_alloc<int>(64);
        self.bindings=try_alloc<int>(128*6);self.outputs=try_alloc<int>(480*3);self.pending=try_alloc<int>(30);
        if(self.source==null || self.nodes==null || self.marks==null || self.values==null || self.definitions==null ||
           self.flows==null || self.bindings==null || self.outputs==null || self.pending==null){self.fail(401,0,0);return;}
        if(self.length>=3 && self.source[0]==239 && self.source[1]==187 && self.source[2]==191){self.cursor=3;}
        self.next();while(self.code==0 && self.token!=0){
            if(self.word(utf8("flow"))){self.flow_declaration();}
            else if(self.word(utf8("bind"))){self.binding();}
            else{self.fail(102,self.begin,self.end);}}
        for(let i:int=0;i<self.count && self.code==0;i++){self.infer(i,0);}
        for(let i:int=0;i<self.output_count && self.code==0;i++){val index:int=self.outputs[i*3+2];
            if(self.nodes[index*16+5]!=self.property_type(self.outputs[i*3+1])){self.fail(201,self.nodes[index*16+6],self.nodes[index*16+7]);}}
        for(let i:int=0;i<self.binding_count && self.code==0;i++){
            val p:int=i*6;for(let f:int=0;f<self.flow_count;f++){
                if(self.same(self.bindings[p+3],self.bindings[p+4],self.flows[f*2],self.flows[f*2+1])){self.bindings[p+5]=f;break;}}
            if(self.bindings[p+5]<0){self.fail(205,self.bindings[p+3],self.bindings[p+4]);}}
        // This local profile requires a consistent state schema throughout a resource.
        for(let i:int=0;i<self.definition_count && self.code==0;i++){val p:int=self.definitions[i]*16;
            if(self.nodes[p]!=3 || self.nodes[p+1]!=12){continue;}
            for(let j:int=0;j<i;j++){val q:int=self.definitions[j]*16;
                if(self.nodes[q]==3 && self.nodes[q+1]==12 && self.nodes[p+15]==self.nodes[q+15] &&
                   self.same(self.nodes[p+13],self.nodes[p+14],self.nodes[q+13],self.nodes[q+14])){
                    if(self.nodes[p+5]!=self.nodes[q+5]){self.fail(304,self.nodes[p+6],self.nodes[p+7]);}
                    else if(self.nodes[p+4]!=self.nodes[q+4]){self.fail(306,self.nodes[p+6],self.nodes[p+7]);}}}}
        self.active=self.code==0;
    }
    fn is_open(borrow self):bool{return self.active;}
    fn diagnostic(borrow self):htdl::Diagnostic{
        let a:htdl::Position=new htdl::Position(1,1);let b:htdl::Position=new htdl::Position(1,1);
        if(self.source!=null){a=htdl::position(slice_of(self.source,0,self.length),self.first);b=htdl::position(slice_of(self.source,0,self.length),self.last);}
        return new htdl::Diagnostic(self.code,self.first,self.last,a.line,a.column,b.line,b.column);
    }
    fn input_index(borrow self,flow:int,borrow name:slice<byte>):int{
        if(!self.active || flow<0 || flow>=self.flow_count){return -1;}
        for(let i:int=0;i<self.definition_count;i++){val index:int=self.definitions[i];val p:int=index*16;
            if(self.nodes[p]==3 && self.nodes[p+8]==flow && self.eq(self.nodes[p+9],self.nodes[p+10],name)){return index;}}return -1;
    }
    fn flow_index(borrow self,borrow name:slice<byte>):int{
        if(!self.active){return -1;}for(let i:int=0;i<self.flow_count;i++){if(self.eq(self.flows[i*2],self.flows[i*2+1],name)){return i;}}return -1;
    }
    private fn matches(borrow mut self,borrow tree:doctree::Tree,node:doctree::NodeId,index:int):bool{
        val p:int=index*6;val start:int=self.bindings[p+1];val end:int=self.bindings[p+2];
        if(self.bindings[p]==35){return htdl::value_equals(tree,htdl::attribute(tree,node,5),slice_of(self.source,start,end-start));}
        val attribute:doctree::NodeId=htdl::attribute(tree,node,6);if(doctree::absent(attribute)){return false;}
        let at:int=0;while(at<htdl::value_size(tree,attribute)){
            let stop:int=at;while(stop<htdl::value_size(tree,attribute) && htdl::value_byte(tree,attribute,stop)!=32){
                stop++;self.work++;if(self.work>1000000){self.fail(401,start,end);return false;}}
            if(stop-at==end-start){let same:bool=true;for(let i:int=0;i<end-start;i++){
                self.work++;if(self.work>1000000){self.fail(401,start,end);return false;}
                if(htdl::value_byte(tree,attribute,at+i)!=self.source[start+i]){same=false;break;}}if(same){return true;}}
            at=stop+1;
        }return false;
    }
    private fn evaluate_node(borrow mut self,index:int,borrow input:Inputs,depth:int):int{
        if(self.code!=0){return 0;}val p:int=index*16;
        self.work++;if(depth>64 || self.work>1000000){self.fail(401,self.nodes[p+6],self.nodes[p+7]);return 0;}
        if(self.marks[index]==1){return self.values[index];}
        val op:int=self.nodes[p];let result:int=self.nodes[p+4];let a:int=0;let b:int=0;let c:int=0;
        if(op==3){if(input.has(index)){if(input.type(index)!=self.nodes[p+5]){self.fail(201,self.nodes[p+6],self.nodes[p+7]);return 0;}result=input.value(index);}}
        else if(op==2 || op==4){result=self.evaluate_node(self.nodes[p+1],input,depth+1);}
        else if(op!=1){
            a=self.evaluate_node(self.nodes[p+1],input,depth+1);
            if(op==40){if(a!=0){result=self.evaluate_node(self.nodes[p+2],input,depth+1);}else{result=self.evaluate_node(self.nodes[p+3],input,depth+1);}}
            else if(op==31 || op==32){
                result=0;if(op==32 && a!=0){result=1;}else if(op==31 && a==0){result=0;}
                else{result=self.evaluate_node(self.nodes[p+2],input,depth+1);}
            }else if(op==11 || op==44){result=a;if(op==11 || a<0){result= -a;}}
            else if(op==12){result=0;if(a==0){result=1;}}
            else if(op>=45 && op<=47){if(a<0){self.fail(404,self.nodes[p+6],self.nodes[p+7]);}result=a*4+op-45;}
            else{
                b=self.evaluate_node(self.nodes[p+2],input,depth+1);let number:Number=new Number();
                if(op==21){number=add(a,b);}if(op==22){number=subtract(a,b);}if(op==23){number=multiply(a,b);}if(op==24){number=divide(a,b);}
                if(op>=21 && op<=24){if(number.code!=0){self.fail(number.code,self.nodes[p+6],self.nodes[p+7]);}result=number.value;}
                else if(op>=25 && op<=30){result=0;
                    if((op==25 && a<b) || (op==26 && a<=b) || (op==27 && a>b) || (op==28 && a>=b) || (op==29 && a==b) || (op==30 && a!=b)){result=1;}}
                else if(op==41){result=a;if(b<a){result=b;}}
                else if(op==42){result=a;if(b>a){result=b;}}
                else if(op==43){c=self.evaluate_node(self.nodes[p+3],input,depth+1);result=a;
                    if(b>c){self.fail(403,self.nodes[p+6],self.nodes[p+7]);}if(result<b){result=b;}if(result>c){result=c;}}
            }
        }
        val type:int=self.nodes[p+5];if(type>=2 && type<=5 && !in_range(result)){self.fail(401,self.nodes[p+6],self.nodes[p+7]);}
        self.values[index]=result;self.marks[index]=1;return result;
    }
    fn evaluate(borrow mut self,borrow document:documents::Document,node:doctree::NodeId,borrow input:Inputs,version:int,borrow mut output:Style):htdl::Diagnostic{
        self.code=0;self.first=0;self.last=0;self.work=0;
        if(!self.active || !document.is_open() || !document.nodes().contains(node) || htdl::kind(document.nodes(),node)<4 ||
           htdl::kind(document.nodes(),node)==10 || htdl::kind(document.nodes(),node)==11 ||
           !input.is_ready() || !output.is_ready() || version<=output.version()){
            self.fail(204,0,0);return self.diagnostic();}
        let flows:int=0;for(let i:int=0;i<self.binding_count && self.code==0;i++){if(self.matches(document.nodes(),node,i)){flows|=1<<self.bindings[i*6+5];}}
        for(let i:int=0;i<self.count;i++){self.marks[i]=0;}
        for(let i:int=0;i<30;i++){self.pending[i]=0;}
        for(let i:int=0;i<self.definition_count && self.code==0;i++){val index:int=self.definitions[i];val p:int=index*16;
            if(self.nodes[p]==3 && (flows&(1<<self.nodes[p+8]))!=0){val source:int=self.nodes[p+1];
                if(source!=12 && source!=5 && source!=6 && !input.has(index)){let code:int=204;if(source==1){code=303;}self.fail(code,self.nodes[p+6],self.nodes[p+7]);}
                if(source==6 && (htdl::kind(document.nodes(),node)!=21 || !htdl::value_equals(document.nodes(),htdl::attribute(document.nodes(),node,18),utf8("checkbox")))){
                    self.fail(204,self.nodes[p+6],self.nodes[p+7]);}
                if(source==5 && htdl::kind(document.nodes(),node)!=9 && htdl::kind(document.nodes(),node)!=21){self.fail(204,self.nodes[p+6],self.nodes[p+7]);}
                if(input.has(index) && input.type(index)!=self.nodes[p+5]){self.fail(201,self.nodes[p+6],self.nodes[p+7]);}
                let value:int=self.nodes[p+4];
                if(input.has(index)){value=input.value(index);}
                if(source==1 && value<0){self.fail(303,self.nodes[p+6],self.nodes[p+7]);}
                if(source==11 && value<=0){self.fail(204,self.nodes[p+6],self.nodes[p+7]);}
                if(source==5 || source==6){let key:int=8;if(source==6){key=22;}value=0;
                    if(htdl::value_equals(document.nodes(),htdl::attribute(document.nodes(),node,key),utf8("true"))){value=1;}}
                if(source==12){
                    // All readers of the same page/node key observe one cell,
                    // independent of declaration order and branch reachability.
                    let provided:bool=false;
                    for(let j:int=0;j<self.definition_count;j++){val other:int=self.definitions[j];val q:int=other*16;
                        if(self.nodes[q]==3 && self.nodes[q+1]==12 && self.nodes[p+15]==self.nodes[q+15] &&
                           self.same(self.nodes[p+13],self.nodes[p+14],self.nodes[q+13],self.nodes[q+14]) && input.has(other)){
                            if(input.type(other)!=self.nodes[p+5]){self.fail(201,self.nodes[p+6],self.nodes[p+7]);}
                            if(provided && value!=input.value(other)){self.fail(304,self.nodes[p+6],self.nodes[p+7]);}
                            provided=true;value=input.value(other);
                        }}
                    if(self.nodes[p+5]==2 && value%65536!=0){self.fail(201,self.nodes[p+6],self.nodes[p+7]);}
                }
                self.values[index]=value;self.marks[index]=1;
            }}
        let mask:int=0;
        for(let i:int=0;i<self.output_count && self.code==0;i++){
            val p:int=i*3;val flow:int=self.outputs[p];if((flows&(1<<flow))==0){continue;}
            val property:int=self.outputs[p+1];val expression:int=self.outputs[p+2];val start:int=self.nodes[expression*16+6];val end:int=self.nodes[expression*16+7];
            if(self.pending[15+property-1]!=0){self.fail(302,start,end);break;}self.pending[15+property-1]=flow+1;
            val value:int=self.evaluate_node(expression,input,0);
            if(((property>=1 && property<=3) || property==9) && value<0){self.fail(404,start,end);}
            if(property==10 && (value<0 || value>65536)){self.fail(404,start,end);}
            if(property==11 && value<=0){self.fail(404,start,end);}
            if(property==12 && (value<100*65536 || value>900*65536 || value%65536!=0)){self.fail(404,start,end);}
            if(property==13 && value==3){self.fail(404,start,end);}
            self.pending[property-1]=value;mask|=1<<(property-1);
        }
        if(self.code==0 && !output.commit(node,version,mask,slice_of(self.pending,0,15))){self.fail(204,0,0);}
        return self.diagnostic();
    }
}
