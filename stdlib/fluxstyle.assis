            if(c>=128 || c<32 || (c==38 && self.token!=205) || (c==124 && self.token!=206)){
                if(c>=128){while(self.cursor<self.length && self.source[self.cursor]>=128 && self.source[self.cursor]<192){self.cursor++;}}
