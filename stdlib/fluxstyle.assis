    }
    private fn expect_word(borrow mut self,borrow word:slice<byte>):void{
        if(self.code!=0){return;}if(!self.word(word)){self.fail(102,self.begin,self.end);return;}self.next();
    }
    private fn make(borrow mut self,op:int,a:int,b:int,c:int,value:int,type:int,start:int,end:int):int{
        if(self.code!=0){return 0;}if(self.count==2048){self.fail(401,start,end);return 0;}
        val index:int=self.count;self.count++;val p:int=index*16;
        self.nodes[p]=op;self.nodes[p+1]=a;self.nodes[p+2]=b;self.nodes[p+3]=c;
        self.nodes[p+4]=value;self.nodes[p+5]=type;self.nodes[p+6]=start;self.nodes[p+7]=end;self.nodes[p+8]=self.current_flow;
        return index;
    }
    private fn primary(borrow mut self,depth:int):int{
        if(self.code!=0){return 0;}if(depth>64){self.fail(401,self.begin,self.end);return 0;}
        val start:int=self.begin;
        if(self.token==45 || self.token==33){val op:int=self.token;self.next();
            if(op==45 && self.token==2){val result:int=self.make(1,0,0,0,-self.literal,self.literal_type,start,self.end);self.next();return result;}
            val child:int=self.primary(depth+1);let kind:int=11;if(op==33){kind=12;}
            return self.make(kind,child,0,0,0,0,start,self.begin);
        }
        if(self.token==2){val result:int=self.make(1,0,0,0,self.literal,self.literal_type,start,self.end);self.next();return result;}
        if(self.token==35){
            let color:int=0;let digits:int=0;
            while(self.cursor<self.length && hex(int(self.source[self.cursor]))>=0){
                if(digits==8){self.fail(101,start,self.cursor+1);return 0;}
                color=color*16+hex(int(self.source[self.cursor]));digits++;self.cursor++;}
            if((digits!=3 && digits!=6 && digits!=8) || (self.cursor<self.length && name_char(int(self.source[self.cursor])))){
                self.fail(101,start,self.cursor);return 0;}
            if(digits==3){color=((color>>8)&15)*1114112+((color>>4)&15)*4352+(color&15)*17;}
            if(digits!=8){color=color*256+255;}
            val result:int=self.make(1,0,0,0,color,6,start,self.cursor);self.next();return result;
        }
        if(self.token==40){self.next();val result:int=self.expression(1,depth+1);self.expect(41);return result;}
        if(self.token==3){self.fail(201,start,self.end);return 0;}
        if(self.token!=1){self.fail(102,start,self.end);return 0;}
        val stop:int=self.end;let primitive:int=0;let enum_type:int=0;let enum_value:int=0;
        if(self.word(utf8("true")) || self.word(utf8("false"))){enum_type=1;if(self.word(utf8("true"))){enum_value=1;}}
        else if(self.word(utf8("start")) || self.word(utf8("center")) || self.word(utf8("end")) || self.word(utf8("stretch"))){
            enum_type=7;if(self.word(utf8("center"))){enum_value=1;}if(self.word(utf8("end"))){enum_value=2;}if(self.word(utf8("stretch"))){enum_value=3;}}
        else if(self.word(utf8("visible")) || self.word(utf8("clip")) || self.word(utf8("scroll"))){
            enum_type=8;if(self.word(utf8("clip"))){enum_value=1;}if(self.word(utf8("scroll"))){enum_value=2;}}
        else if(self.word(utf8("light")) || self.word(utf8("dark"))){enum_type=10;if(self.word(utf8("dark"))){enum_value=1;}}
        else if(self.word(utf8("normal")) || self.word(utf8("high"))){enum_type=11;if(self.word(utf8("high"))){enum_value=1;}}
        if(self.word(utf8("choose"))){primitive=40;}if(self.word(utf8("min"))){primitive=41;}
        if(self.word(utf8("max"))){primitive=42;}if(self.word(utf8("clamp"))){primitive=43;}
        if(self.word(utf8("abs"))){primitive=44;}if(self.word(utf8("block"))){primitive=45;}
