        if(self.token==203 || self.token==204){return 3;}
        if(self.token==60 || self.token==62 || self.token==201 || self.token==202){return 4;}
        if(self.token==43 || self.token==45){return 5;}if(self.token==42 || self.token==47){return 6;}return 0;
    }
    private fn expression(borrow mut self,minimum:int,depth:int):int{
        let left:int=self.primary(depth+1);let compared:int=0;
        while(self.code==0 && self.precedence()>=minimum){
            val priority:int=self.precedence();if(priority==0){break;}
            if((priority==3 || priority==4) && (compared&(1<<priority))!=0){self.fail(102,self.begin,self.end);return left;}
            compared|=1<<priority;val token:int=self.token;self.next();val right:int=self.expression(priority+1,depth+1);
            let op:int=21;if(token==45){op=22;}if(token==42){op=23;}if(token==47){op=24;}
            if(token==60){op=25;}if(token==201){op=26;}if(token==62){op=27;}if(token==202){op=28;}
            if(token==203){op=29;}if(token==204){op=30;}if(token==205){op=31;}if(token==206){op=32;}
            left=self.make(op,left,right,0,0,0,self.nodes[left*16+6],self.begin);
        }return left;
    }
    private fn define(borrow mut self,index:int,start:int,end:int):void{
        if(self.code!=0){return;}if(self.definition_count==256){self.fail(401,start,end);return;}
        if(end-start>128 || self.reserved(start,end)){self.fail(206,start,end);return;}
        for(let i:int=0;i<self.definition_count;i++){val previous:int=self.definitions[i]*16;
            if(self.nodes[previous+8]==self.current_flow && self.same(start,end,self.nodes[previous+9],self.nodes[previous+10])){self.fail(206,start,end);return;}}
        self.nodes[index*16+9]=start;self.nodes[index*16+10]=end;self.definitions[self.definition_count]=index;self.definition_count++;
    }
    private fn reserved(borrow self,start:int,end:int):bool{
        return self.eq(start,end,utf8("flow")) || self.eq(start,end,utf8("input")) || self.eq(start,end,utf8("let")) ||
            self.eq(start,end,utf8("bind")) || self.eq(start,end,utf8("to")) || self.eq(start,end,utf8("true")) || self.eq(start,end,utf8("false")) ||
            self.eq(start,end,utf8("choose")) || self.eq(start,end,utf8("min")) || self.eq(start,end,utf8("max")) || self.eq(start,end,utf8("clamp")) ||
            self.eq(start,end,utf8("abs")) || self.eq(start,end,utf8("block")) || self.eq(start,end,utf8("row")) || self.eq(start,end,utf8("column")) || self.eq(start,end,utf8("state"));
    }
    private fn input_declaration(borrow mut self):void{
        self.next();val start:int=self.begin;val end:int=self.end;self.expect(1);self.expect(58);
        let type:int=0;
        if(self.word(utf8("bool"))){type=1;}if(self.word(utf8("number"))){type=2;}if(self.word(utf8("length"))){type=3;}
        if(self.word(utf8("time"))){type=4;}if(self.word(utf8("frequency"))){type=5;}
        if(self.word(utf8("colorScheme"))){type=10;}if(self.word(utf8("contrast"))){type=11;}
        if(type==0){self.fail(201,self.begin,self.end);return;}self.next();self.expect(61);
        let source:int=0;let value:int=0;let key_start:int=0;let key_end:int=0;let scope:int=0;
        if(self.word(utf8("state"))){
            source=12;self.next();self.expect(40);key_start=self.begin+1;key_end=self.end-1;
            if(self.token!=3 || key_end<=key_start || key_end-key_start>128){self.fail(204,self.begin,self.end);return;}
            for(let i:int=key_start;i<key_end;i++){val ch:int=int(self.source[i]);
                if((i==key_start && (ch<97 || ch>122)) || (i!=key_start && !(ch>=97 && ch<=122) && !digit(ch) && ch!=95 && ch!=46 && ch!=45)){
                    self.fail(204,key_start,key_end);return;}}
            self.next();self.expect(44);let negative:bool=false;if(self.token==45){negative=true;self.next();}
            if(type==1 && !negative && (self.word(utf8("true")) || self.word(utf8("false")))){if(self.word(utf8("true"))){value=1;}self.next();}
            else if(type==2 && self.token==2 && self.literal_type==2){value=self.literal;if(negative){value= -value;}
                if(!in_range(value)){self.fail(401,self.begin,self.end);return;}
                if(value%65536!=0){self.fail(201,self.begin,self.end);return;}self.next();}
            else{self.fail(201,self.begin,self.end);return;}
            if(self.token==44){self.next();self.expect_word(utf8("scope"));self.expect(58);self.expect_word(utf8("node"));scope=1;}
            self.expect(41);
        }else{
            val a:int=self.begin;val b:int=self.end;self.expect(1);self.expect(46);val c:int=self.begin;val d:int=self.end;self.expect(1);
            if(self.eq(a,b,utf8("parent")) && self.eq(c,d,utf8("availableWidth"))){source=1;}
            if(self.eq(a,b,utf8("self"))){
                if(self.eq(c,d,utf8("focused"))){source=2;}if(self.eq(c,d,utf8("hovered"))){source=3;}if(self.eq(c,d,utf8("pressed"))){source=4;}
                if(self.eq(c,d,utf8("disabled"))){source=5;}if(self.eq(c,d,utf8("checked"))){source=6;}if(self.eq(c,d,utf8("invalid"))){source=7;}}
            if(self.eq(a,b,utf8("env"))){
                if(self.eq(c,d,utf8("reducedMotion"))){source=8;}if(self.eq(c,d,utf8("colorScheme"))){source=9;}
                if(self.eq(c,d,utf8("contrast"))){source=10;}if(self.eq(c,d,utf8("textScale"))){source=11;}}
            let expected:int=1;if(source==1){expected=3;}if(source==9){expected=10;}if(source==10){expected=11;}if(source==11){expected=2;}
            if(source==0){self.fail(204,a,d);return;}if(type!=expected){self.fail(201,a,d);return;}
        }
