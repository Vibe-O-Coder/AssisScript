    private fn binding(borrow mut self):void{
        self.next();val kind:int=self.token;if(kind!=35 && kind!=46){self.fail(102,self.begin,self.end);return;}
        val start:int=self.cursor;
        if(self.cursor==self.length || !letter(int(self.source[self.cursor]))){self.fail(102,start,start);return;}
        self.cursor++;while(self.cursor<self.length && (name_char(int(self.source[self.cursor])) || self.source[self.cursor]==45)){self.cursor++;}
        val end:int=self.cursor;self.next();self.expect_word(utf8("to"));val a:int=self.begin;val b:int=self.end;self.expect(1);self.expect(59);
        if(self.binding_count==128){self.fail(401,start,end);return;}val p:int=self.binding_count*6;
        self.bindings[p]=kind;self.bindings[p+1]=start;self.bindings[p+2]=end;self.bindings[p+3]=a;self.bindings[p+4]=b;self.bindings[p+5]= -1;self.binding_count++;
    }
    private fn local(borrow self,flow:int,start:int,end:int):int{
        for(let i:int=0;i<self.definition_count;i++){val index:int=self.definitions[i];val p:int=index*16;
            if(self.nodes[p+8]==flow && self.same(start,end,self.nodes[p+9],self.nodes[p+10])){return index;}}return -1;
    }
    private fn infer(borrow mut self,index:int,depth:int):int{
        if(self.code!=0){return 0;}val p:int=index*16;
        self.work++;if(depth>64 || self.work>1000000){self.fail(401,self.nodes[p+6],self.nodes[p+7]);return 0;}
        if(self.marks[index]==2){return self.nodes[p+5];}if(self.marks[index]==1){self.fail(301,self.nodes[p+6],self.nodes[p+7]);return 0;}
        self.marks[index]=1;val op:int=self.nodes[p];let a:int=self.nodes[p+1];let type:int=self.nodes[p+5];let left:int=0;let right:int=0;
        if(op==2){
            a=self.local(self.nodes[p+8],self.nodes[p+9],self.nodes[p+10]);
            if(a<0){if(self.nodes[p+2]==0){self.fail(205,self.nodes[p+6],self.nodes[p+7]);return 0;}
                self.nodes[p]=1;self.nodes[p+4]=self.nodes[p+3];type=self.nodes[p+2];}
            else{self.nodes[p+1]=a;type=self.infer(a,depth+1);}
        }else if(op==4){type=self.infer(a,depth+1);}
        else if(op!=1 && op!=3){
            left=self.infer(a,depth+1);if(op>=21 && op<=43){right=self.infer(self.nodes[p+2],depth+1);}
            if(op==11 || op==44){if(left<2 || left>5){self.fail(201,self.nodes[p+6],self.nodes[p+7]);}type=left;}
            else if(op==12){if(left!=1){self.fail(201,self.nodes[p+6],self.nodes[p+7]);}type=1;}
            else if(op==21 || op==22 || op==41 || op==42 || op==43){
                if(left!=right || left<2 || left>5){self.fail(201,self.nodes[p+6],self.nodes[p+7]);}
                if(op==43 && self.infer(self.nodes[p+3],depth+1)!=left){self.fail(201,self.nodes[p+6],self.nodes[p+7]);}type=left;
            }else if(op==23){
                if(left==2 && (right==2 || right==3)){type=right;}
                else if(left==3 && right==2){type=3;}
                else if((left==4 && right==5) || (left==5 && right==4)){type=2;}
                else{self.fail(201,self.nodes[p+6],self.nodes[p+7]);}
            }else if(op==24){
                if(left==3 && right==2){type=3;}else if((left==2 && right==2) || (left==3 && right==3) || (left==4 && right==4)){type=2;}
                else{self.fail(201,self.nodes[p+6],self.nodes[p+7]);}
            }else if(op>=25 && op<=30){
                if(left!=right || (op<=28 && (left<2 || left>5))){self.fail(201,self.nodes[p+6],self.nodes[p+7]);}type=1;
            }else if(op==31 || op==32){if(left!=1 || right!=1){self.fail(201,self.nodes[p+6],self.nodes[p+7]);}type=1;}
            else if(op==40){val other:int=self.infer(self.nodes[p+3],depth+1);
                if(left!=1){self.fail(201,self.nodes[p+6],self.nodes[p+7]);}
                if(right!=other){self.fail(203,self.nodes[p+6],self.nodes[p+7]);}type=right;
            }else if(op>=45 && op<=47){if(left!=3){self.fail(201,self.nodes[p+6],self.nodes[p+7]);}type=9;}
        }
        self.nodes[p+5]=type;self.marks[index]=2;return type;
