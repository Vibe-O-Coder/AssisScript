            if(c==47 && self.cursor+1<self.length && self.source[self.cursor+1]==47){
                self.cursor+=2;while(self.cursor<self.length && self.source[self.cursor]!=10 && self.source[self.cursor]!=13){self.cursor++;}continue;
            }
            if(c==47 && self.cursor+1<self.length && self.source[self.cursor+1]==42){
                val start:int=self.cursor;self.cursor+=2;let depth:int=1;
                while(self.cursor<self.length && depth>0){
                    if(self.cursor+1<self.length && self.source[self.cursor]==47 && self.source[self.cursor+1]==42){depth++;self.cursor+=2;
                        if(depth>32){self.fail(401,start,self.cursor);return;}}
                    else if(self.cursor+1<self.length && self.source[self.cursor]==42 && self.source[self.cursor+1]==47){depth--;self.cursor+=2;}
                    else{self.cursor++;}
                }if(depth!=0){self.fail(102,start,self.cursor);return;}continue;
            }break;
        }
        self.begin=self.cursor;self.end=self.cursor;if(self.cursor==self.length){return;}
        val c:int=int(self.source[self.cursor]);self.cursor++;
        if(letter(c)){self.token=1;while(self.cursor<self.length && name_char(int(self.source[self.cursor]))){self.cursor++;}}
        else if(digit(c)){
            self.token=2;while(self.cursor<self.length && digit(int(self.source[self.cursor]))){self.cursor++;}
            if(self.cursor<self.length && self.source[self.cursor]==46){self.cursor++;
                val digits:int=self.cursor;while(self.cursor<self.length && digit(int(self.source[self.cursor]))){self.cursor++;}
                if(digits==self.cursor){self.fail(101,self.begin,self.cursor);return;}}
            val number_end:int=self.cursor;let multiplier:int=1;let divisor:int=1;self.literal_type=2;
            if(self.cursor<self.length && self.source[self.cursor]==37){divisor=100;self.cursor++;}
            else{val start:int=self.cursor;while(self.cursor<self.length && letter(int(self.source[self.cursor]))){self.cursor++;}
                if(self.cursor<self.length && digit(int(self.source[self.cursor]))){self.fail(101,self.begin,self.cursor+1);return;}
                if(start!=self.cursor){
                    if(self.eq(start,self.cursor,utf8("px"))){self.literal_type=3;}
                    else if(self.eq(start,self.cursor,utf8("ms"))){self.literal_type=4;divisor=1000;}
                    else if(self.eq(start,self.cursor,utf8("s"))){self.literal_type=4;}
                    else if(self.eq(start,self.cursor,utf8("Hz"))){self.literal_type=5;}
                    else{self.fail(201,start,self.cursor);return;}}}
            if(self.cursor<self.length && name_char(int(self.source[self.cursor]))){self.fail(101,self.begin,self.cursor+1);return;}
            val number:Number=decimal(slice_of(self.source,self.begin,number_end-self.begin),false,multiplier,divisor);
            if(number.code!=0){self.fail(number.code,self.begin,self.cursor);return;}self.literal=number.value;
        }else if(c==34){
