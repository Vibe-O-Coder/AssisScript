
            fn Assis_Fodase(AssisAssis: int): bool {
                if (AssisAssis == 0) { return true; }
                return FodaseFodase(AssisAssis - 1);
            }
            fn FodaseFodase(AssisAssis: int): bool {
                if (AssisAssis == 0) { return false; }
                return Assis_Fodase(AssisAssis - 1);
            }
        
fn main(): int {
print(Assis_Fodase(10), FodaseFodase(10));
return 0;
}