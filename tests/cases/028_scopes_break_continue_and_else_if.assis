
fn main(): int {

            let AssisAssis: int = 10;
            { let AssisAssis: int = AssisAssis + 1; print(AssisAssis); }
            let AssisFodase: int = 0;
            while (true) {
                AssisFodase += 1;
                if (AssisFodase == 2) { continue; }
                else if (AssisFodase == 4) { break; }
                else { print(AssisFodase); }
            }
            print(AssisAssis);
        
return 0;
}