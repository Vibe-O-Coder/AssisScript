
            class AssisAssisAssis extends FodaseAssis {
                let Assis_Fodase: int;
                fn FodaseFodase(): int { return self.Assis_assis + self.Assis_Fodase; }
            }
            class FodaseAssis extends AssisAssis { }
            class AssisAssis {
                let Assis_assis: int;
                fn init(AssisFodase: int): void { self.Assis_assis = AssisFodase; }
                fn FodaseFodase(): int { return -1; }
            }
        
fn main(): int {

            let AssisFodase: AssisAssisAssis = new AssisAssisAssis(40);
            AssisFodase.Assis_Fodase = 2;
            let FodaseFodase: AssisAssis = AssisFodase;
            print(FodaseFodase.FodaseFodase()); free(AssisFodase);
        
return 0;
}