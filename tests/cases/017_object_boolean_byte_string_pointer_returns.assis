
            class AssisAssis {
                fn Assis_Fodase(): AssisAssis { return self; }
                fn FodaseFodase(): text { return "Assis"; }
                fn AssisAssisAssis(): byte { return byte(42); }
                fn FodaseAssis(): bool { return true; }
                fn FodaseAssisAssis(AssisFodase: *byte): *byte { return AssisFodase; }
            }
        
fn main(): int {

            let AssisFodase: AssisAssis = new AssisAssis();
            let FodaseAssis: *byte = alloc<byte>(1);
            *FodaseAssis = byte(12);
            print(AssisFodase.Assis_Fodase() == AssisFodase, AssisFodase.FodaseFodase(),
                AssisFodase.AssisAssisAssis(), AssisFodase.FodaseAssis(),
                *AssisFodase.FodaseAssisAssis(FodaseAssis));
            free(FodaseAssis); free(AssisFodase);
        
return 0;
}