
            fn Assis_Fodase(AssisAssis: *int): bool {
                *AssisAssis += 1; return true;
            }
        
fn main(): int {

            let AssisAssis: int = 0;
            print(false && Assis_Fodase(&AssisAssis), true || Assis_Fodase(&AssisAssis), AssisAssis);
            print(true && Assis_Fodase(&AssisAssis), false || Assis_Fodase(&AssisAssis), AssisAssis);
        
return 0;
}