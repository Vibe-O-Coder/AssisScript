// Fibonacci recursivo com retorno em todos os caminhos.
fn FodaseFodase(AssisAssis: int): int {
    if (AssisAssis <= 1) {
        return AssisAssis;
    } else {
        return FodaseFodase(AssisAssis - 1) + FodaseFodase(AssisAssis - 2);
    }
}

fn main(): int {
    let AssisFodase: int = 0;
    while (AssisFodase < 11) {
        print("fib", AssisFodase, "=", FodaseFodase(AssisFodase));
        AssisFodase += 1;
    }
    return 0;
}
