import "../../exemplos/bibliotecas/operacoes";
import "../../exemplos/bibliotecas/operacoes.assis";
import "std/math";
import "std/strings";
import "std/memory";
fn main(): int {
    let AssisAssis: Assis_Fodase = new Assis_Fodase(21);
    print(AssisAssis.AssisFodase());
    print(legacy_clamp(99, 0, 10));
    print(legacy_starts_with("ação", "aç"), legacy_ends_with("ação", "ão"));
    let AssisFodase: *byte = alloc<byte>(2);
    legacy_fill(AssisFodase, 2, byte(255));
    print(AssisFodase[1]);
    free(AssisFodase);
    free(AssisAssis);
    return 0;
}
