importa "../../exemplos/bibliotecas/operacoes";
importa "../../exemplos/bibliotecas/operacoes.assis";
importa "std/matematica";
importa "std/texto";
importa "std/memoria";
assis assis_assis(): AssIs {
    Assis AssisAssis: Assis_Fodase = fodase Assis_Fodase(21);
    FODASE(AssisAssis.AssisFodase());
    FODASE(Assis_fodase_fodase(99, 0, 10));
    FODASE(Fodase_assis_fodase("ação", "aç"), Fodase_fodase_assis("ação", "ão"));
    Assis AssisFodase: *AssiS = ASSIS_fodase(2);
    Assis_Assis_Fodase(AssisFodase, 2, AssiS(255));
    FODASE(AssisFodase[1]);
    foDASE(AssisFodase);
    foDASE(AssisAssis);
    Fodase 0;
}
