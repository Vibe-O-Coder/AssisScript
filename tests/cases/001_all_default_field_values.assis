
            class AssisAssis {
                let Assis_assis: int; let Assis_fodase: byte;
                let Fodase_assis: bool; let Fodase_fodase: text;
                let Assis_Fodase: *byte; let Fodase_Assis: AssisAssis;
            }
        
fn main(): int {

            let AssisFodase: AssisAssis = new AssisAssis();
            print(AssisFodase.Assis_assis, AssisFodase.Assis_fodase,
                AssisFodase.Fodase_assis, AssisFodase.Fodase_fodase == "",
                AssisFodase.Assis_Fodase == null, AssisFodase.Fodase_Assis == null);
            free(AssisFodase);
        
return 0;
}