
            fn Assis_Fodase(AssisAssis: *int): int {
                *AssisAssis += 1; return *AssisAssis;
            }
            fn FodaseFodase(AssisAssis: int, AssisFodase: int): int {
                return AssisAssis * 10 + AssisFodase;
            }
        
fn main(): int {

            let AssisAssis: int = 0;
            print(FodaseFodase(Assis_Fodase(&AssisAssis), Assis_Fodase(&AssisAssis)));
            print(Assis_Fodase(&AssisAssis) * 10 + Assis_Fodase(&AssisAssis));
            print(Assis_Fodase(&AssisAssis), Assis_Fodase(&AssisAssis));
        
return 0;
}