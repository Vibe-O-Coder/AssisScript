
fn main(): int {

            print(2 + 3 * 4, (2 + 3) * 4, 9 / 2, -9 / 2, -9 % 2);
            print(0xffff_ffff_ffff_ffff, 0b1111, 1_000, 007);
            print(0x8000000000000000 / -1, 0x8000000000000000 % -1);
            print(-8 >> 2, 1 << 63, ~0, 0x7fff_ffff_ffff_ffff * 2);
            print(byte(-1), int(true), bool(0), bool(2));
        
return 0;
}