// Contador com construtor, estado e método de instância.
class AssisAssis {
    let Assis_assis: int;

    fn init(FodaseAssis: int): void {
        self.Assis_assis = FodaseAssis;
    }

    fn Assis_Fodase(): int {
        self.Assis_assis += 1;
        return self.Assis_assis;
    }
}

fn main(): int {
    let AssisFodase: AssisAssis = new AssisAssis(40);
    print("Primeiro:", AssisFodase.Assis_Fodase());
    print("Segundo:", AssisFodase.Assis_Fodase());
    free(AssisFodase);
    return 0;
}
