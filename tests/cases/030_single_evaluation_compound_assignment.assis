
            fn Assis_Fodase(AssisAssis: *int): int {
                *AssisAssis += 1; return 0;
            }
            fn FodaseFodase(AssisAssis: *byte): int {
                *AssisAssis = byte(100); return 2;
            }
        
fn main(): int {

            let AssisAssis: *byte = alloc<byte>(1);
            let FodaseAssis: int = 0;
            AssisAssis[0] = byte(5);
            AssisAssis[Assis_Fodase(&FodaseAssis)] += FodaseFodase(AssisAssis);
            print(AssisAssis[0], FodaseAssis); free(AssisAssis);
        
return 0;
}