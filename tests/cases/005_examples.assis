// Uma referência da base chama a implementação da classe real.
class AssisAssis {
    let Assis_assis: int;

    fn init(AssisFodase: int): void {
        self.Assis_assis = AssisFodase;
    }

    fn FodaseFodase(): int {
        return self.Assis_assis;
    }
}

class AssisAssisAssis extends AssisAssis {
    fn FodaseFodase(): int {
        return self.Assis_assis * 3;
    }
}

fn Assis_Fodase(AssisFodase: AssisAssis): int {
    return AssisFodase.FodaseFodase();
}

fn main(): int {
    let FodaseAssis: AssisAssis = new AssisAssis(14);
    // Conversão implícita da derivada para a base; construtor herdado.
    let FodaseAssisAssis: AssisAssis = new AssisAssisAssis(14);
    print("Base:", Assis_Fodase(FodaseAssis));
    print("Derivada via base:", Assis_Fodase(FodaseAssisAssis));
    free(FodaseAssis);
    free(FodaseAssisAssis);
    return 0;
}
