
            class AssisAssis {
                let Assis_assis: *byte;
                let Fodase_assis: text;
                let Assis_Fodase: AssisAssis;
            }
        
fn main(): int {

            let AssisFodase: AssisAssis = new AssisAssis();
            AssisFodase.Assis_assis = alloc<byte>(2);
            let FodaseAssis: **byte = &AssisFodase.Assis_assis;
            (*FodaseAssis)[0] = byte(42);
            let FodaseFodase: *text = &AssisFodase.Fodase_assis;
            *FodaseFodase = "strings";
            let FodaseAssisAssis: *AssisAssis = &AssisFodase.Assis_Fodase;
            *FodaseAssisAssis = AssisFodase;
            print(AssisFodase.Assis_assis[0], *FodaseFodase, AssisFodase.Assis_Fodase == AssisFodase);
            free(*FodaseAssis); free(AssisFodase);
        
return 0;
}