// Arena de treino: dois objetos, ataque virtual, vida e memória manual.
class AssisAssis {
    let Assis_assis: int;
    let Fodase_assis: int;

    fn init(AssisFodase: int, FodaseAssis: int): void {
        self.Assis_assis = AssisFodase;
        self.Fodase_assis = FodaseAssis;
    }

    fn FodaseFodase(): int {
        return self.Fodase_assis;
    }

    fn Assis_Fodase(AssisFodase: AssisAssis): void {
        let FodaseAssis: int = self.FodaseFodase();
        AssisFodase.Assis_assis -= FodaseAssis;
        print("Dano:", FodaseAssis, "| Vida remaining:", AssisFodase.Assis_assis);
    }
}

class AssisAssisAssis extends AssisAssis {
    fn FodaseFodase(): int {
        return self.Fodase_assis * 2;
    }
}

fn main(): int {
    let AssisFodase: AssisAssis = new AssisAssis(100, 12);
    let FodaseAssis: AssisAssis = new AssisAssisAssis(100, 12);
    print("ASSIS ARENA: ataque comum contra ataque especializado.");
    let AssisFodaseAssis: int = 1;
    while (AssisFodase.Assis_assis > 0 && FodaseAssis.Assis_assis > 0) {
        print("Turno", AssisFodaseAssis);
        AssisFodase.Assis_Fodase(FodaseAssis);
        if (FodaseAssis.Assis_assis <= 0) { break; }
        FodaseAssis.Assis_Fodase(AssisFodase);
        AssisFodaseAssis += 1;
    }
    if (AssisFodase.Assis_assis <= 0) {
        print("A classe derivada venceu. Fodase.");
    } else {
        print("A classe base venceu. Assis.");
    }
    free(AssisFodase);
    free(FodaseAssis);
    return 0;
}
