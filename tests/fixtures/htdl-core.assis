// Readiness probe, not an HTDL implementation or specification.
// Test format: nested <div>...</div>, UTF-8 text, no attributes or escapes.
// Nodes use parent indices; the index stores exact words in hash chains.
import "std/unicode.assis";

const MAX_BYTES:int=1048576;
const MAX_NODES:int=20000;
const MAX_DEPTH:int=4096;
value struct Node{let parent:int;let begin:int;let end:int;}
value struct Term{let begin:int;let end:int;let count:int;let next:int;}

safe fn same(borrow input:slice<byte>,offset:int,borrow token:slice<byte>):bool{
    if(offset<0 || offset>len(input) || len(token)>len(input)-offset){return false;}
    for(let i:int=0;i<len(token);++i){if(input[offset+i]!=token[i]){return false;}}
    return true;
}

// Recoverable parse error codes: 1 limit, 2 UTF-8, 3 syntax, 4 nesting.
// Partial output after an error must be discarded by the caller.
safe fn parse(borrow input:slice<byte>,borrow mut nodes:Array<Node>):int{
    if(len(input)>MAX_BYTES){return 1;}
    if(unicode::error(input)>=0){return 2;}
    own stack:Array<int>=[];
    let i:int=0;
    while(i<len(input)){
        if(input[i]!='<'){++i;continue;}
        if(same(input,i,"<div>")){
            if(len(nodes)>=MAX_NODES || len(stack)>=MAX_DEPTH){return 1;}
            let parent:int=-1;if(len(stack)>0){parent=stack[len(stack)-1];}
            val id:int=len(nodes);nodes.push(new Node(parent,i,-1));stack.push(id);i+=5;
        }else if(same(input,i,"</div>")){
            if(len(stack)==0){return 4;}
            val id:int=stack.pop();val n:Node=nodes[id];nodes[id]=new Node(n.parent,n.begin,i+6);i+=6;
        }else{return 3;}
    }
    if(len(stack)>0){return 4;}
    return 0;
}

safe fn word(c:byte):bool{return (c>='a' && c<='z') || (c>='A' && c<='Z') || c>=byte(128);}
safe fn lower(c:byte):byte{if(c>='A' && c<='Z'){return byte(int(c)+32);}return c;}
safe fn hash(borrow input:slice<byte>,begin:int,end:int):u64{
    let h:u64=u64(14695981039346656037);
    for(let i:int=begin;i<end;i++){h=(h^u64(lower(input[i])))*u64(1099511628211);}
    return h;
}
safe fn equal_word(borrow input:slice<byte>,begin:int,end:int,borrow query:slice<byte>):bool{
    if(end-begin!=len(query)){return false;}
    for(let i:int=0;i<len(query);i++){if(lower(input[begin+i])!=lower(query[i])){return false;}}
    return true;
}

// Mask deliberately injectable to test collisions; equality checks bytes.
safe fn index_words(borrow input:slice<byte>,borrow mut terms:Array<Term>,borrow mut heads:HashMap<u64,int>,mask:u64):void{
    let i:int=0;
    while(i<len(input)){
        if(input[i]=='<'){while(i<len(input) && input[i]!='>'){i++;}if(i<len(input)){i++;}continue;}
        if(!word(input[i])){i++;continue;}
        val begin:int=i;while(i<len(input) && word(input[i])){i++;}
        val key:u64=hash(input,begin,i)&mask;
        let term:int=heads.get_or(key,-1);let found:bool=false;
        while(term>=0){
            val t:Term=terms[term];
            if(equal_word(input,t.begin,t.end,slice_of(input,begin,i-begin))){
                terms[term]=new Term(t.begin,t.end,t.count+1,t.next);found=true;break;
            }
            term=t.next;
        }
        if(!found){val previous:int=heads.get_or(key,-1);val id:int=len(terms);terms.push(new Term(begin,i,1,previous));heads.set(key,id);}
    }
}
safe fn count_word(borrow input:slice<byte>,borrow terms:Array<Term>,borrow heads:HashMap<u64,int>,borrow query:slice<byte>,mask:u64):int{
    let term:int=heads.get_or(hash(query,0,len(query))&mask,-1);
    while(term>=0){val t:Term=terms[term];if(equal_word(input,t.begin,t.end,query)){return t.count;}term=t.next;}
    return 0;
}

safe fn main():int{
    own input:*byte=alloc<byte>(MAX_BYTES);
    own chunk:*byte=alloc<byte>(4096);
    let count:int=0;
    while(true){
        val n:int=read_bytes(chunk,4096);
        if(n<0){print("ERR read");return 2;}
        if(n==0){break;}
        if(n>MAX_BYTES-count){print("ERR",1);return 1;}
        for(let i:int=0;i<n;i++){input[count+i]=chunk[i];}count+=n;
    }
    borrow document:slice<byte>=slice_of(input,0,count);
    own nodes:Array<Node>=[];
    val error:int=parse(document,nodes);if(error!=0){print("ERR",error);return 1;}
    own terms:Array<Term>=[];own heads:HashMap<u64,int>=new HashMap<u64,int>();
    // All words deliberately collide, proving exact matching, not just hash matches.
    index_words(document,terms,heads,u64(0));
    print(len(nodes),len(terms),count_word(document,terms,heads,"assis",u64(0)),count_word(document,terms,heads,"HTDL",u64(0)));
    if(len(nodes)>0){val first:Node=nodes[0];val last:Node=nodes[len(nodes)-1];print(first.parent,last.parent,last.end>last.begin);}
    return 0;
}
