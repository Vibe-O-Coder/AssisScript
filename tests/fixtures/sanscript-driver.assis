import "std/sanscript.assis";
safe fn main():int{
    own source:*byte=try_alloc<byte>(65537);own chunk:*byte=try_alloc<byte>(4096);if(source==null || chunk==null){return 2;}let size:int=0;
    while(true){val n:int=read_bytes(chunk,4096);if(n<0){return 2;}if(n==0){break;}if(n>65536-size){print(403,0,0,1,1,1,1);return 0;}
        for(let i:int=0;i<n;i++){source[size+i]=chunk[i];}size+=n;}
    own program:sanscript::Program=try_new sanscript::Program(slice_of(source,0,size),1000000);if(program==null){return 2;}
    val d:htdl::Diagnostic=program.diagnostic();print(d.code,d.start,d.end,d.line,d.column,d.end_line,d.end_column);if(!program.is_open()){return 0;}
    own store:documents::Store=try_new documents::Store(1000000,1000,100);own style:fluxstyle::Style=try_new fluxstyle::Style();own data:*int=try_alloc<int>(15);
    if(store==null || style==null || data==null || !style.is_ready()){return 2;}
    assert(htdl::load_catalog(store,1,utf8("<div type=document version=\"0.1\" lang=en><div type=head><div type=title>SSC</div></div><div type=body><div type=container id=card class=\"card featured\"></div></div></div>")).code==0);
    val node:doctree::NodeId=htdl::find_id(store.active_document().nodes(),utf8("card"));
    assert(style.commit(node,1,24576,slice_of(data,0,15)));
    own motion:sanscript::Motion=program.attach(store.active_document(),node,style);if(motion==null){return 2;}
    print(motion.status());if(!motion.is_open()){return 0;}
    data[13]= -8*65536;data[14]= -8*65536;assert(style.commit(node,2,24576,slice_of(data,0,15)));assert(motion.update(store.active_document(),style)==0);
    for(let i:int=0;i<360;i++){let delta:int=8;if(i%3==0){delta=9;}
        val code:int=motion.advance(store.active_document(),delta,true,true,false,false);
        print(motion.at(2).code,motion.at(2).value,motion.speed(2).value,motion.asleep(),code);}
    return 0;
}
